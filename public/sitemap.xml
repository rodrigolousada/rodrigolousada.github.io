    <xhtml:link rel="alternate" hreflang="en" href="https://rodrigolousada.me/" />
    <xhtml:link rel="alternate" hreflang="pt" href="https://rodrigolousada.me/pt/" />
  </url>
  <url>
    <loc>https://rodrigolousada.me/pt/</loc>
    <xhtml:link rel="alternate" hreflang="en" href="https://rodrigolousada.me/" />
