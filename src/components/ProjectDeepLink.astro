---
// Two things, both project-level, both site-wide:
//
// 1. Every project (work or side) renders a small share-icon corner button
//    (ProjectRow.astro / GameCartridge.astro, `[data-share-key]`) — clicking
//    it copies (or hands to the OS share sheet) a link to that project's own
//    `/p/<key>/` preview page (src/pages/p/[key].astro and
//    src/pages/[locale]/p/[key].astro) rather than straight back to this
//    homepage — that page exists purely so a link-preview crawler (which
//    reads a page's static <head> and never runs JS) sees this specific
//    project's own title/description/thumbnail instead of the sitewide
//    homepage card. See ShareRedirect.astro for the full rationale.
// 2. On load, a URL carrying `?p=<key>` finds the matching project and opens
//    it with the exact same scroll-and-reveal sequence as clicking through
//    from the "Associated with" logos (see careerJump.ts) — this is what a
//    project's `/p/<key>/` page immediately redirects a real visitor to,
//    and it's kept working standalone too, for any link out there from
//    before that page existed.
//
// One component so all three halves of the round trip — the link a share
// button produces, the static page that link lands on, and what opening the
// `?p=` it redirects to actually does — stay obviously in sync.
---

<script>
  import { openStop, openSideProject } from '../scripts/careerJump';
  import { locales, defaultLocale } from '../data/site';

  // Same "first path segment, if it's a real non-default locale" rule
  // src/data/languages.ts's `localePath` encodes the other way around
  // (locale -> path). Falls back to the default locale for "/" itself, same
  // as everywhere else on the site that resolves a locale from the URL.
  function currentLocalePrefix(): string {
    const segment = window.location.pathname.split('/').filter(Boolean)[0];
    const isLocale = segment && (locales as readonly string[]).includes(segment);
    return isLocale && segment !== defaultLocale ? `/${segment}` : '';
  }

  function buildShareUrl(key: string): string {
    return `${window.location.origin}${currentLocalePrefix()}/p/${encodeURIComponent(key)}/`;
  }

  document.addEventListener('click', (e) => {
    const button = (e.target as HTMLElement).closest<HTMLElement>('[data-share-key]');
    if (!button) return;
    e.preventDefault();
    e.stopPropagation();
    const key = button.dataset.shareKey;
    if (!key) return;

    const showCopiedFeedback = () => {
      const defaultIcon = button.querySelector('.share-icon-default');
      const checkIcon = button.querySelector('.share-icon-check');
      defaultIcon?.classList.add('hidden');
      checkIcon?.classList.remove('hidden');
      setTimeout(() => {
        defaultIcon?.classList.remove('hidden');
        checkIcon?.classList.add('hidden');
      }, 1500);
    };

    const url = buildShareUrl(key);
    const shareData = { title: document.title, url };

    (async () => {
      if (navigator.share) {
        try {
          await navigator.share(shareData);
          return;
        } catch {
          // Cancelled, or unsupported in this context — fall through to
          // the clipboard copy below.
        }
      }
      try {
        await navigator.clipboard.writeText(url);
        showCopiedFeedback();
      } catch {
        /* clipboard unavailable — nothing more we can do without a UI to paste into */
      }
    })();
  });

  // Deep-link resolution: `[data-deep-link-target]` is set on both a career
  // project's row button (ProjectRow.astro) and a side project's cartridge
  // button (GameCartridge.astro) to its own share key, so a single lookup
  // finds either. Whether it's a career project is then just "does it sit
  // inside a career stop" — side projects never do.
  const params = new URLSearchParams(window.location.search);
  const targetKey = params.get('p');
  if (targetKey) {
    const targetEl = document.querySelector<HTMLElement>(
      `[data-deep-link-target="${CSS.escape(targetKey)}"]`
    );
    if (targetEl) {
      const stopEl = targetEl.closest<HTMLElement>('[data-stop-anchor]');
      if (stopEl) {
        openStop(stopEl, targetEl);
      } else {
        openSideProject(targetEl);
      }
    }
  }
</script>
