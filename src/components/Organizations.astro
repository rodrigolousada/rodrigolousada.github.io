---
import { getSite, type Locale } from '../data/site';
import { getUI } from '../data/ui';

interface Props {
  locale: Locale;
}

interface Organization {
  name: string;
  logo: string;
  logoScale?: number;
  alreadyWhite?: boolean;
  category: string;
  program?: string;
  /** Optional grade/result shown in the "Studied at" balloon alongside the program, e.g. "17/20". */
  grade?: string;
  scrollTo?: string;
  scrollToCompany?: string;
}
const { locale } = Astro.props;
const organizations = getSite(locale).organizations as unknown as Organization[];
const ui = getUI(locale);

// Known category keys get a hand-picked label and a fixed order. A category
// value in site.json that isn't listed here still gets its own group
// (title-cased from the raw key, appended after the known ones) instead of
// being silently dropped — so a new category only needs adding to the data.
const groups = [
  { key: 'worked', label: ui.organizations.worked },
  { key: 'client', label: ui.organizations.client },
  { key: 'studied', label: ui.organizations.studied },
];
const knownKeys = new Set(groups.map((g) => g.key));
const extraKeys = [...new Set(organizations.map((org) => org.category).filter((c) => !knownKeys.has(c)))];
const allGroups = [
  ...groups,
  ...extraKeys.map((key) => ({ key, label: key.charAt(0).toUpperCase() + key.slice(1) })),
];

// Handed to the cross-link script below via a `data-jump-ui` attribute on
// the section (see the JSON.stringify below) — that script builds its
// popup text at click time from plain strings, not JSX, and (being a
// normally-bundled, non-inline script with real TS syntax in it) can't use
// `define:vars` to read `ui` directly, since that would force it inline and
// break its type annotations at runtime.
const jumpUi = {
  checkProjectsWith: ui.organizations.checkProjectsWith,
  checkWorkAt: ui.organizations.checkWorkAt,
  jumpToProject: ui.organizations.jumpToProject,
  jumpHere: ui.organizations.jumpHere,
  cancel: ui.organizations.cancel,
  thisPartOfTimeline: ui.organizations.thisPartOfTimeline,
  projectFallback: ui.organizations.projectFallback,
};
---

<section class="mx-auto max-w-3xl px-6 py-14" data-jump-ui={JSON.stringify(jumpUi)}>
  <p class="mb-10 text-center font-mono text-xs tracking-widest text-[var(--color-muted)]">
    {ui.organizations.heading}
  </p>

  <div class="flex flex-col gap-8">
    {
      allGroups.map((group) => {
        const orgs = organizations.filter((org) => org.category === group.key);
        if (orgs.length === 0) return null;
        return (
          <div>
            <p class="mb-4 text-center font-mono text-[10px] uppercase tracking-widest text-[var(--color-muted)]">
              {group.label}
            </p>
            <!-- Tighter horizontal gap below sm: once the logos themselves
                 shrank for mobile, the old gap-x-10 (unchanged) left them
                 looking scattered rather than grouped. -->
            <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-6 sm:gap-x-10">
              {orgs.map((org, i) => {
                // `logoScale` bumps up a logo that renders visually smaller than
                // its neighbors at the same height (e.g. a mark with lots of
                // padding baked into the file). It used to be a CSS `transform:
                // scale()` on the image, which grows the pixels without growing
                // the box the flex row reserves for it — a heavily scaled logo
                // (Klarna at 2.2x) then visually overlapped into the gap toward
                // its neighbor, reading as "less spacing" than everywhere else.
                // Baking the scale into the actual height keeps the real layout
                // box in sync with what's drawn, so every gap stays even.
                //
                // Mobile base size below is 2/3 of what it used to be (1rem vs
                // the prior 1.5rem) — this whole row is a low-priority "as seen
                // in" credibility strip, not worth a big chunk of a phone
                // screen. Unchanged at sm+.
                const logoImg = (
                  <img
                    src={org.logo}
                    alt={org.name}
                    title={org.program ? undefined : org.name}
                    class={`h-[calc(1rem*var(--logo-scale))] w-auto object-contain opacity-40 grayscale transition group-hover:opacity-90 sm:h-[calc(1.75rem*var(--logo-scale))] ${org.alreadyWhite ? '' : 'invert'}`}
                    style={`--logo-scale: ${org.logoScale ?? 1};`}
                  />
                );

                if (!org.program) {
                  if (org.scrollTo || org.scrollToCompany) {
                    return (
                      <button
                        type="button"
                        class="group cursor-pointer"
                        data-scroll-target={org.scrollTo}
                        data-scroll-company={org.scrollToCompany}
                        data-scroll-label={org.name}
                        aria-label={ui.organizations.jumpToTimeline.replace('{name}', org.name)}
                      >
                        {logoImg}
                      </button>
                    );
                  }
                  return <span class="group">{logoImg}</span>;
                }

                const popupId = `study-popup-${group.key}-${i}`;
                return (
                  <div class="relative inline-block">
                    <button
                      type="button"
                      class="study-marker group relative cursor-pointer"
                      aria-expanded="false"
                      aria-label={ui.organizations.showDetailsFor.replace('{name}', org.name)}
                      data-study-toggle={popupId}
                    >
                      {logoImg}
                    </button>

                    <div
                      id={popupId}
                      role="dialog"
                      class="study-popup pointer-events-auto absolute bottom-full left-1/2 z-50 mb-3 hidden w-56 -translate-x-1/2 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] p-3 text-left shadow-xl"
                    >
                      <button
                        type="button"
                        aria-label={ui.common.close}
                        class="absolute right-2 top-2 cursor-pointer text-[var(--color-muted)] transition hover:text-[var(--color-text)]"
                        data-study-close={popupId}
                      >
                        ✕
                      </button>
                      <p class="pr-4 text-xs font-semibold text-[var(--color-accent)]">{org.name}</p>
                      <p class="mt-1 text-xs leading-relaxed text-[var(--color-text)]">{org.program}</p>
                      {org.grade && (
                        <p class="mt-2">
                          <span class="inline-block rounded-full border border-[var(--color-border)] bg-[var(--color-bg)] px-2 py-0.5 font-mono text-[10px] uppercase tracking-wide text-[var(--color-muted)]">
                            {ui.organizations.grade.replace('{grade}', org.grade)}
                          </span>
                        </p>
                      )}
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        );
      })
    }
  </div>
</section>

<script>
  import { openStop } from '../scripts/careerJump';

  // Translated copy for the jump-confirm popup below, read back off the
  // section's own `data-jump-ui` attribute (see the frontmatter's `jumpUi`)
  // rather than a hardcoded English object — this script has no access to
  // Astro's per-locale `ui` data directly, only whatever's serialized into
  // the DOM.
  interface JumpUi {
    checkProjectsWith: string;
    checkWorkAt: string;
    jumpToProject: string;
    jumpHere: string;
    cancel: string;
    thisPartOfTimeline: string;
    projectFallback: string;
  }
  const jumpUi: JumpUi = JSON.parse(
    document.querySelector('[data-jump-ui]')?.getAttribute('data-jump-ui') ?? '{}'
  );

  const toggles = document.querySelectorAll<HTMLButtonElement>('[data-study-toggle]');
  const closeButtons = document.querySelectorAll<HTMLButtonElement>('[data-study-close]');
  // Whichever trigger opened the currently-visible popup, so Escape/close
  // can hand focus back to it — otherwise a keyboard user's focus would be
  // left on a now-hidden close button with nothing announcing where it went.
  let lastTrigger: HTMLButtonElement | null = null;

  function closeAll(restoreFocus = false) {
    document.querySelectorAll<HTMLElement>('.study-popup').forEach((popup) => {
      popup.classList.add('hidden');
    });
    toggles.forEach((btn) => btn.setAttribute('aria-expanded', 'false'));
    if (restoreFocus) lastTrigger?.focus();
    lastTrigger = null;
  }

  toggles.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const id = btn.dataset.studyToggle;
      if (!id) return;
      const popup = document.getElementById(id);
      const wasOpen = popup ? !popup.classList.contains('hidden') : false;
      closeAll();
      if (popup && !wasOpen) {
        popup.classList.remove('hidden');
        btn.setAttribute('aria-expanded', 'true');
        lastTrigger = btn;
        // Move focus into the popup itself (its close button, always
        // present) so a keyboard/screen-reader user actually lands on the
        // content that just appeared, instead of it opening silently
        // somewhere off in the page while focus stays on the marker.
        popup.querySelector<HTMLButtonElement>('[data-study-close]')?.focus();
      }
    });
  });

  closeButtons.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      closeAll(true);
    });
  });

  document.addEventListener('click', () => closeAll());
  // These are plain divs, not native <dialog>, so Escape does nothing for
  // them unless wired up explicitly — every other overlay on the site gets
  // this for free from the browser.
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAll(true);
  });

  // Cross-links: "Worked at" / "Clients" logos here and the testimonial in
  // Testimonials.astro jump into the matching Projects timeline entry (and,
  // where a specific project is known, drill straight into its own modal).
  // The jump only happens after the user confirms in the small popover
  // below — a bare click used to feel like an accidental scroll+open. Once
  // confirmed, the page scrolls there at a normal pace, then pauses for a
  // beat (so the destination is clearly in view) before the modal pops up.
  // `openStop` itself lives in careerJump.ts, shared with the `?p=`
  // deep-link resolver (ProjectDeepLink.astro) so a shared project link
  // opens with the exact same sequence as clicking through from here.

  let jumpPopup: HTMLElement | null = null;
  function closeJumpPopup() {
    jumpPopup?.remove();
    jumpPopup = null;
  }

  function showJumpPopup(triggerEl: HTMLElement, stopEl: HTMLElement, projectEls: HTMLElement[]) {
    closeJumpPopup();
    // If the trigger lives inside an open <dialog> (e.g. the testimonial
    // letter), the popup must be its child to share the dialog's top-layer
    // stacking — a plain body-appended element would render behind it.
    const hostDialog = triggerEl.closest('dialog');
    const label = triggerEl.dataset.scrollLabel ?? jumpUi.thisPartOfTimeline;

    const popup = document.createElement('div');
    popup.className = 'jump-confirm-popup';

    const text = document.createElement('p');
    text.className = 'mb-2 text-xs text-[var(--color-text)]';
    text.textContent =
      projectEls.length > 0
        ? jumpUi.checkProjectsWith.replace('{label}', label)
        : jumpUi.checkWorkAt.replace('{label}', label);
    popup.appendChild(text);

    const actions = document.createElement('div');
    actions.className = 'flex flex-wrap gap-1.5';

    function addJumpButton(label: string, target: HTMLElement | null) {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className =
        'rounded-md bg-[var(--color-accent)] px-2.5 py-1 text-xs font-medium text-[var(--color-bg)] transition hover:brightness-110';
      btn.textContent = label;
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        closeJumpPopup();
        if (hostDialog instanceof HTMLDialogElement && hostDialog.open) hostDialog.close();
        openStop(stopEl, target);
      });
      actions.appendChild(btn);
    }

    if (projectEls.length > 0) {
      projectEls.forEach((p) =>
        addJumpButton(jumpUi.jumpToProject.replace('{name}', p.dataset.projectName ?? jumpUi.projectFallback), p)
      );
    } else {
      addJumpButton(jumpUi.jumpHere, null);
    }

    const cancel = document.createElement('button');
    cancel.type = 'button';
    cancel.className = 'rounded-md border border-[var(--color-border)] px-2.5 py-1 text-xs text-[var(--color-muted)] transition hover:text-[var(--color-text)]';
    cancel.textContent = jumpUi.cancel;
    cancel.addEventListener('click', (e) => {
      e.stopPropagation();
      closeJumpPopup();
    });
    actions.appendChild(cancel);

    popup.appendChild(actions);
    (hostDialog ?? document.body).appendChild(popup);

    const rect = triggerEl.getBoundingClientRect();
    const popupRect = popup.getBoundingClientRect();
    let left = rect.left + rect.width / 2 - popupRect.width / 2;
    left = Math.max(8, Math.min(left, window.innerWidth - popupRect.width - 8));
    let top = rect.top - popupRect.height - 10;
    if (top < 8) top = rect.bottom + 10;
    popup.style.left = `${left}px`;
    popup.style.top = `${top}px`;

    jumpPopup = popup;
    setTimeout(() => document.addEventListener('click', closeJumpPopup, { once: true }), 0);
  }

  document.querySelectorAll<HTMLElement>('[data-scroll-target]').forEach((el) => {
    el.addEventListener('click', (e) => {
      e.stopPropagation();
      const company = el.dataset.scrollCompany;
      const projectEls = company
        ? [...document.querySelectorAll<HTMLElement>(`[data-project-companies~="${company}"]`)]
        : [];
      const stopEl = projectEls[0]
        ? projectEls[0].closest<HTMLElement>('[data-stop-anchor]')
        : document.querySelector<HTMLElement>(`[data-stop-anchor="${el.dataset.scrollTarget}"]`);
      if (!stopEl) return;
      showJumpPopup(el, stopEl, projectEls);
    });
  });
</script>
