---
import Layout from '../layouts/Layout.astro';
import Nav from './Nav.astro';
import Hero from './Hero.astro';
import Technologies from './Technologies.astro';
import Projects from './Projects.astro';
import Speaking from './Speaking.astro';
import Testimonials from './Testimonials.astro';
import Contact from './Contact.astro';
import Organizations from './Organizations.astro';
import Footer from './Footer.astro';
import type { Locale } from '../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<!-- `nav.links` in site.json (rendered directly by Nav.astro) must list its
     entries in this same top-to-bottom order: clicking a nav link jumps
     straight to the matching id, so a mismatch between the two makes the
     jump feel like it lands somewhere "wrong" relative to what the visitor
     expects to scroll past next. This section order is the source of
     truth; nav.links is kept in sync with it by hand, since Hero and
     Organizations don't have nav entries of their own (Hero is above
     everything, Organizations is a closing "as seen in" strip) so the two
     lists can't just be generated from one another. -->
<Layout locale={locale}>
  <Nav locale={locale} />
  <main>
    <Hero locale={locale} />
    <Technologies locale={locale} />
    <Projects locale={locale} />
    <Speaking locale={locale} />
    <Contact locale={locale} />
    <Testimonials locale={locale} />
    <Organizations locale={locale} />
  </main>
  <Footer locale={locale} />
</Layout>
