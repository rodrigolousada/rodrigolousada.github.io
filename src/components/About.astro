---
import site from '../data/site.json';
import TechStack from './TechStack.astro';
import { icons } from '../data/icons';
const { about } = site;

// Recomputed on every build, not hardcoded — see about.softwareSince.
const years = Math.floor(
  (Date.now() - new Date(about.softwareSince).getTime()) / (365.25 * 24 * 60 * 60 * 1000)
);
const areasText =
  about.areas.length > 1
    ? `${about.areas.slice(0, -1).join(', ')} and ${about.areas[about.areas.length - 1]}`
    : about.areas[0];
---

<section id="about" class="mx-auto max-w-3xl px-6 py-10">
  <div class="mb-4 flex items-center gap-3">
    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[var(--color-accent)]/10 text-[var(--color-accent)]">
      <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current">
        <path d={icons.user} />
      </svg>
    </span>
    <h2 class="font-mono text-sm tracking-widest text-[var(--color-accent)]">ABOUT</h2>
  </div>

  <div class="grid grid-cols-1 gap-3 lg:grid-cols-2">
    <div class="p-4">
      <p class="text-justify text-sm text-[var(--color-text)]">
        <span class="font-semibold">{years} years</span> of Software Development spanning a
        multitude of areas in {areasText}. Currently at {about.currentRole}.
      </p>

      <div class="mb-3 mt-3 flex items-start gap-3 rounded-lg border-l-2 border-[var(--color-accent)] bg-[var(--color-bg)] px-4 py-3">
        <svg viewBox="0 0 24 24" class="mt-0.5 h-4 w-4 shrink-0 fill-[var(--color-accent)]">
          <path d={icons.search} />
        </svg>
        <p class="text-justify text-sm text-[var(--color-text)]">
          <span class="font-semibold">Looking for:</span> {about.lookingFor}
        </p>
      </div>

      <p class="mb-2 font-mono text-[10px] uppercase tracking-widest text-[var(--color-muted)]">
        My Clifton Strengths
      </p>
      <div class="flex flex-wrap items-center gap-2">
        {
          about.strengths.map((s) => (
            <span class="rounded-full border border-[var(--color-border)] px-3 py-1 text-xs text-[var(--color-muted)]">
              {s}
            </span>
          ))
        }
      </div>
    </div>

    <div class="p-4">
      <TechStack />
    </div>
  </div>
</section>
