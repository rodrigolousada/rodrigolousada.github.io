---
import site from '../data/site.json';
const { about } = site;
---

<section id="about" class="mx-auto max-w-3xl px-6 py-14">
  <h2 class="mb-8 font-mono text-sm tracking-widest text-[var(--color-accent)]">
    ABOUT
  </h2>

  <div class="mb-8 rounded-lg border-l-2 border-[var(--color-accent)] bg-[var(--color-surface)] px-5 py-4">
    <p class="text-[var(--color-text)]">
      <span class="font-semibold">Looking for:</span> {about.lookingFor}
    </p>
  </div>

  <p class="mb-8 max-w-xl text-[var(--color-muted)]">{about.intro}</p>

  <div class="flex flex-wrap items-center gap-2">
    {
      about.strengths.map((s) => (
        <span class="rounded-full border border-[var(--color-border)] px-3 py-1 text-xs text-[var(--color-muted)]">
          {s}
        </span>
      ))
    }
    <a
      href={site.site.cliftonStrengthsPath}
      class="text-xs text-[var(--color-accent)] underline underline-offset-4"
    >
      Full assessment →
    </a>
  </div>
</section>
