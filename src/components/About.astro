---
import site from '../data/site.json';
import TechStack from './TechStack.astro';
const { about } = site;
---

<section id="about" class="mx-auto max-w-3xl px-6 py-12">
  <h2 class="mb-6 font-mono text-sm tracking-widest text-[var(--color-accent)]">
    ABOUT
  </h2>

  <div class="grid grid-cols-1 gap-5 lg:grid-cols-2">
    <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6">
      <div class="mb-6 rounded-lg border-l-2 border-[var(--color-accent)] bg-[var(--color-bg)] px-5 py-4">
        <p class="text-[var(--color-text)]">
          <span class="font-semibold">Looking for:</span> {about.lookingFor}
        </p>
      </div>

      <p class="mb-6 text-[var(--color-muted)]">{about.intro}</p>

      <div class="flex flex-wrap items-center gap-2">
        {
          about.strengths.map((s) => (
            <span class="rounded-full border border-[var(--color-border)] px-3 py-1 text-xs text-[var(--color-muted)]">
              {s}
            </span>
          ))
        }
        <a
          href={site.site.cliftonStrengthsPath}
          class="text-xs text-[var(--color-accent)] underline underline-offset-4"
        >
          Full assessment →
        </a>
      </div>
    </div>

    <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6">
      <TechStack />
    </div>
  </div>
</section>
