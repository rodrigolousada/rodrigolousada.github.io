  <div class="mx-auto flex min-h-[78vh] max-w-3xl flex-col justify-center px-6 py-24">
    <div class="mb-8 flex items-center gap-4">
      <img
        src="/img/profile.jpg"
        alt={hero.name}
        class="h-16 w-16 rounded-full object-cover ring-2 ring-[var(--color-accent)]/40"
      />
      <div>
        <p class="font-mono text-sm tracking-wide text-[var(--color-accent)]">{hero.name}</p>
        <p class="text-sm text-[var(--color-muted)]">{hero.roleLine}</p>
      </div>
    </div>

    <h1 class="text-4xl font-extrabold leading-[1.1] tracking-tight text-[var(--color-text)] sm:text-5xl md:text-6xl">
      {hero.headline}
    </h1>

    <p class="mt-6 max-w-xl text-lg leading-relaxed text-[var(--color-muted)]">
      {hero.subline}
    </p>

    <div class="mt-10 flex flex-wrap items-center gap-4">
      <a
        href="#projects"
        class="rounded-md bg-[var(--color-accent)] px-5 py-3 text-sm font-semibold text-[#04141c] shadow-[0_0_30px_-5px_var(--color-accent)] transition hover:brightness-110"
      >
        View projects
      </a>
      <a
        href="#contact"
        class="rounded-md border border-[var(--color-border)] px-5 py-3 text-sm font-semibold text-[var(--color-text)] transition hover:border-[var(--color-accent)]"
      >
        Get in touch
      </a>
      <a
        href={site.site.cvPath}
        class="text-sm font-medium text-[var(--color-muted)] underline decoration-[var(--color-border)] underline-offset-4 transition hover:text-[var(--color-text)]"
      >
        Download CV
      </a>
    </div>

    <dl class="mt-16 grid grid-cols-1 gap-6 border-t border-[var(--color-border)] pt-10 sm:grid-cols-3">
      {
        hero.stats.map((stat) => (
          <div>
            <dt class="text-3xl font-bold text-[var(--color-text)]">{stat.value}</dt>
            <dd class="mt-1 text-sm text-[var(--color-muted)]">{stat.label}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .city-glow {
    animation: city-pulse 2.6s ease-in-out infinite;
  }
  @keyframes city-pulse {
    0%,
    100% {
      opacity: 0.18;
      transform: scale(1);
    }
    50% {
      opacity: 0.5;
      transform: scale(1.8);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .city-glow {
      animation: none;
    }
  }
</style>

<script>
  const toggles = document.querySelectorAll<HTMLButtonElement>('[data-city-toggle]');
  const closeButtons = document.querySelectorAll<HTMLButtonElement>('[data-city-close]');

  function closeAll() {
    document.querySelectorAll<HTMLElement>('.city-popup').forEach((popup) => {
      popup.classList.add('hidden');
    });
    toggles.forEach((btn) => btn.setAttribute('aria-expanded', 'false'));
  }

  toggles.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const id = btn.dataset.cityToggle;
      if (!id) return;
      const popup = document.getElementById(id);
      const wasOpen = popup ? !popup.classList.contains('hidden') : false;
      closeAll();
      if (popup && !wasOpen) {
        popup.classList.remove('hidden');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });

  closeButtons.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      closeAll();
    });
  });

  document.addEventListener('click', () => closeAll());
</script>
