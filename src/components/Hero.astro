---
import site from '../data/site.json';
const { hero } = site;

// Pixel coordinates within the map SVG's viewBox — not content, so kept here
// rather than in site.json (which only holds the per-city bio text).
const MAP_VIEWBOX = { w: 506.0, h: 442.9 };
const CITY_POINTS: Record<string, { x: number; y: number }> = {
  Lisbon: { x: 122.3, y: 393.5 },
  Berlin: { x: 296.2, y: 227.9 },
};

const cities = hero.cities.map((city, i) => {
  const point = CITY_POINTS[city.name];
  const topPct = (point.y / MAP_VIEWBOX.h) * 100;
  return {
    ...city,
    id: `city-${i}`,
    delay: i * 0.8,
    leftPct: (point.x / MAP_VIEWBOX.w) * 100,
    topPct,
    // Open the popup toward whichever side of the marker has more room.
    popupClass: topPct > 50 ? 'bottom-full mb-3' : 'top-full mt-3',
  };
});
