      {
        cities.map((city) => (
          <div
            class="absolute -translate-x-1/2 -translate-y-1/2"
            style={`left:${city.leftPct}%; top:${city.topPct}%;`}
          >
            <button
              type="button"
              class="city-marker group/city pointer-events-auto relative flex h-5 w-5 cursor-pointer items-center justify-center rounded-full"
              aria-expanded="false"
              aria-label={`Show info for ${city.name}`}
              data-city-toggle={city.id}
            >
              <span
                class="city-glow pointer-events-none absolute inset-0 rounded-full bg-[var(--color-accent)] opacity-20 transition group-hover/city:opacity-40"
                style={`animation-delay:${city.delay}s`}
              />
              <span class="pointer-events-none relative h-1.5 w-1.5 rounded-full bg-[var(--color-accent)] transition group-hover/city:scale-125" />
            </button>

            <div
              id={city.id}
              role="dialog"
              class={`city-popup pointer-events-auto absolute left-1/2 z-50 hidden w-56 -translate-x-1/2 rotate-[8deg] rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] p-3 text-left shadow-xl ${city.popupClass}`}
            >
              <button
                type="button"
                aria-label="Close"
                class="absolute right-2 top-2 cursor-pointer text-[var(--color-muted)] transition hover:text-[var(--color-text)]"
                data-city-close={city.id}
              >
                ✕
              </button>
              <p class="pr-4 text-xs font-semibold text-[var(--color-accent)]">{city.name}</p>
              <p class="mt-1 text-xs leading-relaxed text-[var(--color-text)]">{city.text}</p>
            </div>
          </div>
        ))
