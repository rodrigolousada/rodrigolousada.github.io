---
import { getUI } from '../data/ui';
import type { Locale } from '../data/site';

// One person's testimonial: the card shown in the "What people say" list,
// plus (if a scanned letter exists) the dialog it opens on click. Split out
// from Testimonials.astro so the section can list any number of people the
// same way Projects.astro lists CareerStopRow/GameCartridge: one component
// per repeated item, not one hand-copied block per person.
interface Testimonial {
  text: string;
  name: string;
  role: string;
  initials?: string;
  photo?: string;
  /** Career-stop anchor this testimonial cross-links to (see Organizations.astro's scroll-to script). */
  scrollTo?: string;
  /** Scanned recommendation letter, signature blurred. Unset just shows the quote with no "Read the full letter" link/dialog. */
  letterImage?: string;
  company?: string;
}
interface Props {
  testimonial: Testimonial;
  modalId: string;
  locale: Locale;
}
const { testimonial, modalId, locale } = Astro.props;
const ui = getUI(locale);
---

<button
  type="button"
  onclick={testimonial.letterImage ? `document.getElementById('${modalId}').showModal()` : undefined}
  class="group flex w-full items-start gap-4 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6 text-left transition hover:border-[var(--color-accent)]"
>
  {testimonial.photo ? (
    <img
      src={testimonial.photo}
      alt={testimonial.name}
      class="h-11 w-11 shrink-0 rounded-full object-cover"
    />
  ) : (
    <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-[var(--color-border)] font-mono text-xs font-semibold text-[var(--color-text)]">
      {testimonial.initials}
    </div>
  )}
  <div class="min-w-0 flex-1">
    <p class="text-[var(--color-text)]">{testimonial.text}</p>
    <footer class="mt-4 flex flex-wrap items-center justify-between gap-x-4 gap-y-1 text-sm">
      <p>
        <span class="font-medium text-[var(--color-text)]">{testimonial.name}</span>
        <span class="text-[var(--color-muted)]"> · {testimonial.role}</span>
      </p>
      {testimonial.letterImage && (
        <span class="shrink-0 font-mono text-xs text-[var(--color-muted)] transition group-hover:text-[var(--color-accent)]">
          {ui.testimonialCard.readFullLetter}
        </span>
      )}
    </footer>
  </div>
</button>

<!-- A bottom sheet on mobile, a compact centered card at sm: and up — see
     CareerStopRow's dialog for the full bottom-sheet rationale (the
     mx-3/w-[calc(...)] side-margin trick, the [data-sheet-handle] grab bar
     floating on top of the header itself with no separate wrapper needed
     here, and the quick-swipe-anywhere dismiss wired up in Layout.astro).
     The inner scroll div's max-h tracks the dialog's own (94svh mobile /
     90vh at sm:) minus the ~4rem header, same relationship as before. svh,
     not dvh — see CareerStopRow's dialog for why. -->
{testimonial.letterImage && (
  <dialog
    id={modalId}
    class="mx-3 mb-0 mt-auto max-h-[94svh] w-[calc(100%-1.5rem)] max-w-none rounded-t-2xl border-0 border-t border-[var(--color-border)] bg-[var(--color-surface)] p-0 text-[var(--color-text)] backdrop:bg-black/60 backdrop:backdrop-blur-sm sm:m-auto sm:max-h-[90vh] sm:w-[min(92vw,34rem)] sm:rounded-xl sm:border"
  >
    <div class="relative flex items-center justify-between border-b border-[var(--color-border)] px-6 pt-6 pb-4 sm:pt-4">
      <div data-sheet-handle class="sheet-handle absolute left-1/2 top-2 z-10 h-1.5 w-10 -translate-x-1/2 rounded-full bg-white/40 sm:hidden" aria-hidden="true"></div>
      <p class="font-mono text-xs uppercase tracking-widest text-[var(--color-accent)]">{ui.testimonialCard.recommendationLetter}</p>
      <form method="dialog">
        <button
          aria-label={ui.common.close}
          class="flex h-7 w-7 items-center justify-center rounded-full bg-[var(--color-border)] text-[var(--color-text)] transition hover:brightness-125"
        >
          ✕
        </button>
      </form>
    </div>
    <div class="max-h-[calc(94svh-4rem)] overflow-y-auto p-6 sm:max-h-[calc(90vh-4rem)]">
      <button
        type="button"
        data-lightbox-src={testimonial.letterImage}
        data-lightbox-alt={`Recommendation letter from ${testimonial.name}`}
        class="block w-full cursor-zoom-in"
      >
        <img
          src={testimonial.letterImage}
          alt={`Recommendation letter from ${testimonial.name}`}
          class="w-full rounded-lg border border-[var(--color-border)]"
          loading="lazy"
        />
      </button>
      <p class="mt-3 text-xs text-[var(--color-muted)]">
        {ui.testimonialCard.signatureBlurred}
      </p>
      {testimonial.scrollTo && (
        <button
          type="button"
          data-scroll-target={testimonial.scrollTo}
          data-scroll-label={testimonial.company}
          class="mt-4 text-xs text-[var(--color-accent)] underline underline-offset-4"
        >
          {ui.testimonialCard.writtenDuringMyTimeAt.replace('{company}', testimonial.company ?? '')}
        </button>
      )}
    </div>
  </dialog>
)}
