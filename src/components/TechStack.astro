---
// Compact, grouped technology badges — embedded inside About.astro rather
// than a standalone section (see Backlog2.md feedback: smaller, grouped by
// category, tucked into a quarter of the About section).
import site from '../data/site.json';
import { techIcons } from '../data/techIcons';

const { technologies } = site;
const iconMap = new Map(techIcons.map((t) => [t.name, t]));

const categoryOrder = ['Languages & Frameworks', 'Data & Search', 'AI & Data Science', 'Infra & Tools'];
const groups = categoryOrder
  .map((category) => ({
    category,
    items: technologies.items.filter((item) => item.category === category),
  }))
  .filter((g) => g.items.length > 0);
---

<div>
  <p class="mb-3 font-mono text-[10px] uppercase tracking-widest text-[var(--color-muted)]">
    Technologies
  </p>
  <div class="space-y-2.5">
    {
      groups.map((group) => (
        <div>
          <p class="mb-1.5 text-[9px] uppercase tracking-wide text-[var(--color-muted)]/60">{group.category}</p>
          <div class="flex flex-wrap gap-1.5">
            {group.items.map((item) => {
              const icon = iconMap.get(item.name);
              return (
                <span class="flex items-center gap-1.5 rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] py-0.5 pl-0.5 pr-2">
                  {icon && (
                    <span class="flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-white p-0.5">
                      <svg viewBox="0 0 24 24" class="h-full w-full" fill={icon.color}>
                        <path d={icon.path} />
                      </svg>
                    </span>
                  )}
                  <span class="whitespace-nowrap text-[11px] text-[var(--color-text)]">{item.name}</span>
                </span>
              );
            })}
          </div>
        </div>
      ))
    }
  </div>
</div>
