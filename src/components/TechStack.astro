---
// Compact, grouped technology badges — embedded inside About.astro rather
// than a standalone section (see Backlog2.md feedback: smaller, grouped by
// category, tucked into a quarter of the About section). A "View more"
// button opens a dialog with the wider skill set from the CV/LinkedIn.
import site from '../data/site.json';
import TechPill from './TechPill.astro';

const { technologies } = site;
const categoryOrder = ['Languages', 'Frameworks & Libraries', 'Data & Databases', 'AI & Data Science', 'Infra & Tools'];

function groupByCategory(list: { name: string; category: string }[]) {
  return categoryOrder
    .map((category) => ({
      category,
      items: list.filter((item) => item.category === category),
    }))
    .filter((g) => g.items.length > 0);
}

const allGroups = groupByCategory([...technologies.items, ...(technologies.extra ?? [])]);
const preferredStack = technologies.preferredStack ?? [];
const modalId = 'technologies-more';
---

<div>
  <p class="mb-3 font-mono text-[10px] uppercase tracking-widest text-[var(--color-muted)]">
    Technologies
  </p>
  <div class="flex flex-wrap gap-1.5">
    {technologies.items.map((item) => (
      <TechPill name={item.name} />
    ))}
  </div>

  {technologies.extra && technologies.extra.length > 0 && (
    <button
      type="button"
      onclick={`document.getElementById('${modalId}').showModal()`}
      class="mt-3 text-xs text-[var(--color-accent)] underline underline-offset-4"
    >
      View more →
    </button>
  )}
</div>

<dialog
  id={modalId}
  class="m-auto w-[min(92vw,42rem)] max-h-[85vh] rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-0 text-[var(--color-text)] backdrop:bg-black/60 backdrop:backdrop-blur-sm"
>
  <div class="flex items-center justify-between border-b border-[var(--color-border)] px-6 py-4">
    <p class="font-mono text-xs uppercase tracking-widest text-[var(--color-accent)]">All Technologies</p>
    <form method="dialog">
      <button
        aria-label="Close"
        class="flex h-7 w-7 items-center justify-center rounded-full bg-[var(--color-border)] text-[var(--color-text)] transition hover:brightness-125"
      >
        ✕
      </button>
    </form>
  </div>
  <div class="max-h-[calc(85vh-4rem)] overflow-y-auto p-6">
    <div class="space-y-4">
      {
        allGroups.map((group) => (
          <div>
            <p class="mb-1.5 text-[10px] uppercase tracking-wide text-[var(--color-muted)]/60">{group.category}</p>
            <div class="flex flex-wrap gap-1.5">
              {group.items.map((item) => (
                <TechPill name={item.name} />
              ))}
            </div>
          </div>
        ))
      }
    </div>

    {preferredStack.length > 0 && (
      <>
        <p class="mb-3 mt-6 font-mono text-[10px] uppercase tracking-widest text-[var(--color-muted)]">
          My preferred stack
        </p>
        <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] p-4">
          <div class="flex flex-wrap items-stretch justify-center gap-x-1.5 gap-y-3">
            {preferredStack.map((layer, i) => (
              <>
                <div class="flex min-w-[8.5rem] flex-1 flex-col gap-2 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] p-3 shadow-sm">
                  <div class="flex items-center gap-1.5">
                    <span class="flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-[var(--color-accent)] text-[9px] font-bold text-[var(--color-bg)]">
                      {i + 1}
                    </span>
                    <p class="text-[10px] font-semibold uppercase tracking-wide text-[var(--color-accent)]">{layer.label}</p>
                  </div>
                  <div class="flex flex-wrap gap-1.5">
                    {layer.items.map((name) => (
                      <TechPill name={name} />
                    ))}
                  </div>
                </div>
                {i < preferredStack.length - 1 && (
                  <div class="flex shrink-0 items-center justify-center text-lg leading-none text-[var(--color-accent)]/70">
                    →
                  </div>
                )}
              </>
            ))}
          </div>
        </div>
      </>
    )}
  </div>
</dialog>
