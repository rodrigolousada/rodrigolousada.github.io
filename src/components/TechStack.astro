---
// Compact, grouped technology badges rendered inside the standalone
// Technologies section (Technologies.astro). A "View more" button opens a
// dialog with the wider skill set from the CV/LinkedIn.
import { getSite, type Locale } from '../data/site';
import { getUI } from '../data/ui';
import TechPill from './TechPill.astro';
import StackConnector, { type BusConnector, type GroupedConnector } from './StackConnector.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { technologies } = getSite(locale);
const ui = getUI(locale);
// Preferred display order for the categories we know about today. A
// category value in site.json that isn't listed here still renders — just
// appended after these, in the order it's first seen — so adding a brand
// new category to the data alone is enough; nothing here needs editing to
// keep it from silently disappearing.
const categoryOrder = ['Languages', 'Frameworks & Libraries', 'Data & Databases', 'AI & Data Science', 'Infra & Tools'];

function groupByCategory(list: { name: string; category: string }[]) {
  const known = categoryOrder.map((category) => ({
    category,
    items: list.filter((item) => item.category === category),
  }));
  const knownSet = new Set(categoryOrder);
  const extraCategories = [...new Set(list.map((item) => item.category).filter((c) => !knownSet.has(c)))];
  const extra = extraCategories.map((category) => ({
    category,
    items: list.filter((item) => item.category === category),
  }));
  return [...known, ...extra].filter((g) => g.items.length > 0);
}

const allGroups = groupByCategory([...technologies.items, ...(technologies.extra ?? [])]);
const modalId = 'technologies-more';

// Compact "About" view only surfaces what's actually current, flagged per
// item via `recent` in site.json — checked across both `items` and `extra`
// so a technology doesn't need to live in `items` just to show up here.
// Everything else (recent or not) still shows up in the full "View more"
// breakdown above. Falls back to showing everything if nothing is flagged,
// so this never silently renders empty.
const allTechs = [...technologies.items, ...(technologies.extra ?? [])];
const recentItems = allTechs.filter((item) => item.recent);
const compactItems = recentItems.length > 0 ? recentItems : technologies.items;

// "My preferred stack" mini architecture diagram: consumers on top, feeding
// down into a stack of tiers (each tier holding one or more layers side by
// side), all wrapped in one "Infra" box since that runs underneath
// everything — plus a separate, deliberately disconnected "Experimentation"
// box off to the side for tools that never made it into the core stack.
// Connectors are plain SVG lines with an arrowhead, using percentage
// coordinates so no JS measurement or viewBox scaling is needed to stay
// responsive.
interface StackLayer {
  label: string;
  items?: string[];
  /** Alternative sub-options shown together inside this one box, joined by
   * an "or" badge (e.g. Backend is either Python or Node.js) — used instead
   * of splitting them into separate layers so they read as "one decision,
   * two ways" rather than two things wired in at once. */
  options?: { label: string; items?: string[] }[];
}
interface StackTier {
  layers: StackLayer[];
  /**
   * For the row whose layers feed the NEXT row down: group source-layer
   * indices by which target layer (index into the next row) they connect
   * to, instead of the default "every column talks to every column" bus.
   * E.g. [[0,1],[2]] means layers 0 & 1 feed target 0, layer 2 feeds
   * target 1 — used where the mapping is specific and blurring it into one
   * shared bus would misrepresent it (Mobile/Web Users vs. Stakeholders;
   * Frontend feeds Backend while Reporting feeds the Data Pipeline instead).
   */
  connectorGroups?: number[][];
}
interface PreferredStack {
  consumers: StackTier;
  tiers: StackTier[];
  infra: StackLayer;
  experimentation?: StackLayer;
}

const preferredStack = (technologies.preferredStack as PreferredStack | undefined) ?? null;
const connectorHeight = 28;

function columnCenters(count: number) {
  return Array.from({ length: count }, (_, i) => ((i + 0.5) / count) * 100);
}

// Every row rendered top to bottom (consumers, then each inner tier), so
// connectors can be generated uniformly between every adjacent pair.
const allRows: StackTier[] = preferredStack ? [preferredStack.consumers, ...preferredStack.tiers] : [];

const connectors: (BusConnector | GroupedConnector)[] = allRows.slice(0, -1).map((row, i) => {
  const nextRow = allRows[i + 1];
  const topXs = columnCenters(row.layers.length);
  const bottomXs = columnCenters(nextRow.layers.length);

  if (row.connectorGroups) {
    const groups = row.connectorGroups.map((sources, targetIdx) => {
      const sourceXs = sources.map((idx) => topXs[idx]);
      const targetX = bottomXs[targetIdx];
      const allXs = [...sourceXs, targetX];
      return { sourceXs, targetX, busX1: Math.min(...allXs), busX2: Math.max(...allXs) };
    });
    return { mode: 'grouped', groups };
  }

  const allXs = [...topXs, ...bottomXs];
  return { mode: 'bus', topXs, bottomXs, busX1: Math.min(...allXs), busX2: Math.max(...allXs) };
});

// The diagram's own minimum width: wide enough that no row's layer boxes
// ever have to shrink below their own `min-w` floor (see the scrollbox's
// comment below for why that matters — a plain block's `width: auto` never
// grows to fit an overflowing child on its own, so this has to be worked
// out and handed to it explicitly instead). Each row's own required width
// is just its column count times that row's per-box floor, plus the gaps
// between them (`gap-2` = 0.5rem) — the consumer boxes and the tier layer
// boxes use different floors (`min-w-[6rem]` vs `min-w-[8.5rem]`, see their
// own markup below), so this takes a floor per row rather than assuming one
// for the whole diagram. `20` is the pre-existing floor for a stack with
// barely anything in it, kept as-is.
function rowMinRem(columns: number, floorRem: number, gapRem = 0.5) {
  return columns * floorRem + Math.max(0, columns - 1) * gapRem;
}
// Unlike the consumers row, every tier row sits one level deeper — inside
// the dashed "infra" box's own `border-2` + `p-3` — so its contribution
// needs that box's horizontal chrome added on top, or the outer diagram
// ends up sized just for the row's own content with nothing left over for
// the box wrapped around it (border-2 → 0.25rem, p-3 → 1.5rem: this is
// exactly what got missed the first time this was measured, and it doesn't
// resize itself if that box's own classes ever change).
const INFRA_BOX_CHROME_REM = 1.75;
const diagramMinWidthRem = preferredStack
  ? Math.max(
      20,
      rowMinRem(preferredStack.consumers.layers.length, 6),
      ...preferredStack.tiers.map((tier) => rowMinRem(tier.layers.length, 8.5) + INFRA_BOX_CHROME_REM),
    )
  : 20;
---

<div>
  <div class="flex flex-wrap gap-1.5">
    {compactItems.map((item) => (
      <TechPill name={item.name} locale={locale} />
    ))}
  </div>

  {(technologies.extra?.length > 0 || compactItems.length < technologies.items.length) && (
    <button
      type="button"
      onclick={`document.getElementById('${modalId}').showModal()`}
      class="mt-3 text-xs text-[var(--color-accent)] underline underline-offset-4"
    >
      {ui.technologies.viewMore}
    </button>
  )}
</div>

<!-- A bottom sheet on mobile, a compact centered card at sm: and up — see
     CareerStopRow's dialog for the full bottom-sheet rationale (mt-auto
     bottom-anchor + the mx-3/w-[calc(...)] side-margin trick +
     rounded-t-2xl + the [data-sheet-handle] drag-to-dismiss grab bar
     floating on top of the header rather than pushed above it as its own
     strip — this dialog has no separate rounded wrapper the way
     CareerStopRow's does, so the handle sits directly in the header itself,
     which is what `relative` on it below is for — plus the
     quick-swipe-anywhere dismiss wired up in Layout.astro, back to the
     original centered 94vw/54rem all-corners card at sm:). This list
     scrolls fine within that shape at either size, so it never needed
     full-screen real estate the way a longer/denser modal might.

     `open:grid`, not a bare `grid`: an unconditional `display` utility on
     <dialog> itself beats the browser's own `dialog { display: none }`
     once closed (Tailwind's class outranks that bare type-selector rule),
     so the dialog stayed rendered on screen after .close() — even with the
     `open` attribute gone. Scoping it to the `open:` variant only ever
     sets `display` while `[open]` is present, so the UA rule is free to
     hide it the rest of the time.

     Grid, not flex-col, for the two rows below (header+tabs, then the
     scrollable panel): iOS Safari was clipping the panel right at the
     bottom edge of the tabs — reproduced on a real iPhone, never in
     Chrome, desktop or device-emulated — because it doesn't reliably
     redo a `flex: 1 1 0%` child's height once a `height: fit-content`
     ancestor gets clamped by `max-height`: the child stays sized off the
     fit-content/max-content pass instead of the row it actually has once
     that clamp applies, so it renders at (near) zero height and the whole
     list disappears. CSS Grid's row-sizing algorithm resolves "shrink to
     content, but respect the outer clamp" consistently across browsers, so
     the header and tabs are wrapped in one plain div — a single `auto`
     row, `data-tech-header` below — and the scrollable panel is the other
     row, `minmax(0,1fr)`; the `0` floor is what lets that row shrink below
     its content's height instead of forcing the whole dialog to grow and
     show everything unscrolled.

     `h-fit`, not `h-auto`: see CareerStopRow's dialog for why. `height:
     auto` against a native modal dialog's pinned top/bottom edges stretches
     to the max-height cap instead of shrinking to content, and this list's
     visible content shrinks a lot once the search narrows it down to a
     couple of pills — `h-auto` left a big empty gap below a short result
     set there.

     That "shrink to content" is exactly what's been breaking, though, on
     mobile specifically — three rounds of "it's a little shorter than last
     time" reports from a real iPhone: switching this dialog's own tabs,
     typing in its search box, a pinch-zoom, all left it visibly shrunken by
     slightly different amounts each time. Two fixes chased plausible-looking
     *causes* (the address bar's `dvh` jitter, then a WebKit grid-sizing
     cache assumed stale and force-invalidated) and neither one stuck. What
     they share is trusting the browser's own fit-content-under-a-clamp
     computation to eventually get it right if just nudged correctly — this
     is the one dialog on the site whose content changes shape while it's
     open at all (every other sheet's `h-fit` only has to resolve once, at
     open, and never again), so it's the only one that ever asks a mobile
     WebKit to redo that computation more than once, and it just isn't
     reliable there for reasons three attempts at chasing it individually
     never nailed down.

     So this stops asking the browser to redo it at all. `sizeSheet()` below
     measures `data-tech-header`'s plain `offsetHeight` and the visible
     panel's plain `scrollHeight` inside `data-tech-scrollpanel` — ordinary,
     unambiguous DOM reads, not a live CSS computation with anything to cache
     or invalidate — adds them, clamps to the current viewport, and sets that
     as an explicit inline `height` in pixels. Run after every tab switch,
     every search keystroke, and on `visualViewport`'s resize event (which,
     unlike a plain `window` resize, also fires for pinch-zoom and the
     browser chrome animating, not just a real orientation change), so
     there's no gap where a stale number could show through — mobile always
     shows a number this run of the function just computed from scratch, on
     the spot, from what's actually on screen right now. `h-fit` above still
     governs the very first paint before that script runs and the sm:/desktop
     card the rest of the time, both cases this bug never actually hit. -->
<dialog
  id={modalId}
  class="open:grid mx-3 mb-0 mt-auto h-fit max-h-[94svh] w-[calc(100%-1.5rem)] max-w-none grid-rows-[auto_minmax(0,1fr)] rounded-t-2xl border-0 border-t border-[var(--color-border)] bg-[var(--color-surface)] p-0 text-[var(--color-text)] backdrop:bg-black/60 backdrop:backdrop-blur-sm sm:m-auto sm:max-h-[85vh] sm:w-[min(94vw,54rem)] sm:rounded-xl sm:border"
>
  <div data-tech-header>
    <div class="relative flex items-center justify-between border-b border-[var(--color-border)] px-6 pt-6 pb-4 sm:pt-4">
      <div data-sheet-handle class="sheet-handle absolute left-1/2 top-2 z-10 h-1.5 w-10 -translate-x-1/2 rounded-full bg-white/40 sm:hidden" aria-hidden="true"></div>
      <p class="font-mono text-xs uppercase tracking-widest text-[var(--color-accent)]">{ui.technologies.allTechnologies}</p>
      <form method="dialog">
        <button
          aria-label={ui.common.close}
          class="flex h-7 w-7 items-center justify-center rounded-full bg-[var(--color-border)] text-[var(--color-text)] transition hover:brightness-125"
        >
          ✕
        </button>
      </form>
    </div>

    {preferredStack && (
      // Two tabs rather than stacking the architecture diagram underneath
      // the search list in the same view: they're different tasks (skim my
      // preferred stack vs. hunt for one specific technology), and splitting
      // them keeps either view from feeling cluttered by the other. Plain
      // buttons + JS, not <details>/native tabs: this needs exactly one
      // panel visible at a time with a persistent header, which neither
      // gives you for free.
      <div class="flex gap-4 border-b border-[var(--color-border)] px-6">
        <button
          type="button"
          data-tech-tab="search"
          aria-selected="true"
          class="border-b-2 border-transparent py-2.5 font-mono text-xs uppercase tracking-widest text-[var(--color-muted)] transition hover:text-[var(--color-text)] aria-selected:border-[var(--color-accent)] aria-selected:text-[var(--color-accent)]"
        >
          {ui.technologies.search}
        </button>
        <button
          type="button"
          data-tech-tab="stack"
          aria-selected="false"
          class="border-b-2 border-transparent py-2.5 font-mono text-xs uppercase tracking-widest text-[var(--color-muted)] transition hover:text-[var(--color-text)] aria-selected:border-[var(--color-accent)] aria-selected:text-[var(--color-accent)]"
        >
          {ui.technologies.preferredStack}
        </button>
      </div>
    )}
  </div>

  <div data-tech-scrollpanel class="min-h-0 overflow-y-auto p-6">
    <div data-tech-panel="search">
      <div class="relative mb-4">
        <svg viewBox="0 0 24 24" class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 fill-[var(--color-muted)]">
          <path d="M15.5 14h-.79l-.28-.27a6.5 6.5 0 10-.7.7l.27.28v.79l5 5L20.5 19l-5-5zm-6 0a4.5 4.5 0 110-9 4.5 4.5 0 010 9z" />
        </svg>
        <input
          type="search"
          id="tech-search"
          placeholder={ui.technologies.searchPlaceholder}
          aria-label={ui.technologies.searchPlaceholder}
          class="w-full rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)] py-2 pl-9 pr-3 text-sm text-[var(--color-text)] outline-none transition placeholder:text-[var(--color-muted)] focus:border-[var(--color-accent)]"
        />
      </div>
      <div class="space-y-4">
        {
          allGroups.map((group) => (
            <div data-tech-category>
              <p class="mb-1.5 text-[10px] uppercase tracking-wide text-[var(--color-muted)]">{group.category}</p>
              <div class="flex flex-wrap gap-1.5">
                {group.items.map((item) => (
                  <TechPill name={item.name} locale={locale} />
                ))}
              </div>
            </div>
          ))
        }
      </div>
      <p id="tech-search-empty" class="mt-4 hidden text-center text-sm text-[var(--color-muted)]">
        {ui.technologies.noMatches}
      </p>
    </div>

    {preferredStack && (
      // No longer hidden below sm now that it's a dedicated tab instead of
      // squeezed in underneath the search results: the diagram's own
      // overflow-x-auto (with the width floor on each layer box) already
      // handles a narrow screen by scrolling sideways, same as it always
      // did on tablet widths.
      <div data-tech-panel="stack" class="hidden">
        <!-- Shown only while the diagram below is actually wider than its
             box (the tier with three layers side by side — Storage, AI/LLMs,
             Data Science — is the one that triggers it on a phone; the
             two-layer tiers usually fit without it), and only until the
             visitor scrolls it once — see this file's script for both. With
             no such cue, that tier's last box just looked cut off at the
             edge rather than one swipe away. -->
        <p data-stack-scroll-hint class="mb-2 hidden text-center font-mono text-[10px] uppercase tracking-widest text-[var(--color-muted)]">
          {ui.technologies.scrollForMore}
        </p>
        <div data-stack-scrollbox class="overflow-x-auto rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] p-4">
          <!-- `min-w-[20rem]` alone let this shrink below its own content on a
               phone: a plain block's `width: auto` only ever *fills* the space
               available (up to `max-w-2xl`) — it never grows past that to fit
               something wider, even though the layers below carry an explicit
               `min-w-[8.5rem]` floor apiece. So once a tier needed more than
               the available width (three layers side by side — Storage,
               AI/LLMs, Data Science — is the one that does it), those layers
               didn't push this box wider; they just overflowed past its own
               right edge, poking out past the dashed border below instead of
               widening it and scrolling as one piece the way the "swipe to
               see more" hint promises.

               The fix isn't a CSS one: tried `min-width: max(20rem,
               min-content)` first, on the theory that a flex item's
               min-content contribution is exactly its own explicit min-width
               summed across columns (which it is) — but `min-content` isn't
               a `<length-percentage>`, and `max()`/`min()`/`clamp()` only
               accept those, so Chrome parses the whole declaration as invalid
               and drops it silently (computed `min-width` came back `0px` in
               dev *and* in the built output — this was never going to show up
               from reading the generated CSS text, only from checking what
               the browser actually did with it). `diagramMinWidthRem` above
               computes the same number a different way: knowing each row's
               column count and its per-box floor is exactly the input a real
               CSS min-content calculation would need anyway, so it's worked
               out in plain JS at build time instead and handed down as an
               ordinary length — nothing for the browser to reject. It's a
               `style` attribute below rather than another `min-w-[...]`
               class for the same reason a template-literal class never
               works with Tailwind: the scanner reads this file as plain
               text, so a class built from `${diagramMinWidthRem}` would
               never actually get generated — the source never contains the
               resolved number, only the expression that produces it. -->
          <div class="mx-auto flex max-w-2xl flex-col" style={`min-width: ${diagramMinWidthRem}rem`}>
            <!-- Consumers: not tech, so plain dashed labels rather than tech-pill boxes. -->
            <div class="flex items-stretch gap-2">
              {preferredStack.consumers.layers.map((layer) => (
                <div class="flex flex-1 min-w-[6rem] items-center justify-center rounded-lg border border-dashed border-[var(--color-muted)]/40 p-2.5 text-center">
                  <p class="truncate text-[10px] font-semibold uppercase tracking-wide text-[var(--color-muted)]">
                    {layer.label}
                  </p>
                </div>
              ))}
            </div>

            <StackConnector connector={connectors[0]} height={connectorHeight} arrowId="archArrow-0" />

            <!-- Everything below runs on the same infra, drawn as one wrapping box. -->
            <div class="rounded-xl border-2 border-dashed border-[var(--color-accent)]/40 p-3">
              <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
                <span class="text-[10px] font-semibold uppercase tracking-wide text-[var(--color-accent)]">
                  {preferredStack.infra.label}
                </span>
                <div class="flex flex-wrap justify-end gap-1.5">
                  {(preferredStack.infra.items ?? []).map((name) => (
                    <TechPill name={name} locale={locale} />
                  ))}
                </div>
              </div>

              <div class="flex flex-col">
                {preferredStack.tiers.map((tier, i) => (
                  <>
                    <div class="flex items-stretch gap-2">
                      {tier.layers.map((layer) => (
                        // min-w-[8.5rem], not min-w-0: at min-w-0 a narrow
                        // phone squeezed these below the width a single tech
                        // pill needs (e.g. "scikit-learn"), which both
                        // ellipsized the label ("DATA SCIE...") and forced
                        // pills half out of their own box. This floor keeps
                        // every layer legible; the outer overflow-x-auto
                        // (with the scroll hint above) handles the rest.
                        <div class="flex min-w-[8.5rem] flex-1 flex-col gap-1.5 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] p-2.5 shadow-sm">
                          <p class="truncate text-[10px] font-semibold uppercase tracking-wide text-[var(--color-accent)]">
                            {layer.label}
                          </p>
                          {layer.options ? (
                            <div class="flex flex-wrap items-center gap-2">
                              {layer.options.map((opt, oi) => (
                                <>
                                  {oi > 0 && (
                                    <span class="shrink-0 rounded-full border border-[var(--color-border)] bg-[var(--color-bg)] px-1.5 py-0.5 font-mono text-[9px] uppercase tracking-wide text-[var(--color-muted)]">
                                      {ui.technologies.or}
                                    </span>
                                  )}
                                  <div class="flex flex-col gap-1">
                                    <p class="text-[9px] font-medium uppercase tracking-wide text-[var(--color-muted)]">
                                      {opt.label}
                                    </p>
                                    <div class="flex flex-wrap gap-1.5">
                                      {(opt.items ?? []).map((name) => (
                                        <TechPill name={name} locale={locale} />
                                      ))}
                                    </div>
                                  </div>
                                </>
                              ))}
                            </div>
                          ) : (
                            <div class="flex flex-wrap gap-1.5">
                              {(layer.items ?? []).map((name) => (
                                <TechPill name={name} locale={locale} />
                              ))}
                            </div>
                          )}
                        </div>
                      ))}
                    </div>

                    {i < preferredStack.tiers.length - 1 && (
                      <StackConnector connector={connectors[i + 1]} height={connectorHeight} arrowId={`archArrow-${i + 1}`} />
                    )}
                  </>
                ))}
              </div>
            </div>

            {preferredStack.experimentation && (
              <div class="mx-auto mt-6 w-full max-w-[14rem] rounded-lg border border-dashed border-[var(--color-border)] bg-[var(--color-surface)]/30 p-2.5">
                <p class="mb-1.5 truncate text-[10px] font-semibold uppercase tracking-wide text-[var(--color-muted)]">
                  {preferredStack.experimentation.label}
                  <span class="ml-1 font-normal normal-case text-[var(--color-muted)]">{ui.technologies.notWiredIn}</span>
                </p>
                <div class="flex flex-wrap gap-1.5">
                  {(preferredStack.experimentation.items ?? []).map((name) => (
                    <TechPill name={name} locale={locale} />
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>
      </div>
    )}
  </div>
</dialog>

<script>
  // Switches between the "Search" and "Preferred stack" tabs (only present
  // when there's a preferred stack to show a tab for). Reopening the
  // dialog always lands back on "Search", the tab it opens on today, same
  // "starts fresh" reasoning as the scroll-position/video resets on
  // dialogopen elsewhere (see Layout.astro).
  const tabs = document.querySelectorAll<HTMLButtonElement>('[data-tech-tab]');
  const panels = document.querySelectorAll<HTMLElement>('[data-tech-panel]');
  const techDialog = document.getElementById('technologies-more');

  function selectTab(name: string | undefined) {
    tabs.forEach((tab) => tab.setAttribute('aria-selected', String(tab.dataset.techTab === name)));
    panels.forEach((panel) => panel.classList.toggle('hidden', panel.dataset.techPanel !== name));
  }

  // See the dialog's own comment for the full story: mobile's `h-fit` +
  // `max-h-[94svh]` sizing kept getting a little shorter than last time on a
  // real iPhone, from three unrelated triggers, because this is the only
  // sheet whose content changes shape while it's open — the only one that
  // ever asks mobile WebKit to redo that fit-content-under-a-clamp
  // computation more than once per open. Rather than trust that computation
  // (or nudge it and hope), this sizes the sheet itself, from measurements
  // that are just plain DOM reads rather than a live CSS calculation:
  // `data-tech-header`'s own `offsetHeight` plus the currently visible
  // panel's `scrollHeight` inside `data-tech-scrollpanel` (the other panel
  // contributes nothing — `display: none` on a hidden panel zeroes it out
  // for scrollHeight purposes), clamped to what's actually available on
  // screen right now. Every call starts from scratch — there's no cached
  // value here to go stale in the first place.
  const techHeader = document.querySelector<HTMLElement>('[data-tech-header]');
  const techScrollPanel = document.querySelector<HTMLElement>('[data-tech-scrollpanel]');

  function isMobileSheet(): boolean {
    const handle = techDialog?.querySelector<HTMLElement>('[data-sheet-handle]');
    return !!handle && getComputedStyle(handle).display !== 'none';
  }

  function sizeSheet() {
    if (!techDialog || !techDialog.hasAttribute('open')) return;
    const dialog = techDialog as HTMLElement;
    if (!isMobileSheet() || !techHeader || !techScrollPanel) {
      // sm: and up sizes itself via plain `h-fit` — never affected by this,
      // so nothing here should override it.
      dialog.style.height = '';
      return;
    }
    const cap = window.innerHeight * 0.94;
    const natural = techHeader.offsetHeight + techScrollPanel.scrollHeight;
    dialog.style.height = `${Math.min(natural, cap)}px`;
  }

  let resizeSizeScheduled = false;
  function scheduleSizeSheet() {
    if (resizeSizeScheduled) return;
    resizeSizeScheduled = true;
    requestAnimationFrame(() => {
      resizeSizeScheduled = false;
      sizeSheet();
    });
  }

  tabs.forEach((tab) =>
    tab.addEventListener('click', () => {
      selectTab(tab.dataset.techTab);
      sizeSheet();
    }),
  );
  techDialog?.addEventListener('dialogopen', () => {
    selectTab('search');
    sizeSheet();
  });
  (window.visualViewport ?? window).addEventListener('resize', scheduleSizeSheet);

  // The "swipe to see more" hint above the preferred-stack diagram: only on
  // while there's actually more to see. `scrollWidth`/`clientWidth` both
  // read 0 on a `display: none` panel, so this can only run once the stack
  // tab is the one showing — right after switching to it, and again on
  // resize (an orientation flip can flip whether it overflows at all)
  // while it's still the visible panel. Goes away for good once scrolled
  // once, same "you've found it, stop pointing at it" reasoning as the
  // handle-drag/swipe-to-dismiss gestures elsewhere needing no repeat
  // reminder either — reopening the dialog (always landing back on Search)
  // is what brings it back for the next visit to this tab.
  const stackScrollBox = document.querySelector<HTMLElement>('[data-stack-scrollbox]');
  const stackScrollHint = document.querySelector<HTMLElement>('[data-stack-scroll-hint]');

  function updateStackScrollHint() {
    if (!stackScrollBox || !stackScrollHint) return;
    stackScrollHint.classList.toggle('hidden', stackScrollBox.scrollWidth <= stackScrollBox.clientWidth);
  }

  document.querySelector('[data-tech-tab="stack"]')?.addEventListener('click', updateStackScrollHint);
  window.addEventListener('resize', () => {
    if (stackScrollBox?.closest<HTMLElement>('[data-tech-panel]')?.classList.contains('hidden')) return;
    updateStackScrollHint();
  });
  stackScrollBox?.addEventListener(
    'scroll',
    () => {
      if (stackScrollBox.scrollLeft > 8) stackScrollHint?.classList.add('hidden');
    },
    { passive: true },
  );

  // Filters the flat "All Technologies" grid only. The preferred-stack
  // diagram lives in its own tab, a fixed architecture picture rather than
  // a list, so it stays put regardless of the search term.
  const searchInput = document.getElementById('tech-search') as HTMLInputElement | null;
  const emptyMessage = document.getElementById('tech-search-empty');
  const categories = document.querySelectorAll<HTMLElement>('[data-tech-category]');

  const normalize = (s: string) => s.toLowerCase().replace(/[^a-z0-9]/g, '');

  searchInput?.addEventListener('input', () => {
    // A recruiter can paste a whole keyword list at once, separated by
    // commas or semicolons — each piece is matched independently (OR
    // logic), so pasting "react, node, aws" highlights every one of those
    // pills rather than requiring a literal match of the whole string.
    const terms = searchInput.value
      .split(/[,;]+/)
      .map(normalize)
      .filter(Boolean);
    let anyVisible = false;

    categories.forEach((category) => {
      let categoryHasMatch = false;
      category.querySelectorAll<HTMLElement>('[data-tech-name]').forEach((pill) => {
        // A pinned/highlighted pill (see TechPill's click-to-toggle) stays
        // visible regardless of the search term, so highlighting a
        // technology doesn't make it vanish the moment someone searches
        // for something else.
        const pinned = pill.getAttribute('aria-pressed') === 'true';
        // Matched against the pill's normalized name + known alias tokens
        // (see TechPill's data-tech-search), not just its own display name —
        // so "reactjs" or "react.js" still finds the "React" pill.
        const tokens = (pill.dataset.techSearch ?? '').split(' ');
        const match = pinned || terms.length === 0 || terms.some((term) => tokens.some((token) => token.includes(term)));
        // Inline style, not the `hidden` class — the pill already carries the
        // `inline-flex` display utility, which wins over `hidden` in
        // Tailwind's cascade and would leave it visible.
        pill.style.display = match ? '' : 'none';
        if (match) categoryHasMatch = true;
      });
      category.classList.toggle('hidden', !categoryHasMatch);
      if (categoryHasMatch) anyVisible = true;
    });

    emptyMessage?.classList.toggle('hidden', anyVisible);
    // Filtering changes this panel's content height too — see `sizeSheet`'s
    // own comment above.
    sizeSheet();
  });
</script>
