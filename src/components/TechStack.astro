---
import site from '../data/site.json';
import { techIcons } from '../data/techIcons';

const { technologies } = site;
const iconMap = new Map(techIcons.map((t) => [t.name, t]));
---

<section class="mx-auto max-w-3xl px-6 py-14">
  <h2 class="mb-2 font-mono text-sm tracking-widest text-[var(--color-accent)]">TECHNOLOGIES</h2>
  <p class="mb-6 max-w-xl text-[var(--color-muted)]">{technologies.intro}</p>

  <div class="flex flex-wrap gap-3">
    {
      technologies.items.map((item) => {
        const icon = iconMap.get(item.name);
        return (
          <div class="flex items-center gap-2 rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] py-1.5 pl-1.5 pr-3.5">
            {icon ? (
              <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-white p-1">
                <svg viewBox="0 0 24 24" class="h-full w-full" fill={icon.color}>
                  <path d={icon.path} />
                </svg>
              </span>
            ) : null}
            <span class="whitespace-nowrap text-sm text-[var(--color-text)]">{item.name}</span>
          </div>
        );
      })
    }
  </div>
</section>
