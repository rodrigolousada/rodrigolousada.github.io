---
// Compact, grouped technology badges rendered inside the standalone
// Technologies section (Technologies.astro). A "View more" button opens a
// dialog with the wider skill set from the CV/LinkedIn.
import site from '../data/site.json';
import TechPill from './TechPill.astro';

const { technologies } = site;
const categoryOrder = ['Languages', 'Frameworks & Libraries', 'Data & Databases', 'AI & Data Science', 'Infra & Tools'];

function groupByCategory(list: { name: string; category: string }[]) {
  return categoryOrder
    .map((category) => ({
      category,
      items: list.filter((item) => item.category === category),
    }))
    .filter((g) => g.items.length > 0);
}

const allGroups = groupByCategory([...technologies.items, ...(technologies.extra ?? [])]);
const modalId = 'technologies-more';

// Compact "About" view only surfaces what's actually current, flagged per
// item via `recent` in site.json — checked across both `items` and `extra`
// so a technology doesn't need to live in `items` just to show up here.
// Everything else (recent or not) still shows up in the full "View more"
// breakdown above. Falls back to showing everything if nothing is flagged,
// so this never silently renders empty.
const allTechs = [...technologies.items, ...(technologies.extra ?? [])];
const recentItems = allTechs.filter((item) => item.recent);
const compactItems = recentItems.length > 0 ? recentItems : technologies.items;

// "My preferred stack" mini architecture diagram: a top-to-bottom stack of
// tiers, each tier holding one or more layers rendered side by side (e.g.
// Data and AI/LLMs share a tier). Connectors between tiers are drawn as
// plain SVG lines with an arrowhead, using percentage coordinates so no
// JS measurement or viewBox scaling is needed to stay responsive.
interface StackLayer {
  label: string;
  items: string[];
}
interface StackTier {
  layers: StackLayer[];
}

const preferredStack: StackTier[] = technologies.preferredStack ?? [];
const connectorHeight = 28;

function columnCenters(count: number) {
  return Array.from({ length: count }, (_, i) => ((i + 0.5) / count) * 100);
}

const connectors = preferredStack.slice(0, -1).map((tier, i) => {
  const nextTier = preferredStack[i + 1];
  const topXs = columnCenters(tier.layers.length);
  const bottomXs = columnCenters(nextTier.layers.length);
  const allXs = [...topXs, ...bottomXs];
  return {
    topXs,
    bottomXs,
    midY: connectorHeight / 2,
    busX1: Math.min(...allXs),
    busX2: Math.max(...allXs),
  };
});
---

<div>
  <div class="flex flex-wrap gap-1.5">
    {compactItems.map((item) => (
      <TechPill name={item.name} />
    ))}
  </div>

  {(technologies.extra?.length > 0 || compactItems.length < technologies.items.length) && (
    <button
      type="button"
      onclick={`document.getElementById('${modalId}').showModal()`}
      class="mt-3 text-xs text-[var(--color-accent)] underline underline-offset-4"
    >
      View more →
    </button>
  )}
</div>

<dialog
  id={modalId}
  class="m-auto w-[min(92vw,42rem)] max-h-[85vh] rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-0 text-[var(--color-text)] backdrop:bg-black/60 backdrop:backdrop-blur-sm"
>
  <div class="flex items-center justify-between border-b border-[var(--color-border)] px-6 py-4">
    <p class="font-mono text-xs uppercase tracking-widest text-[var(--color-accent)]">All Technologies</p>
    <form method="dialog">
      <button
        aria-label="Close"
        class="flex h-7 w-7 items-center justify-center rounded-full bg-[var(--color-border)] text-[var(--color-text)] transition hover:brightness-125"
      >
        ✕
      </button>
    </form>
  </div>
  <div class="max-h-[calc(85vh-4rem)] overflow-y-auto p-6">
    <div class="space-y-4">
      {
        allGroups.map((group) => (
          <div>
            <p class="mb-1.5 text-[10px] uppercase tracking-wide text-[var(--color-muted)]/60">{group.category}</p>
            <div class="flex flex-wrap gap-1.5">
              {group.items.map((item) => (
                <TechPill name={item.name} />
              ))}
            </div>
          </div>
        ))
      }
    </div>

    {preferredStack.length > 0 && (
      <>
        <p class="mb-3 mt-6 font-mono text-[10px] uppercase tracking-widest text-[var(--color-muted)]">
          My preferred stack
        </p>
        <div class="overflow-x-auto rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] p-4">
          <div class="mx-auto flex min-w-[16rem] max-w-md flex-col">
            {preferredStack.map((tier, i) => (
              <>
                <div class="flex items-stretch gap-2">
                  {tier.layers.map((layer) => (
                    <div
                      class={`flex flex-1 min-w-0 flex-col gap-1.5 rounded-lg border border-[var(--color-border)] p-2.5 shadow-sm ${
                        i === preferredStack.length - 1 ? 'border-dashed bg-[var(--color-bg)]' : 'bg-[var(--color-surface)]'
                      }`}
                    >
                      <p class="truncate text-[10px] font-semibold uppercase tracking-wide text-[var(--color-accent)]">
                        {layer.label}
                      </p>
                      <div class="flex flex-wrap gap-1.5">
                        {layer.items.map((name) => (
                          <TechPill name={name} />
                        ))}
                      </div>
                    </div>
                  ))}
                </div>

                {i < connectors.length && (
                  <svg width="100%" height={connectorHeight} class="block shrink-0" aria-hidden="true">
                    <defs>
                      <marker
                        id={`archArrow-${i}`}
                        markerWidth="6"
                        markerHeight="6"
                        refX="3"
                        refY="3"
                        orient="auto"
                        class="fill-[var(--color-accent)]"
                      >
                        <path d="M0,0 L6,3 L0,6 Z" />
                      </marker>
                    </defs>
                    {connectors[i].topXs.map((x) => (
                      <line
                        x1={`${x}%`}
                        y1={0}
                        x2={`${x}%`}
                        y2={connectors[i].midY}
                        class="stroke-[var(--color-border)]"
                        stroke-width="1.5"
                      />
                    ))}
                    <line
                      x1={`${connectors[i].busX1}%`}
                      y1={connectors[i].midY}
                      x2={`${connectors[i].busX2}%`}
                      y2={connectors[i].midY}
                      class="stroke-[var(--color-border)]"
                      stroke-width="1.5"
                    />
                    {connectors[i].bottomXs.map((x) => (
                      <line
                        x1={`${x}%`}
                        y1={connectors[i].midY}
                        x2={`${x}%`}
                        y2={connectorHeight - 1}
                        class="stroke-[var(--color-border)]"
                        stroke-width="1.5"
                        marker-end={`url(#archArrow-${i})`}
                      />
                    ))}
                  </svg>
                )}
              </>
            ))}
          </div>
        </div>
      </>
    )}
  </div>
</dialog>
