---
import { getSite, type Locale } from '../data/site';
import LanguageSelector from './LanguageSelector.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const site = getSite(locale);
---

<!-- Below sm, there's no header bar at all, not even a collapsed one: the
     full-width bar (background, border, initials) looked like a permanent
     fixture squatting over the hero on a phone screen. Just a small
     floating circular button, top-right, that opens a slide-in side panel
     with the same links. sm and up keeps the original inline bar; nothing
     changes there. -->
<header class="sticky top-0 z-50 hidden border-b border-[var(--color-border)] bg-[var(--color-bg)]/80 backdrop-blur sm:block">
  <nav class="mx-auto flex max-w-3xl items-center justify-between px-6 py-4">
    <a href="#" class="font-mono text-sm font-semibold text-[var(--color-text)]">{site.nav.initials}</a>
    <div class="flex items-center gap-6">
      <ul class="flex items-center gap-6 text-sm text-[var(--color-muted)]">
        {
          site.nav.links.map((link) => (
            <li>
              <a href={link.href} class="transition hover:text-[var(--color-text)]">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <LanguageSelector locale={locale} />
    </div>
  </nav>
</header>

<button
  type="button"
  data-nav-open
  aria-label="Open menu"
  aria-expanded="false"
  aria-controls="nav-panel"
  class="fixed right-4 top-4 z-50 flex h-11 w-11 items-center justify-center rounded-full border border-[var(--color-border)] bg-[var(--color-surface)]/90 text-[var(--color-text)] shadow-lg backdrop-blur transition hover:text-[var(--color-accent)] sm:hidden"
>
  <svg viewBox="0 0 24 24" class="h-5 w-5 fill-current">
    <path d="M3 6h18v2H3zm0 5h18v2H3zm0 5h18v2H3z" />
  </svg>
</button>

<div
  data-nav-backdrop
  class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-sm sm:hidden"
></div>

<aside
  id="nav-panel"
  data-nav-panel
  class="fixed right-0 top-0 z-50 flex h-dvh w-64 max-w-[80vw] translate-x-full flex-col gap-1 border-l border-[var(--color-border)] bg-[var(--color-surface)] p-6 text-[var(--color-muted)] transition-transform duration-200 sm:hidden"
>
  <button
    type="button"
    data-nav-close
    aria-label="Close menu"
    class="mb-6 ml-auto flex h-8 w-8 items-center justify-center rounded-full bg-[var(--color-border)] text-[var(--color-text)] transition hover:brightness-125"
  >
    ✕
  </button>
  <ul class="flex flex-col gap-5 text-sm">
    {
      site.nav.links.map((link) => (
        <li>
          <a href={link.href} data-nav-link class="transition hover:text-[var(--color-text)]">
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
  <div class="mt-auto pt-5">
    <LanguageSelector locale={locale} />
  </div>
</aside>

<script>
  const openBtn = document.querySelector<HTMLButtonElement>('[data-nav-open]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-nav-close]');
  const backdrop = document.querySelector<HTMLElement>('[data-nav-backdrop]');
  const panel = document.querySelector<HTMLElement>('[data-nav-panel]');
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');

  function openPanel() {
    panel?.classList.remove('translate-x-full');
    backdrop?.classList.remove('hidden');
    openBtn?.setAttribute('aria-expanded', 'true');
  }
  function closePanel() {
    panel?.classList.add('translate-x-full');
    backdrop?.classList.add('hidden');
    openBtn?.setAttribute('aria-expanded', 'false');
  }

  openBtn?.addEventListener('click', openPanel);
  closeBtn?.addEventListener('click', closePanel);
  backdrop?.addEventListener('click', closePanel);
  links.forEach((link) => link.addEventListener('click', closePanel));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closePanel();
  });
</script>
