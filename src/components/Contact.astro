---

<section id="contact" class="mx-auto max-w-3xl px-6 py-14">
  <h2 class="mb-6 font-mono text-sm tracking-widest text-[var(--color-accent)]">
    GET IN TOUCH
  </h2>

  <p class="max-w-xl text-[var(--color-muted)]">
    Open to <span class="text-[var(--color-text)]">Engineering Manager / Tech Lead</span> opportunities,
    speaking invitations, and interesting conversations.
  </p>

  <div id="card-grid" class="mt-8 grid grid-cols-1 gap-5 [perspective:1200px] sm:grid-cols-2">
    <!-- Personal card -->
    <div class="card-slot [transform-style:preserve-3d] transition-transform duration-700 ease-out">
    <button
      type="button"
      class="flip-card group relative aspect-[1.75/1] w-full cursor-pointer text-left [transform-style:preserve-3d] transition-transform duration-700 ease-out"
      aria-label="Flip personal card"
    >
      <div class="absolute inset-0 overflow-hidden rounded-2xl bg-white shadow-xl [backface-visibility:hidden]">
        <div class="absolute inset-y-0 left-0 w-2.5 bg-blue-600"></div>
        <div class="flex h-full flex-col justify-between py-6 pl-8 pr-6 text-neutral-900">
          <div class="flex items-center gap-3">
            <img src="/img/profile.jpg" alt="Rodrigo Lousada" class="h-12 w-12 rounded-md object-cover" />
            <div>
              <p class="text-lg font-semibold">Rodrigo Lousada</p>
              <p class="text-xs text-neutral-500">Open to EM / Tech Lead roles</p>
            </div>
          </div>
          <div class="space-y-1.5">
            {
              personalLinks.map((link) => (
                <a
                  href={link.href}
                  target={link.href.startsWith('http') ? '_blank' : undefined}
                  rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                  class="card-link flex items-center gap-2 text-sm text-neutral-600 transition hover:text-blue-600"
                >
                  <svg viewBox="0 0 24 24" class="h-3.5 w-3.5 shrink-0 fill-current">
                    <path d={link.icon} />
                  </svg>
                  <span class="truncate">{link.value}</span>
                </a>
              ))
            }
          </div>
        </div>
        <span class="absolute bottom-2 right-3 font-mono text-[10px] text-neutral-400">click me to rotate ↻</span>
      </div>

      <div class="absolute inset-0 flex flex-col items-center justify-center rounded-2xl bg-blue-600 shadow-xl [backface-visibility:hidden] [transform:rotateY(180deg)]">
        <p class="font-display text-2xl font-bold text-white">Rodrigo Lousada</p>
        <p class="mt-1 font-mono text-xs uppercase tracking-widest text-blue-100">personal card</p>
        <span class="absolute bottom-2 right-3 font-mono text-[10px] text-white/50">click me to rotate ↻</span>
      </div>
    </button>
    </div>

    <!-- Klarna card -->
    <div class="card-slot [transform-style:preserve-3d] transition-transform duration-700 ease-out">
    <button
      type="button"
      class="flip-card group relative aspect-[1.75/1] w-full cursor-pointer text-left [transform-style:preserve-3d] transition-transform duration-700 ease-out"
      aria-label="Flip Klarna card"
    >
      <div class="absolute inset-0 overflow-hidden rounded-2xl bg-white shadow-xl [backface-visibility:hidden]">
        <div class="absolute inset-y-0 left-0 w-2.5 bg-[#ffb3c7]"></div>
        <div class="flex h-full flex-col justify-between py-6 pl-8 pr-6 text-neutral-900">
          <div class="flex items-center gap-3">
            <img src="/img/profile.jpg" alt="Rodrigo Lousada" class="h-12 w-12 rounded-md object-cover" />
            <div>
              <p class="text-lg font-semibold">Rodrigo Lousada</p>
              <p class="text-xs text-neutral-500">Software Engineer · Referrals &amp; Deals</p>
            </div>
          </div>
          <div class="space-y-1.5">
            {
              klarnaLinks.map((link) => (
                <a
                  href={link.href}
                  class="card-link flex items-center gap-2 text-sm text-neutral-600 transition hover:text-pink-500"
                >
                  <svg viewBox="0 0 24 24" class="h-3.5 w-3.5 shrink-0 fill-current">
                    <path d={link.icon} />
                  </svg>
                  <span class="truncate">{link.value}</span>
                </a>
              ))
            }
          </div>
        </div>
        <span class="absolute bottom-2 right-3 font-mono text-[10px] text-neutral-400">click me to rotate ↻</span>
      </div>

      <div class="absolute inset-0 flex flex-col items-center justify-center rounded-2xl bg-[#ffb3c7] shadow-xl [backface-visibility:hidden] [transform:rotateY(180deg)]">
        <img src="/img/klarna-logo.svg" alt="Klarna" class="h-16 w-auto" />
        <span class="absolute bottom-2 right-3 font-mono text-[10px] text-neutral-600/70">click me to rotate ↻</span>
      </div>
    </button>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.card-link').forEach((link) => {
    link.addEventListener('click', (e) => e.stopPropagation());
  });

  const flipCards = document.querySelectorAll<HTMLElement>('.flip-card');
  const grid = document.getElementById('card-grid');
  const slots = document.querySelectorAll<HTMLElement>('.card-slot');
  const [stationarySlot, movingSlot] = slots;

  const ENTER_DELAY = 200;
  const STACK_DURATION = 700;
  const FLIP_DURATION = 700;

  let inView = false;
  const pending: ReturnType<typeof setTimeout>[] = [];

  function clearPending() {
    pending.forEach((t) => clearTimeout(t));
    pending.length = 0;
  }

  function setFlipped(card: HTMLElement, flipped: boolean) {
    card.style.transform = flipped ? 'rotateY(180deg)' : '';
    card.dataset.flipped = flipped ? 'true' : 'false';
  }

  function setStacked(stacked: boolean) {
    if (!stationarySlot || !movingSlot) return;
    if (!stacked) {
      stationarySlot.style.transform = '';
      movingSlot.style.transform = '';
      return;
    }
    const isRow = window.matchMedia('(min-width: 640px)').matches;
    movingSlot.style.transform = isRow
      ? 'translateX(calc(-100% - 1.25rem)) rotate(-4deg) scale(0.96)'
      : 'translateY(calc(-100% - 1.25rem)) rotate(-4deg) scale(0.96)';
    stationarySlot.style.transform = 'rotate(3deg) scale(0.98)';
  }

  function setImmediate(run: () => void) {
    const els = [stationarySlot, movingSlot, ...Array.from(flipCards)].filter(Boolean) as HTMLElement[];
    els.forEach((el) => (el.style.transitionDuration = '0s'));
    run();
    // force reflow so the 0s transition actually applies before re-enabling
    void document.body.offsetHeight;
    els.forEach((el) => (el.style.transitionDuration = ''));
  }

  // Resting state before the first reveal: stacked and face-down, no animation.
  setImmediate(() => {
    setStacked(true);
    flipCards.forEach((card) => setFlipped(card, true));
  });

  function playEnter() {
    clearPending();
    pending.push(
      setTimeout(() => {
        setStacked(false); // spread apart while still face-down
        pending.push(
          setTimeout(() => {
            flipCards.forEach((card) => setFlipped(card, false)); // reveal fronts
          }, STACK_DURATION)
        );
      }, ENTER_DELAY)
    );
  }

  function playExit() {
    clearPending();
    flipCards.forEach((card) => setFlipped(card, true)); // flip to back first
    pending.push(
      setTimeout(() => {
        setStacked(true); // then collect into the stack
      }, FLIP_DURATION)
    );
  }

  if (grid) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        inView = entry.isIntersecting;
        if (inView) playEnter();
        else playExit();
      },
      { threshold: 0.35 }
    );
    observer.observe(grid);
  }

  window.addEventListener('resize', () => {
    if (!inView) setStacked(true);
  });

  // Manual click-to-flip only makes sense once the cards have settled face-up.
  flipCards.forEach((card) => {
    card.addEventListener('click', () => {
      if (!inView) return;
      const flipped = card.dataset.flipped === 'true';
      setFlipped(card, !flipped);
    });
  });
</script>
