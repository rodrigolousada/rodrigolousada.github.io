---
// Shared technology badge — icon + name — used everywhere a tech stack is
// listed (Technologies section, career/project "Technologies", side project
// cartridges) so they all look the same instead of three styles. Styled
// after nathanbrachotte.dev/'s tech-stack row: logos sit directly on the pill
// with no backing circle, everything is a touch bigger than a typical badge,
// hovering grows the whole pill, and clicking opens the tech's own docs.
import { techIcons } from '../data/techIcons';

interface Props {
  name: string;
}

const { name } = Astro.props;
const icon = techIcons.find((t) => t.name === name);

// A few brand colors (GitHub black, Kafka near-black, ...) are too close to
// the pill's own background to read once the white backing circle is gone —
// swap those for the theme's muted text color instead of guessing per-icon
// exceptions. Judged by actual contrast against the pill background (WCAG
// contrast ratio), not raw brightness — a moderately dark but saturated
// color (Datadog purple, Terraform violet) still reads fine on this
// background and should keep its real color; only near-invisible ones
// (contrast well under the "graphical object" 3:1 baseline) get swapped.
const PILL_BG = '#131318'; // must match --color-surface in global.css
function relativeLuminance(hex: string) {
  const [r, g, b] = [hex.slice(1, 3), hex.slice(3, 5), hex.slice(5, 7)].map((h) => parseInt(h, 16) / 255);
  const lin = (v: number) => (v <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4);
  return 0.2126 * lin(r) + 0.7152 * lin(g) + 0.0722 * lin(b);
}
function contrastRatio(hexA: string, hexB: string) {
  const [la, lb] = [relativeLuminance(hexA), relativeLuminance(hexB)];
  const [lighter, darker] = la > lb ? [la, lb] : [lb, la];
  return (lighter + 0.05) / (darker + 0.05);
}
const iconColor = icon && contrastRatio(icon.color, PILL_BG) < 1.8 ? 'var(--color-muted)' : icon?.color;
const iconSize = icon?.sizePx ?? 18;
---

<a
  href={icon?.url}
  target="_blank"
  rel="noopener noreferrer"
  data-tech-name={name.toLowerCase()}
  class="tech-pill inline-flex items-center gap-2 rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] py-1.5 pl-2.5 pr-3.5 transition hover:scale-110 hover:border-[var(--color-accent)]"
>
  {icon && (
    icon.svg ? (
      <svg viewBox={icon.viewBox ?? '0 0 24 24'} class="shrink-0" style={`height:${iconSize}px;width:${iconSize}px;`} set:html={icon.svg} />
    ) : (
      <svg viewBox="0 0 24 24" class="shrink-0" style={`height:${iconSize}px;width:${iconSize}px;`} fill={iconColor}>
        <path d={icon.path} fill-rule={icon.fillRule} />
      </svg>
    )
  )}
  <span class="whitespace-nowrap text-xs text-[var(--color-text)]">{name}</span>
</a>

<style>
  /* transform-origin center so growth reads as "bigger in place", not a shift */
  .tech-pill {
    transform-origin: center;
  }
</style>
