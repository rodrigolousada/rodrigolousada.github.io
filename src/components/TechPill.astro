---
// Shared technology badge — icon + name — used everywhere a tech stack is
// listed (Technologies section, career/project "Technologies", side project
// cartridges) so they all look the same instead of three styles. Styled
// after nathanbrachotte.dev/'s tech-stack row: logos sit directly on the pill
// with no backing circle, everything is a touch bigger than a typical badge,
// and hovering grows the whole pill.
//
// Clicking toggles a pinned/highlighted state rather than navigating
// anywhere — it used to open the tech's own docs, but a visitor can't mark
// several favorites that way, only leave the page one at a time. Pinned
// pills also survive the "All Technologies" search filter (see TechStack's
// script) so someone can highlight the ones they like while still narrowing
// the list down.
import { techIcons } from '../data/techIcons';
import { techAliases } from '../data/techAliases';
import { getUI } from '../data/ui';
import { getSurfaceColor, contrastRatio } from '../data/contrast';
import type { Locale } from '../data/site';

interface Props {
  name: string;
  locale: Locale;
}

const { name, locale } = Astro.props;
const ui = getUI(locale);
const highlightLabel = ui.technologies.highlight.replace('{name}', name);
const icon = techIcons.find((t) => t.name === name);

// Normalized search tokens for this pill: its own name plus any known
// alternate spellings (see techAliases.ts), each stripped down to bare
// lowercase alphanumerics so "React.js", "React JS" and "ReactJS" all
// collapse to the same token as "React" itself. TechStack's search reads
// this back off `data-tech-search` and normalizes the query the same way,
// so a recruiter pasting an odd spelling still finds a match.
const normalize = (s: string) => s.toLowerCase().replace(/[^a-z0-9]/g, '');
const searchTokens = [name, ...(techAliases[name] ?? [])].map(normalize).join(' ');

// A few brand colors (GitHub black, Kafka near-black, ...) are too close to
// the pill's own background to read once the white backing circle is gone —
// swap those for the theme's muted text color instead of guessing per-icon
// exceptions. Judged by actual contrast against the pill background (WCAG
// contrast ratio, see src/data/contrast.ts), not raw brightness — a
// moderately dark but saturated color (Datadog purple, Terraform violet)
// still reads fine on this background and should keep its real color; only
// near-invisible ones get swapped. The cutoff below (1.8) is deliberately
// under WCAG's 3:1 "graphical object" baseline: it's tuned empirically
// against this actual icon set to catch only the genuinely hard-to-read
// colors, not merely suboptimal ones, since 3:1 would swap several brand
// colors that read fine in practice.
const PILL_BG = getSurfaceColor();
const iconColor = icon && contrastRatio(icon.color, PILL_BG) < 1.8 ? 'var(--color-muted)' : icon?.color;
const iconSize = icon?.sizePx ?? 18;
---

<button
  type="button"
  data-tech-pill
  data-tech-name={name.toLowerCase()}
  data-tech-search={searchTokens}
  aria-pressed="false"
  title={highlightLabel}
  class="tech-pill inline-flex items-center gap-2 rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] py-1.5 pl-2.5 pr-3.5 text-left transition hover:scale-110 hover:border-[var(--color-accent)] aria-pressed:border-[var(--color-accent)] aria-pressed:bg-[var(--color-accent)]/10"
>
  {icon && (
    icon.svg ? (
      <svg viewBox={icon.viewBox ?? '0 0 24 24'} class="shrink-0" style={`height:${iconSize}px;width:${iconSize}px;`} set:html={icon.svg} />
    ) : (
      <svg viewBox="0 0 24 24" class="shrink-0" style={`height:${iconSize}px;width:${iconSize}px;`} fill={iconColor}>
        <path d={icon.path} fill-rule={icon.fillRule} />
      </svg>
    )
  )}
  <span class="whitespace-nowrap text-xs text-[var(--color-text)]">{name}</span>
</button>

<style>
  /* transform-origin center so growth reads as "bigger in place", not a shift */
  .tech-pill {
    transform-origin: center;
  }
</style>

<script>
  // One delegated listener covers every pill on the page, however many
  // TechPill instances rendered it — no per-instance wiring needed, and it
  // still works for pills that appear later inside a <dialog> (native
  // dialogs stay part of the document, so clicks inside them bubble here
  // same as anywhere else).
  //
  // The same technology can render as several separate pills (the compact
  // "Technologies" list, the "All Technologies" search modal, the
  // preferred-stack diagram): toggling one pins/unpins that technology,
  // not just that one button, so it syncs across every instance keyed by
  // `data-tech-name` regardless of which copy was actually clicked.
  document.addEventListener('click', (e) => {
    const pill = (e.target as HTMLElement)?.closest<HTMLElement>('[data-tech-pill]');
    if (!pill) return;
    const name = pill.dataset.techName;
    if (!name) return;
    const pressed = pill.getAttribute('aria-pressed') === 'true';
    const next = pressed ? 'false' : 'true';
    document.querySelectorAll<HTMLElement>(`[data-tech-pill][data-tech-name="${CSS.escape(name)}"]`).forEach((el) => {
      el.setAttribute('aria-pressed', next);
    });
  });
</script>
