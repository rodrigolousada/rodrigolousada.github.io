---
import { getSite, type Locale } from '../data/site';
import { getUI } from '../data/ui';
import { icons } from '../data/icons';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { speaking } = getSite(locale);
const ui = getUI(locale);
---

<section id="speaking" class="mx-auto max-w-3xl px-6 py-14">
  <div class="mb-6 flex items-center gap-3">
    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[var(--color-accent)]/10 text-[var(--color-accent)]">
      <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current">
        <path d={icons.microphone} />
      </svg>
    </span>
    <h2 class="font-mono text-sm tracking-widest text-[var(--color-accent)]">{ui.speaking.heading}</h2>
  </div>

  <p class="max-w-xl text-[var(--color-muted)]">{speaking.intro}</p>

  <ul class="mt-6 columns-1 gap-x-6 sm:columns-2">
    {
      speaking.topics.map((topic) => (
        <li class="mb-3 flex break-inside-avoid gap-2 text-[var(--color-text)]">
          <span class="text-[var(--color-accent)]">▸</span>
          <span>{topic}</span>
        </li>
      ))
    }
  </ul>

  {speaking.talks && speaking.talks.length > 0 && (
    <div class="mt-10 flex flex-wrap justify-center gap-x-8 gap-y-10 pb-2 sm:justify-start">
      {
        speaking.talks.map((talk) => (
          <figure
            class="w-36 shrink-0 bg-[#f7f4ef] p-2.5 pb-4 shadow-lg sm:w-40"
            style={`transform: rotate(${talk.rotate ?? 0}deg);`}
          >
            {talk.photo ? (
              <img src={talk.photo} alt={talk.caption} class="aspect-square w-full object-cover" />
            ) : (
              <div class="flex aspect-square w-full items-center justify-center border border-dashed border-neutral-300 bg-neutral-100">
                <svg viewBox="0 0 24 24" class="h-7 w-7 fill-current text-neutral-300">
                  <path d={icons.camera} />
                </svg>
              </div>
            )}
            <figcaption class="mt-2.5 truncate text-center font-display text-xs text-neutral-500">
              “{talk.caption}”
            </figcaption>
          </figure>
        ))
      }
    </div>
  )}

  <a
    href="#contact"
    class="mt-6 inline-block text-sm font-medium text-[var(--color-accent)] underline underline-offset-4"
  >
    {ui.speaking.inviteMeToSpeak}
  </a>
</section>
