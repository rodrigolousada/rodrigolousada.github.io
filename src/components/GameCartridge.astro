---
interface Props {
  project: {
    title: string;
    subtitle: string;
    description: string;
    technologies: string[];
    repoUrl: string;
    demoUrl?: string;
    demoLabel?: string;
    shellColor: string;
    labelColor: string;
  };
  modalId: string;
}

const { project, modalId } = Astro.props;
---

<div>
  <button
    type="button"
    onclick={`document.getElementById('${modalId}').showModal()`}
    class={`group relative flex h-40 w-32 shrink-0 flex-col items-center pt-3 text-left shadow-lg transition hover:-translate-y-1 hover:shadow-xl ${project.shellColor}`}
    style="clip-path: polygon(0 0, 78% 0, 100% 18%, 100% 100%, 0 100%); border-radius: 10px;"
  >
    <div class={`flex h-16 w-24 flex-col items-center justify-center gap-1 rounded-sm p-1.5 text-center ${project.labelColor}`}>
      <p class="font-pixel text-[9px] leading-tight text-neutral-900">{project.title}</p>
      <p class="font-mono text-[8px] uppercase tracking-wide text-neutral-500">{project.subtitle}</p>
    </div>
    <div class="mt-3 flex gap-1">
      <span class="h-1 w-10 rounded-full bg-black/20"></span>
    </div>
    <div class="mt-1.5 flex gap-1">
      <span class="h-1 w-10 rounded-full bg-black/20"></span>
    </div>
    <span class="absolute bottom-2 font-mono text-[8px] uppercase tracking-widest text-white/50 transition group-hover:text-white/80">
      Insert →
    </span>
  </button>

  <dialog
    id={modalId}
    class="m-auto w-[min(90vw,32rem)] rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-0 text-[var(--color-text)] backdrop:bg-black/60 backdrop:backdrop-blur-sm"
  >
    <div class="overflow-hidden rounded-xl">
      <div class={`relative flex items-center justify-between px-6 py-5 ${project.shellColor}`}>
        <div>
          <p class="font-pixel text-xs text-white">{project.title}</p>
          <p class="mt-1 font-mono text-[10px] uppercase tracking-wide text-white/70">{project.subtitle}</p>
        </div>
        <form method="dialog">
          <button
            aria-label="Close"
            class="flex h-7 w-7 items-center justify-center rounded-full bg-black/20 text-white transition hover:bg-black/40"
          >
            ✕
          </button>
        </form>
      </div>

      <div class="p-6">
        <p class="text-[var(--color-muted)]">{project.description}</p>

        <p class="mt-4 text-xs font-medium uppercase tracking-wide text-[var(--color-accent)]">Technologies</p>
        <div class="mt-2 flex flex-wrap gap-2">
          {project.technologies.map((tech) => (
            <span class="rounded border border-[var(--color-border)] px-2 py-0.5 font-mono text-xs text-[var(--color-muted)]">
              {tech}
            </span>
          ))}
        </div>

        {project.demoUrl && (
          <>
            <p class="mb-2 mt-5 text-xs font-medium uppercase tracking-wide text-[var(--color-accent)]">Demo</p>
            <a
              href={project.demoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="group/screen flex h-28 items-center justify-center rounded-lg border-2 border-[var(--color-border)] bg-black transition hover:border-[var(--color-accent)]"
            >
              <span class="flex items-center gap-2 font-mono text-xs text-[var(--color-muted)] transition group-hover/screen:text-[var(--color-accent)]">
                <svg viewBox="0 0 24 24" class="h-8 w-8 fill-current">
                  <path d="M8 5v14l11-7z" />
                </svg>
                {project.demoLabel}
              </span>
            </a>
          </>
        )}

        <a
          href={project.repoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-5 flex items-center justify-center gap-2 rounded-lg border border-[var(--color-border)] p-3 text-sm font-medium text-[var(--color-text)] transition hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
        >
          View on GitHub →
        </a>
      </div>
    </div>
  </dialog>
</div>
