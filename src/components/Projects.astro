---
import site from '../data/site.json';
import CareerStopRow from './CareerStopRow.astro';
const { careerPath, careerPathMore, sideProjects } = site;
---

<section id="projects" class="mx-auto max-w-3xl px-6 py-14">
  <h2 class="mb-12 font-mono text-sm tracking-widest text-[var(--color-accent)]">
    PROJECTS
  </h2>

  <div class="relative space-y-4 border-l border-[var(--color-border)] pl-6 sm:pl-8">
    {careerPath.map((stop, i) => <CareerStopRow stop={stop} modalId={`career-modal-${i}`} />)}

    <details class="group/more relative">
      <summary class="flex cursor-pointer list-none items-center gap-2 py-2 font-mono text-xs text-[var(--color-muted)] transition hover:text-[var(--color-accent)] [&::-webkit-details-marker]:hidden">
        <span class="transition group-open/more:rotate-90">▸</span>
        Show more
      </summary>
      <div class="mt-4 space-y-4">
        {careerPathMore.map((stop, i) => <CareerStopRow stop={stop} modalId={`career-modal-more-${i}`} />)}
      </div>
    </details>
  </div>

  <div class="mt-14">
    <h3 class="mb-1 text-sm font-medium tracking-wide text-[var(--color-muted)]">
      SIDE PROJECTS
    </h3>
    <p class="mb-6 text-xs text-[var(--color-muted)]/70">
      Draft placeholders below — swap for real projects (or remove this section) before publishing.
    </p>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      {
        sideProjects.map((sp) => (
          <div class="relative overflow-hidden rounded-xl border border-dashed border-[var(--color-border)] bg-[var(--color-surface)] p-5">
            {sp.placeholder && (
              <span class="absolute right-3 top-3 rounded-full border border-[var(--color-border)] px-2 py-0.5 text-[10px] uppercase tracking-wide text-[var(--color-muted)]">
                Example
              </span>
            )}
            <div class={`mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-gradient-to-br ${sp.cover} font-mono text-xs font-bold text-[var(--color-text)]`}>
              {sp.initials}
            </div>
            <h4 class="font-semibold text-[var(--color-text)]">{sp.title}</h4>
            <p class="mt-1.5 text-sm text-[var(--color-muted)]">{sp.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  dialog[open] {
    animation: dialog-in 0.15s ease-out;
  }
  @keyframes dialog-in {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLDialogElement>('dialog').forEach((dialog) => {
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  });
</script>
