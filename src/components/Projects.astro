---
import { getSite, type Locale } from '../data/site';
import { getUI } from '../data/ui';
import CareerStopRow from './CareerStopRow.astro';
import GameCartridge from './GameCartridge.astro';
import FocusHistoryChart from './FocusHistoryChart.astro';
import { icons } from '../data/icons';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { careerPath, careerPathMore, sideProjects, about } = getSite(locale);
const ui = getUI(locale);

// Cartridges are sized to fit exactly 4 per row (2 on narrow screens) via a
// grid rather than a fixed pixel width in a wrapping flex row — the fixed
// width used to leave a 4th cartridge stranded on its own row with empty
// space beside it. Anything past the first 4 hides behind "Show more",
// same pattern as the career timeline above.
const visibleSideProjects = sideProjects.slice(0, 4);
const moreSideProjects = sideProjects.slice(4);
---

<section id="projects" class="mx-auto max-w-3xl px-6 py-14">
  <div class="mb-12 flex items-center gap-3">
    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[var(--color-accent)]/10 text-[var(--color-accent)]">
      <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current">
        <path d={icons.briefcase} />
      </svg>
    </span>
    <h2 class="font-mono text-sm tracking-widest text-[var(--color-accent)]">{ui.projects.heading}</h2>
  </div>

  <div class="space-y-4">
    <!-- "Looking for" reframed as the newest, still-open entry in the
         timeline: a dashed project waiting for its next chapter. Clicking
         it jumps to the Get In Touch section rather than opening a modal
         (or an email client directly — that's still one click away there). -->
    <div class="grid grid-cols-[1rem_1fr] gap-2 sm:grid-cols-[1.5rem_1fr] sm:gap-4">
      <div class="relative">
        <span class="absolute left-1/2 top-0 h-[calc(100%+1rem)] w-px -translate-x-1/2 bg-[var(--color-border)]" />
        <span class="absolute left-1/2 top-1/2 z-10 h-2.5 w-2.5 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-dashed border-[var(--color-accent)] bg-[var(--color-bg)] ring-4 ring-[var(--color-bg)]" />
      </div>
      <a
        href="#contact"
        class="group flex w-full items-center gap-4 rounded-xl border-2 border-dashed border-[var(--color-border)] bg-[var(--color-surface)]/60 p-4 text-left transition hover:border-[var(--color-accent)] sm:p-5"
      >
        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg border-2 border-dashed border-[var(--color-muted)]/40 text-[var(--color-muted)] transition group-hover:border-[var(--color-accent)] group-hover:text-[var(--color-accent)]">
          <svg viewBox="0 0 24 24" class="h-5 w-5 fill-current">
            <path d={icons.mail} />
          </svg>
        </div>
        <div class="min-w-0 flex-1">
          <p class="font-semibold text-[var(--color-text)]">{ui.projects.whatsNext}</p>
          <p class="text-xs text-[var(--color-muted)]">{about.lookingFor}</p>
        </div>
        <span class="shrink-0 font-mono text-xs text-[var(--color-muted)] transition group-hover:text-[var(--color-accent)]">
          {ui.projects.letsTalk}
        </span>
      </a>
    </div>

    {careerPath.map((stop, i) => <CareerStopRow stop={stop} modalId={`career-modal-${i}`} locale={locale} />)}

    <details class="group/more">
      <summary class="grid cursor-pointer list-none grid-cols-[1rem_1fr] gap-2 [&::-webkit-details-marker]:hidden sm:grid-cols-[1.5rem_1fr] sm:gap-4">
        <div class="relative">
          <span class="absolute left-1/2 top-0 hidden h-[calc(100%+1rem)] w-px -translate-x-1/2 bg-[var(--color-border)] group-open/more:block" />
          <span class="absolute left-1/2 top-1/2 z-10 h-2 w-2 -translate-x-1/2 -translate-y-1/2 rounded-full bg-[var(--color-muted)] ring-4 ring-[var(--color-bg)]" />
        </div>
        <span class="flex items-center gap-2 py-2 font-mono text-xs text-[var(--color-muted)] transition group-hover/more:text-[var(--color-accent)]">
          <span class="inline-block transition group-open/more:rotate-90">▸</span>
          {ui.common.showMore}
        </span>
      </summary>
      <div class="mt-4 space-y-4">
        {careerPathMore.map((stop, i) => (
          <CareerStopRow
            stop={stop}
            modalId={`career-modal-more-${i}`}
            showLine={i !== careerPathMore.length - 1}
            locale={locale}
          />
        ))}
      </div>
    </details>
  </div>

  <!-- One shared dialog for every stop's "Focus this era" button above,
       rather than each stop rendering its own copy of the same
       all-stops-at-once chart — see FocusHistoryChart.astro. -->
  <FocusHistoryChart locale={locale} />

  <div class="mt-14">
    <h3 class="mb-1 text-sm font-medium tracking-wide text-[var(--color-muted)]">
      {ui.projects.sideProjectsHeading}
    </h3>
    <p class="mb-6 text-xs text-[var(--color-muted)]">
      {ui.projects.clickToLoad}
    </p>
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
      {
        visibleSideProjects.map((sp, i) => (
          <GameCartridge project={sp} modalId={`side-project-modal-${i}`} locale={locale} />
        ))
      }
    </div>

    {moreSideProjects.length > 0 && (
      <details class="group/sidemore">
        <summary class="mt-4 flex cursor-pointer list-none items-center gap-2 font-mono text-xs text-[var(--color-muted)] transition hover:text-[var(--color-accent)] [&::-webkit-details-marker]:hidden">
          <span class="inline-block transition group-open/sidemore:rotate-90">▸</span>
          {ui.common.showMore}
        </summary>
        <div class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-4">
          {
            moreSideProjects.map((sp, i) => (
              <GameCartridge project={sp} modalId={`side-project-modal-more-${i}`} locale={locale} />
            ))
          }
        </div>
      </details>
    )}
  </div>
</section>

<script>
  document.querySelectorAll<HTMLDialogElement>('dialog').forEach((dialog) => {
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  });

  // A locked ("Coming soon") project, side project, or career stop
  // (ProjectRow.astro / GameCartridge.astro / CareerStopRow.astro, marked
  // via `[data-locked]`) is a real, clickable button rather than a disabled
  // one — clicking it shakes and flashes red (`.locked-shake` in
  // global.css) plus a short blocked-sounding beep, so it reads as
  // intentionally locked rather than broken.
  let lockedAudioCtx: AudioContext | null = null;

  function playLockedSound() {
    try {
      lockedAudioCtx ??= new AudioContext();
      const ctx = lockedAudioCtx;
      if (ctx.state === 'suspended') void ctx.resume();
      const now = ctx.currentTime;
      // Two quick low blips, like an access-denied buzzer.
      [0, 0.09].forEach((offset) => {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'square';
        osc.frequency.setValueAtTime(160, now + offset);
        gain.gain.setValueAtTime(0.06, now + offset);
        gain.gain.exponentialRampToValueAtTime(0.001, now + offset + 0.08);
        osc.connect(gain).connect(ctx.destination);
        osc.start(now + offset);
        osc.stop(now + offset + 0.09);
      });
    } catch {
      // Audio unavailable (autoplay policy, unsupported browser, etc) — the
      // shake alone still reads as "blocked".
    }
  }

  document.addEventListener('click', (e) => {
    const target = (e.target as HTMLElement).closest<HTMLElement>('[data-locked]');
    if (!target) return;
    playLockedSound();
    target.classList.remove('locked-shake');
    // Force reflow so a second click mid-animation restarts it cleanly.
    void target.offsetWidth;
    target.classList.add('locked-shake');
    target.addEventListener('animationend', () => target.classList.remove('locked-shake'), { once: true });
  });
</script>
