---
// Shared "Focus areas over the years" stacked area chart: one dialog for the
// whole page (not one per career stop) since it plots every stop's focus
// split on the same axes. Rendered once by Projects.astro; opened from any
// stop's "Focus this era" button (CareerStopRow.astro) via a
// `data-open-focus-chart` click, delegated to here rather than each stop
// owning a copy of this data.
import { getSite, type Locale } from '../data/site';
import { getUI } from '../data/ui';
import DialogCloseButton from './DialogCloseButton.astro';
import ScaledLogo from './ScaledLogo.astro';

interface Props {
  locale: Locale;
}

// site.json infers a distinct literal type per career stop (each one's own
// object shape), so a stop that happens to omit `logoScale`/`logoInvert`
// altogether — most of them, both are rare overrides — produces a union
// where the property isn't there at all on that member, not just optional.
// That's fine one stop at a time (CareerStopRow's own Props type structurally
// accepts any of them), but reading `.logoScale` off an *array* of mixed
// stops needs one common shape to read it through, hence this cast rather
// than using `careerPath`'s inferred type directly.
interface HistoryStop {
  org: string;
  slug?: string;
  logo: string;
  logoScale?: number;
  /** Overrides `logoScale` for this chart's own x-axis tick only, where the chip is smaller and tighter than the career-stop row it's otherwise shared with — a multiplier tuned for that bigger chip can under-fill this one. Falls back to `logoScale` when unset. */
  tickLogoScale?: number;
  logoInvert?: boolean;
  chipClass: string;
  period: string;
  /** Set on a stop whose own first `focusByYear` entry is the same real
   * calendar year as the *previous* (chronologically) stop's entry at this
   * index — SINFO and this Master's thesis at Instituto de Telecomunicações
   * ran concurrently for one year (SINFO's 2nd year, index 1). Rather than
   * plot that shared year as two separate sequential x-axis columns
   * (implying one ended before the other began), the points-flattening
   * below folds this stop's first year into that shared point instead of
   * giving it a new column of its own. Doesn't generalize to "any overlap
   * anywhere": it only ever looks at the one stop immediately before this
   * one, since that's the only overlap in this timeline today. */
  overlapsPreviousStopAtYearIndex?: number;
  focus: Record<string, number>;
  /** One focus split per year this stop actually spanned (IBM's 4 years get
   * 4 entries, SINFO's 3 get 3, and so on), so a longer stop plots as more
   * points along the x-axis instead of the same single flat one every stop
   * got before. Stops with a real remembered progression (IBM, SINFO) have
   * genuinely different values year to year; stops that were flat the whole
   * time just repeat the same split at each point. Falls back to a single
   * point (`[focus]`) when unset entirely. `focus` itself is kept as the
   * average of these, the whole-tenure summary shown on the stop's own row. */
  focusByYear?: Record<string, number>[];
}

const { locale } = Astro.props;
const { careerPath, careerPathMore, focusCategories } = getSite(locale);
const ui = getUI(locale);

// The timeline above lists stops newest-first; a chart "over the years"
// reads left to right, oldest first, so this reverses it once here rather
// than asking every consumer of this order to remember to.
const stops = ([...careerPath, ...careerPathMore] as unknown as HistoryStop[]).slice().reverse();

// Flatten every stop's `focusByYear` (or its single `focus` when a stop
// has no per-year breakdown yet) into one ordered list of points. This is
// what actually drives the x-axis now: a 4-year stop contributes 4 of
// these, a 2-year stop only 2, so spacing them evenly along x gives a
// longer stop proportionally more width instead of the same one slot every
// stop got when there was only ever one point per stop. Still "sequential
// eras", not true calendar dates, for any stop that doesn't say otherwise
// — the one known real overlap (SINFO and Instituto de Telecomunicações,
// concurrent for one year) is handled explicitly below via
// `overlapsPreviousStopAtYearIndex` rather than generally solved for.
interface HistoryPoint {
  stopIndex: number;
  focus: Record<string, number>;
}
const points: HistoryPoint[] = [];
stops.forEach((stop, stopIndex) => {
  const yearly = stop.focusByYear ?? [stop.focus];
  yearly.forEach((focus, yearIndex) => {
    // This year already got folded into the previous stop's matching year
    // below (the `next.overlapsPreviousStopAtYearIndex === yearIndex`
    // branch, run while processing that earlier stop) — don't also give it
    // a column of its own.
    if (yearIndex === 0 && stop.overlapsPreviousStopAtYearIndex !== undefined) return;
    points.push({ stopIndex, focus });
    const next = stops[stopIndex + 1];
    if (next?.overlapsPreviousStopAtYearIndex === yearIndex) {
      // The very next stop's first year is this same real calendar year
      // (Rodrigo ran both at once) — merge it into the point just pushed
      // instead of letting it start its own column. A plain average: there's
      // no record of exactly how time actually split between the two that
      // year, and this is a rare, one-year edge case, not something worth
      // asking for a precise split over.
      const theirFirstYear = (next.focusByYear ?? [next.focus])[0];
      const merged: Record<string, number> = {};
      new Set([...Object.keys(focus), ...Object.keys(theirFirstYear)]).forEach((key) => {
        merged[key] = ((focus[key] ?? 0) + (theirFirstYear[key] ?? 0)) / 2;
      });
      points[points.length - 1].focus = merged;
    }
  });
});

// A 0–100 coordinate space either axis of the SVG can be read as: x is
// "how far through the flattened year-points list" (evenly spaced) and y is
// "percent of that point's year". PLOT_* insets leave room for the
// 0/25/50/75/100 gridline labels (left) and a little breathing room
// (right/top) without the plotted points ever touching the chart's own
// edge. `PLOT_Y1` in particular is kept close to `VIEW_HEIGHT` rather than
// symmetric with `PLOT_Y0`: the 0% line sits right above the x-axis row
// (the stop logos/periods) below this SVG, and a wide gap there read as
// dead space between two things that are actually describing the same
// x-position, not real breathing room the way the top margin is. What's
// left is just enough that the 0%-line band's own stroke doesn't get
// clipped by the viewBox edge.
const VIEW_WIDTH = 100;
const VIEW_HEIGHT = 45;
const PLOT_X0 = 8;
const PLOT_X1 = 96;
const PLOT_Y0 = 4;
const PLOT_Y1 = 44;

function xFor(i: number) {
  return points.length <= 1 ? (PLOT_X0 + PLOT_X1) / 2 : PLOT_X0 + (i / (points.length - 1)) * (PLOT_X1 - PLOT_X0);
}
function yFor(value: number) {
  return PLOT_Y1 - (value / 100) * (PLOT_Y1 - PLOT_Y0);
}

// How many of `points` a stop actually owns a column of — its own
// `focusByYear` length, minus one if its first year got folded into the
// previous stop's segment instead (see `overlapsPreviousStopAtYearIndex`).
// Instituto de Telecomunicações' 2 years read as owning only 1 column here;
// its other one is inside SINFO's segment, at the shared point.
function pointsOwnedBy(stop: HistoryStop): number {
  const yearly = stop.focusByYear ?? [stop.focus];
  return yearly.length - (stop.overlapsPreviousStopAtYearIndex !== undefined ? 1 : 0);
}

// The x-axis is a row of contiguous segments, one per stop, tiling
// [PLOT_X0, PLOT_X1] edge to edge — not one floating tick per stop like
// before `focusByYear` existed. With every stop now contributing a
// different number of points, a fixed-width tick centered on a single x
// stopped meaning anything: nothing tied a tick's own width to the span it
// labeled, so a 4-point stop and a 2-point stop looked identical on the
// axis despite the chart above them being visibly different widths. A
// segment's `widthPct` instead comes straight from how many points it
// owns, so the axis and the chart agree: IBM's segment reads wider because
// IBM has more points, not because of leftover space. Each segment's own
// half-step of padding goes to whichever stop is next to the boundary
// (split evenly), except the two outer edges, which land exactly on
// PLOT_X0/PLOT_X1 since there's no neighbor to split with there.
const step = points.length > 1 ? (PLOT_X1 - PLOT_X0) / (points.length - 1) : 0;
let pointCursor = 0;
const segments = stops.map((stop, stopIndex) => {
  const count = pointsOwnedBy(stop);
  const firstIdx = pointCursor;
  const lastIdx = pointCursor + count - 1;
  pointCursor += count;
  const left = stopIndex === 0 ? PLOT_X0 : xFor(firstIdx) - step / 2;
  const right = stopIndex === stops.length - 1 ? PLOT_X1 : xFor(lastIdx) + step / 2;
  return { stop, left, right, widthPct: right - left };
});
// Where one stop's segment ends and the next begins — drawn as a subtle
// vertical divider through the chart body itself (not just the axis row
// below it), so a boundary between two eras reads as a boundary wherever
// you're looking, not just at the labels.
const segmentBoundaries = segments.slice(1).map((seg) => seg.left);

// Which point-to-point edges are a real career-stop change, as opposed to
// a same-stop year-to-year edge (or the merged SINFO/IT point above, which
// keeps SINFO's own `stopIndex` and so reads as same-stop too, deliberately
// — see `overlapsPreviousStopAtYearIndex`). A stop's own progression really
// did happen gradually, one year informing the next; starting a new job
// didn't, it began on day one already at whatever mix that role actually
// was. So the chart draws the former as a plain line between two points,
// and the latter (below, `withOrgSteps`) as a hard step exactly on the
// dashed boundary line, instead of one smooth diagonal implying a job
// gradually turned into a different one.
const stepIndices = new Set<number>();
for (let i = 1; i < points.length; i++) {
  if (points[i].stopIndex !== points[i - 1].stopIndex) stepIndices.add(i);
}

// Replaces the straight line into a `stepIndices` boundary with three
// points instead of one: hold the previous value flat up to the boundary
// (its x is exactly halfway between the two real points either side of
// it, same x the dashed divider line above is drawn at), jump straight to
// the new value, then continue flat until the next real point takes over.
// Applied to both a band's top and base edge so the whole stack steps
// together, not just its outline.
function withOrgSteps(vertices: { x: number; y: number }[]): [number, number][] {
  const path: [number, number][] = [];
  vertices.forEach((v, i) => {
    if (i > 0 && stepIndices.has(i)) {
      const prev = vertices[i - 1];
      const boundaryX = (prev.x + v.x) / 2;
      path.push([boundaryX, prev.y]);
      path.push([boundaryX, v.y]);
    }
    path.push([v.x, v.y]);
  });
  return path;
}

// Stacking order, bottom to top (so top to bottom, reading down from 100%,
// it's Project Managing, Product Design, Sales, Social Media, Data
// Analytics, Data Science, Data Engineering, Software Engineering): the
// hands-on technical categories anchor the bottom of the stack as one
// contiguous group, the people- and business-facing ones sit above as the
// other, so the chart reads as two bands instead of eight interleaved
// colors. A category not listed here (a new one added to site.json later)
// falls back to the end rather than disappearing.
const CATEGORY_ORDER = ['swe', 'de', 'ds', 'analytics', 'social', 'sales', 'design', 'pm'];
function categoryRank(id: string) {
  const i = CATEGORY_ORDER.indexOf(id);
  return i === -1 ? CATEGORY_ORDER.length : i;
}

// Colors themselves live on `focusCategories` in site.json, not here, but
// worth noting why they're not eight arbitrary hues: `analytics`, `de`, and
// `ds` are one emerald family at three depths (lightest to darkest) because
// they're the three data-adjacent skills, related enough that a shared hue
// says so at a glance; everything else (pm, swe, sales, design, social)
// gets its own standalone color so it doesn't read as part of that family.
//
// Each point's focus split sums to 100 (it's "how this year divided up"),
// which is exactly what a 100%-stacked area chart wants: at every x, the
// bands fill the full 0–100 height between them, so a band's thickness *is*
// its percentage — no separate value axis to cross-reference. Skips a
// category that's 0% at every single point first (an invisible sliver of
// stack isn't worth its own legend entry).
const orderedCategories = [...focusCategories].sort((a, b) => categoryRank(a.id) - categoryRank(b.id));
const runningTop = points.map(() => 0);
const bands = orderedCategories
  .map((cat) => {
    const bandPoints = points.map((point, i) => {
      const value = point.focus[cat.id] ?? 0;
      const base = runningTop[i];
      const top = base + value;
      runningTop[i] = top;
      return { x: xFor(i), baseY: yFor(base), topY: yFor(top), value };
    });
    return { ...cat, points: bandPoints, everUsed: bandPoints.some((p) => p.value > 0) };
  })
  .filter((band) => band.everUsed);

// A second, coarser reading of the same data: the same technical/people-
// business split `CATEGORY_ORDER` already groups the eight categories
// into, just collapsed down to two actual bands instead of eight, for
// whoever wants "how did the *balance* between hands-on and people-facing
// work shift" without the finer-grained detail. Toggled client-side (see
// the script below) rather than a second chart, so it's the same axes,
// same org-boundary steps, same everything except which stacking is drawn.
const GROUPED_CATEGORIES = [
  { id: 'technical', label: ui.careerStop.focusGroupTechnical, color: '#38bdf8', ids: ['swe', 'de', 'ds', 'analytics'] },
  { id: 'peopleBusiness', label: ui.careerStop.focusGroupPeopleBusiness, color: '#f59e0b', ids: ['social', 'sales', 'design', 'pm'] },
];
const runningTopGrouped = points.map(() => 0);
const groupedBands = GROUPED_CATEGORIES.map((group) => {
  const bandPoints = points.map((point, i) => {
    const value = group.ids.reduce((sum, id) => sum + (point.focus[id] ?? 0), 0);
    const base = runningTopGrouped[i];
    const top = base + value;
    runningTopGrouped[i] = top;
    return { x: xFor(i), baseY: yFor(base), topY: yFor(top), value };
  });
  return { id: group.id, label: group.label, color: group.color, points: bandPoints };
});

const gridlineValues = [0, 25, 50, 75, 100];

// Each segment needs a little real room of its own so the narrowest one
// doesn't feel squeezed against its neighbor — same fix as the "Preferred
// Stack" diagram's own overflow (TechStack.astro): work out the width the
// *narrowest* segment actually needs and size the whole chart up from
// there, letting it scroll horizontally below that floor rather than
// squeezing every segment down to illegible to force a fit.
//
// `TICK_MIN_REM` used to be sized to fit a segment's own period text in
// full ("2024 – Present", the longest string across both locales) without
// truncating — but with segments now weighted by point-count (see
// `pointsOwnedBy`), a stop that owns only a small share of the x-axis
// (Instituto de Telecomunicações, down to a single column since its other
// year lives inside SINFO's segment) needs the *whole chart* scaled up by
// however much its own tiny percentage falls short of that floor, which
// blows the chart width up far past what one narrow segment's label
// actually warrants. `TICK_MIN_REM` is sized just for a segment's own
// content instead (the logo chip plus its padding, `pointsOwnedBy`-
// independent) — its period label still truncates gracefully (`w-full
// truncate` below) if a genuinely narrow segment can't fit it, and the
// segment's own `title` always carries the untruncated "Org · period" text
// for a hover or long-press. `CHART_MAX_WIDTH_REM` is a second, hard
// backstop on top of that: however narrow a future segment's share ever
// gets, the chart never demands more than this to read comfortably inside
// the dialog without scrolling.
const TICK_MIN_REM = 2.5;
const CHART_MAX_WIDTH_REM = 40;
const AXIS_LABEL_COL_REM = 2.5; // the percent column (`w-8`) plus the `gap-2` beside it
const minSegmentWidthPct = Math.min(...segments.map((seg) => seg.widthPct));
const chartMinWidthRem = Math.min(CHART_MAX_WIDTH_REM, AXIS_LABEL_COL_REM + (TICK_MIN_REM * VIEW_WIDTH) / minSegmentWidthPct);
---

<dialog
  id="focus-history-chart"
  class="mx-3 mb-0 mt-auto h-fit max-h-[94svh] w-[calc(100%-1.5rem)] max-w-none overflow-y-auto rounded-t-2xl border-0 border-t border-[var(--color-border)] bg-[var(--color-surface)] p-0 text-[var(--color-text)] backdrop:bg-black/60 backdrop:backdrop-blur-sm sm:m-auto sm:max-h-[78vh] sm:w-[min(92vw,36rem)] sm:rounded-xl sm:border"
>
  <!-- Bottom sheet on mobile, centered card at sm: and up — see
       CareerStopRow's dialog for the full rationale (mt-auto bottom-anchor,
       the mx-3/w-[calc(...)] side margins, svh over dvh, h-fit over h-auto).
       This one gets its own `overflow-y-auto` (most of this pattern's
       dialogs don't need it, their content already fits the cap) since the
       chart, its x-axis row and the legend together can run past 94svh on a
       short phone in landscape — scrolling the sheet itself beats clipping
       the legend or squeezing the chart down to illegible. -->
  <div class="relative">
    <div data-sheet-handle class="sheet-handle absolute left-1/2 top-2 z-10 h-1.5 w-10 -translate-x-1/2 rounded-full bg-white/40 sm:hidden" aria-hidden="true"></div>
    <div class="p-5 pt-7 sm:pt-5">
      <div class="flex items-start justify-between gap-3">
        <div>
          <h3 class="text-sm font-bold text-[var(--color-text)]">{ui.careerStop.focusHistoryHeading}</h3>
          <p class="mt-0.5 text-[11px] text-[var(--color-muted)]">{ui.careerStop.focusHistorySubtitle}</p>
        </div>
        <div class="flex shrink-0 items-center gap-2">
          <!-- Detailed (all 8 categories) vs. grouped (technical vs.
               people/business, see `GROUPED_CATEGORIES` above) view toggle.
               A segmented pair rather than one label-swapping button so
               both options and which one is active are visible at once,
               not just discoverable by clicking. `data-focus-view` is read
               by the script below (`switchView`), which shows/hides the
               matching `data-mode` polygons and `data-legend-group` legend
               instead of this being two entirely separate charts. -->
          <div class="flex items-center gap-0.5 rounded-full border border-[var(--color-border)] p-0.5 text-[10px]" role="group" aria-label={ui.careerStop.focusViewToggleLabel}>
            <button type="button" data-focus-view="detailed" class="focus-view-btn rounded-full px-2 py-1 font-medium whitespace-nowrap" aria-pressed="true">
              {ui.careerStop.focusViewByCategory}
            </button>
            <button type="button" data-focus-view="grouped" class="focus-view-btn rounded-full px-2 py-1 font-medium whitespace-nowrap" aria-pressed="false">
              {ui.careerStop.focusViewGrouped}
            </button>
          </div>
          <DialogCloseButton label={ui.common.close} shrink />
        </div>
      </div>

      <!-- Scrolls horizontally below `chartMinWidthRem` (see its own comment)
           rather than squeezing every tick down to fit whatever width the
           dialog happens to have — same "widen it, don't shrink the
           content" fix as the Preferred Stack diagram's own overflow. -->
      <div class="mt-4 overflow-x-auto">
      <div class="mx-auto" style={`min-width: ${chartMinWidthRem}rem`}>
        <div class="flex gap-2">
          <!-- Percent axis: a plain fixed-width column, not baked into the
               SVG's own viewBox — keeping it separate means the SVG's
               x=0..100 maps 1:1 to "stop 0..last stop" with no left inset to
               account for elsewhere. Fixed at `w-8` rather than left to size
               itself to its own five short labels, because the x-axis row
               below needs to know that same width up front to line its own
               ticks up with the SVG beside it (`self-stretch`, the flex
               default here, is what makes its height match the SVG's own
               aspect-ratio-driven height rather than just what 5 labels need).

               Each label is positioned with the exact same `yFor(v)` the
               SVG's own gridlines and bands use, not spread evenly with
               flexbox `justify-between` (the previous approach): the plot
               area doesn't fill the SVG's full 0–{VIEW_HEIGHT} height, it
               sits inset within it (`PLOT_Y0`–`PLOT_Y1`, leaving breathing
               room top and bottom) — spreading 5 labels edge-to-edge over
               the *full* height put "100%" above where the chart's own
               100% line actually was and "0%" below its actual 0% line, an
               inch or so off at this chart's size. Percent `top` on an
               absolutely positioned element resolves against this
               container's own height, which the parent flex row's
               `self-stretch` already pins to the SVG's rendered height, so
               this tracks the SVG's plot area exactly, including if
               `PLOT_Y0`/`PLOT_Y1` ever change. -->
          <!-- No separate `relative`: `sticky` already establishes a
               positioned containing block for the absolutely-positioned
               labels below, and stacking `relative` alongside it on the
               same element would fight it over the `position` property. -->
          <div class="sticky left-0 z-10 w-8 shrink-0 bg-[var(--color-surface)] text-right font-mono text-[9px] text-[var(--color-muted)]">
            {gridlineValues.map((v) => (
              <span class="absolute right-0 -translate-y-1/2" style={`top: ${(yFor(v) / VIEW_HEIGHT) * 100}%`}>
                {v}%
              </span>
            ))}
          </div>
          <!-- data-y0/data-y1/data-x/data-series/data-steps hand the script
               below everything it needs to recompute the stack (including
               its org-boundary steps, see `withOrgSteps` above) in a
               different order at runtime (pulling a hovered band to the
               baseline, see that script's own comment) without duplicating
               the yFor/xFor math or the raw per-point values in two places.
               This can't be `define:vars`: the script uses real TS type
               annotations further down, and define:vars forces a script to
               render is:inline (unprocessed, no TS stripping) — same
               constraint already documented in ImageLightbox.astro and
               Organizations.astro for their own scripts. -->
          <svg
            viewBox={`0 0 ${VIEW_WIDTH} ${VIEW_HEIGHT}`}
            preserveAspectRatio="none"
            class="block min-w-0 flex-1"
            style={`aspect-ratio: ${VIEW_WIDTH} / ${VIEW_HEIGHT}; height: auto;`}
            data-y0={PLOT_Y0}
            data-y1={PLOT_Y1}
            data-x={JSON.stringify(bands[0]?.points.map((p) => p.x) ?? [])}
            data-series={JSON.stringify(
              [...bands, ...groupedBands].map((b) => ({ id: b.id, values: b.points.map((p) => p.value) }))
            )}
            data-steps={JSON.stringify([...stepIndices])}
            data-view="detailed"
          >
            {gridlineValues.map((v) => (
              <line x1={PLOT_X0 - 3} x2={VIEW_WIDTH} y1={yFor(v)} y2={yFor(v)} stroke="var(--color-border)" stroke-width="0.3" />
            ))}
            {bands.map((band) => {
              // One closed shape per band: its top edge left to right, then
              // its base edge back right to left, which is what turns "a top
              // line and a base line" into one fillable polygon rather than
              // two open ones. No per-point markers beyond that: the shape
              // itself (its steps at an org boundary, its kinks elsewhere,
              // one per point) is the thing to read, not the points that
              // produced it. `withOrgSteps` inserts the extra vertices for a
              // hard org-change edge; every other edge passes through as a
              // plain point-to-point line, unchanged.
              const top = withOrgSteps(band.points.map((p) => ({ x: p.x, y: p.topY })));
              const base = withOrgSteps(band.points.map((p) => ({ x: p.x, y: p.baseY })))
                .slice()
                .reverse();
              return (
                // `data-tooltip`, not a native `<title>`: a browser's own
                // title tooltip only shows after its own fixed hover delay
                // (close to a second in Chrome), which read as broken for
                // something meant to answer "what am I looking at" right
                // away. The script below shows a custom tooltip on the
                // first `pointermove`, instantly. `data-category` is what
                // the legend hover below matches against to dim every other
                // band; `chart-band` is just a hook for that CSS, it carries
                // no styling of its own.
                <polygon
                  points={[...top, ...base].join(' ')}
                  fill={band.color}
                  fill-opacity="0.82"
                  stroke="var(--color-surface)"
                  stroke-width="0.3"
                  data-tooltip={band.label}
                  data-category={band.id}
                  data-mode="detailed"
                  class="chart-band"
                />
              );
            })}
            {/* The same shapes, collapsed to the two-band technical/people-
                business grouping (see `GROUPED_CATEGORIES` above) — hidden
                by default (CSS keyed off the `<svg>`'s own `data-view`, set
                below) until the header's "Grouped" toggle switches to it.
                Same `withOrgSteps`/polygon-closing approach as the detailed
                bands just above, just over `groupedBands` instead of `bands`. */}
            {groupedBands.map((band) => {
              const top = withOrgSteps(band.points.map((p) => ({ x: p.x, y: p.topY })));
              const base = withOrgSteps(band.points.map((p) => ({ x: p.x, y: p.baseY })))
                .slice()
                .reverse();
              return (
                <polygon
                  points={[...top, ...base].join(' ')}
                  fill={band.color}
                  fill-opacity="0.82"
                  stroke="var(--color-surface)"
                  stroke-width="0.3"
                  data-tooltip={band.label}
                  data-category={band.id}
                  data-mode="grouped"
                  class="chart-band"
                />
              );
            })}
            {/* One era ends, the next begins — echoed as the same dashed
                line through the axis row below (`border-l` on each segment
                but the first), so the boundary reads consistently whether
                you're looking at the shape or the labels under it. */}
            {segmentBoundaries.map((x) => (
              <line x1={x} x2={x} y1={PLOT_Y0} y2={PLOT_Y1} stroke="var(--color-border)" stroke-width="0.3" stroke-dasharray="1,1" />
            ))}
          </svg>
        </div>

        <!-- x-axis: one segment per stop, tiling [PLOT_X0, PLOT_X1] edge to
             edge at `segments[i].widthPct` each (see that variable's own
             comment for why a segment's width has to come from its point
             count now) — a plain flex row can't place that by itself
             (percentage `width`s on flex children need a definite basis
             they'd otherwise share evenly under `flex-1`), so each gets an
             explicit `style="width:…%"` rather than relying on flex to
             divide space up. The two spacer children on either end are the
             small margins PLOT_X0/PLOT_X1 themselves leave (for the
             y-gridline labels and a little breathing room), so this row's
             segments land under the exact same x the chart above draws
             them at.
             absolute position gets for free regardless of label width.

             `ml-[2.5rem]`, not `pl-[2.5rem]`: a percentage `left` on an
             `ml-[2.5rem]` aligns this row's left edge with the SVG's own
             (matching the percent column's `w-8` + `gap-2` beside it), so
             the two spacer children below (widths `PLOT_X0`/`100-PLOT_X1`)
             land the segments between them under the exact same x the
             chart above draws its bands at. -->
        <div class="relative mt-1 ml-[2.5rem]">
          <div class="flex h-9">
            <div style={`width:${PLOT_X0}%`} aria-hidden="true"></div>
            {segments.map((seg, i) => (
              <div
                data-axis-stop={seg.stop.slug}
                title={`${seg.stop.org} · ${seg.stop.period}`}
                class={`axis-segment flex min-w-0 flex-col items-center gap-1 px-1 pt-0.5 transition ${i > 0 ? 'border-l border-[var(--color-border)]' : ''}`}
                style={`width:${seg.widthPct}%`}
              >
                <div class={`flex h-5 w-5 shrink-0 items-center justify-center overflow-hidden rounded p-0.5 ${seg.stop.chipClass}`}>
                  <ScaledLogo
                    src={seg.stop.logo}
                    alt={seg.stop.org}
                    invert={seg.stop.logoInvert}
                    scale={seg.stop.tickLogoScale ?? seg.stop.logoScale}
                  />
                </div>
                <!-- No org name spelled out here — the logo above is
                     already the company, and the timeline elsewhere on the
                     page (and the `title` above, for a hover or a
                     long-press) already carries the name in full for
                     whoever needs it. Just the period underneath, so a
                     segment still says *which* era. `w-full truncate` in
                     case a locale's own period string ever outgrows even
                     the narrowest segment (Instituto de Telecomunicações,
                     down to a single owned column) at the narrowest phone
                     width — it never has yet. Its own tick still shows its
                     full "2018 – 2020" period even though only 2019/2020
                     gets a column of its own here; 2018 is the shared point
                     inside SINFO's segment instead (see
                     `overlapsPreviousStopAtYearIndex`). -->
                <span class="w-full truncate text-center text-[8px] leading-tight text-[var(--color-muted)]">{seg.stop.period}</span>
              </div>
            ))}
            <div style={`width:${100 - PLOT_X1}%`} aria-hidden="true"></div>
          </div>
        </div>
      </div>
      </div>

      <!-- Same order as the stack itself (technical group first, then the
           people/business one), so "why is this one at the bottom" has an
           answer right below it. `data-legend-category` is read by the
           script below, which supports picking more than one at once (see
           its own comment): hovering previews one, clicking toggles it on
           persistently, and any number can be clicked at the same time.
           `legend-swatch`/`legend-label` are hooks for that script's CSS
           (the `:hover` state and the `is-clicked` class it toggles),
           not styled directly here. `data-legend-group` is what the view
           toggle above shows/hides between (only one group is ever visible
           at once; the other stays in the DOM, just `hidden`). -->
      <div data-legend-group="detailed" class="mt-2 flex flex-wrap gap-x-3 gap-y-1 border-t border-[var(--color-border)] pt-3">
        {bands.map((band) => (
          <div class="legend-item flex items-center gap-1.5" data-legend-category={band.id}>
            <span class="legend-swatch h-1.5 w-1.5 shrink-0 rounded-sm" style={`background-color:${band.color};`} />
            <span class="legend-label text-[10px] text-[var(--color-muted)]">{band.label}</span>
          </div>
        ))}
      </div>
      <!-- Grouped view's own 2-item legend, same markup/classes as the
           detailed one above so it picks up the same hover/click styling —
           starts `hidden`, since the chart itself opens in detailed mode. -->
      <div data-legend-group="grouped" class="mt-2 flex flex-wrap gap-x-3 gap-y-1 border-t border-[var(--color-border)] pt-3" hidden>
        {groupedBands.map((band) => (
          <div class="legend-item flex items-center gap-1.5" data-legend-category={band.id}>
            <span class="legend-swatch h-1.5 w-1.5 shrink-0 rounded-sm" style={`background-color:${band.color};`} />
            <span class="legend-label text-[10px] text-[var(--color-muted)]">{band.label}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Follows the pointer over the chart above, filled in by the script
         below — see the `data-tooltip` comment on the polygons/circles for
         why this exists instead of just a native `<title>` on each. -->
    <div
      data-chart-tooltip
      hidden
      class="pointer-events-none fixed z-50 -translate-x-1/2 -translate-y-[calc(100%+0.5rem)] whitespace-nowrap rounded-md border border-[var(--color-border)] bg-[var(--color-bg)] px-2 py-1 text-[11px] text-[var(--color-text)] shadow-lg"
    ></div>
  </div>
</dialog>

<style>
  /* The segment for whichever stop the chart was opened from — set via
     [data-open-focus-chart] below, cleared whenever the dialog isn't
     showing that stop's segment highlighted. Plain CSS class rather than an
     inline style so it can be toggled with one classList call per open. */
  .axis-segment.is-current {
    background: color-mix(in srgb, var(--color-accent) 15%, transparent);
    box-shadow: 0 0 0 1px var(--color-accent);
  }
  .axis-segment.is-current span {
    color: var(--color-accent);
  }

  /* Only one of the two view modes' polygons is ever visible — driven by
     `data-view` on the `<svg>` itself (toggled by `switchView` in the
     script below), not a `hidden` attribute on each polygon: `hidden`'s
     IDL property is defined on `HTMLElement`, and while modern browsers
     also expose it on `SVGElement` through the shared mixin this file
     already relies on for `.dataset` on each polygon, a plain CSS
     attribute selector needs no such assumption either way. */
  svg[data-view='detailed'] .chart-band[data-mode='grouped'],
  svg[data-view='grouped'] .chart-band[data-mode='detailed'] {
    display: none;
  }

  /* Legend hover/click -> chart highlight (see the script below): dim
     every band except whichever ones are active (clicked, or previewed by
     a hover), and nudge those to full opacity so they visibly lift off
     the rest instead of just leaving everyone else alone. */
  .chart-band {
    transition: opacity 150ms ease;
  }
  .chart-band.is-dimmed {
    opacity: 0.15;
  }
  .chart-band.is-highlighted {
    fill-opacity: 1;
  }
  /* Legend items are genuinely clickable now (toggle a category on/off,
     any number at once), so the pointer should say so. */
  .legend-item {
    cursor: pointer;
  }
  /* Hover feedback lives in plain CSS, not the script's JS state: it's
     purely about *this* legend item, doesn't need to survive the pointer
     leaving, and this way it can never drift out of sync with the
     pointer's real position. `is-clicked` (below) is the persistent
     counterpart, toggled by the script since it has to survive the
     pointer leaving entirely. */
  .legend-item:hover .legend-label {
    color: var(--color-text);
  }
  /* A clicked-on category reads as "on" even with the pointer nowhere
     near it: a ring around its swatch (echoing the swatch's own shape
     rather than adding new iconography) plus the same brightened label
     `:hover` above uses, so a category looks the same whether it's
     currently being hovered or was clicked earlier and just sits there. */
  .legend-item.is-clicked .legend-swatch {
    box-shadow: 0 0 0 2px var(--color-text);
  }
  .legend-item.is-clicked .legend-label {
    color: var(--color-text);
    font-weight: 600;
  }

  /* Detailed/grouped view toggle: the inactive option reads as a plain
     muted label (same treatment idle nav links get elsewhere on the
     page), the active one gets a filled pill so which mode is showing is
     obvious without reading either label. */
  .focus-view-btn {
    color: var(--color-muted);
    cursor: pointer;
    transition:
      background-color 150ms ease,
      color 150ms ease;
  }
  .focus-view-btn[aria-pressed='true'] {
    background: var(--color-accent);
    color: var(--color-bg);
  }
</style>

<script>
  // Delegated so it doesn't matter how many `[data-open-focus-chart]`
  // buttons exist across however many career stops render on the page —
  // one listener here, rather than each CareerStopRow wiring its own copy
  // of "open the (single, shared) chart dialog".
  document.addEventListener('click', (e) => {
    const trigger = (e.target as HTMLElement).closest<HTMLElement>('[data-open-focus-chart]');
    if (!trigger) return;
    const dialog = document.getElementById('focus-history-chart');
    if (!(dialog instanceof HTMLDialogElement)) return;

    const slug = trigger.dataset.openFocusChart;
    const current = slug ? dialog.querySelector<HTMLElement>(`[data-axis-stop="${slug}"]`) : null;
    dialog.querySelectorAll<HTMLElement>('[data-axis-stop]').forEach((tick) => {
      tick.classList.toggle('is-current', tick === current);
    });
    dialog.showModal();
    // The chart can be wider than the dialog (see `chartMinWidthRem`) and
    // scrolls horizontally — without this, opening the chart from a stop
    // near the right edge (Klarna, say) shows its own highlighted tick only
    // after the visitor thinks to scroll for it.
    current?.scrollIntoView({ block: 'nearest', inline: 'center' });
  });

  // Instant tooltip for the chart's own `[data-tooltip]` shapes (see the
  // comment on the polygons/circles) — a native `<title>` was the first
  // attempt, but its browser-default hover delay (close to a second in
  // Chrome) read as broken for something meant to say "what's this" right
  // away. `pointermove`, not `mouseenter`, on the SVG itself: a chart this
  // densely packed has bands right up against each other, so the pointer
  // crosses from one shape straight into the next without the SVG element
  // itself ever firing its own leave/enter pair, only the shape under the
  // cursor changing — recomputing which shape that is on every move is what
  // catches that, `mouseenter` alone would leave the tooltip stuck showing
  // whichever band the pointer first landed on.
  const chart = document.getElementById('focus-history-chart');
  const tooltip = chart?.querySelector<HTMLElement>('[data-chart-tooltip]');
  const svg = chart?.querySelector('svg');

  function showTooltip(text: string, clientX: number, clientY: number) {
    if (!tooltip) return;
    tooltip.textContent = text;
    tooltip.hidden = false;
    tooltip.style.left = `${clientX}px`;
    tooltip.style.top = `${clientY}px`;
  }
  function hideTooltip() {
    if (tooltip) tooltip.hidden = true;
  }

  svg?.addEventListener('pointermove', (e) => {
    const target = (e.target as Element | null)?.closest<SVGElement>('[data-tooltip]');
    if (!target) {
      hideTooltip();
      return;
    }
    showTooltip(target.dataset.tooltip ?? '', e.clientX, e.clientY);
  });
  svg?.addEventListener('pointerleave', hideTooltip);
  // A tap on a touchscreen fires its own pointer events with real
  // coordinates, so the tooltip already works there too — this just makes
  // sure it doesn't linger once the finger lifts, since there's no
  // pointerleave equivalent for a tap.
  svg?.addEventListener('pointerup', (e) => {
    if (e.pointerType === 'touch') setTimeout(hideTooltip, 1200);
  });
  chart?.addEventListener('close', hideTooltip);

  // Legend hover/click -> dim every `.chart-band` except whichever ones are
  // active, *and* pull the active ones down to the baseline (base 0%) by
  // re-stacking the whole chart with them first in the order. A band
  // buried in the middle of an eight-way stack has a wavy top *and* a wavy
  // base, both shaped by whatever's below it. Only its thickness is
  // actually "its" data; sitting it on the baseline instead makes its own
  // top edge the only wavy line left, so its real shape (not everyone
  // else's) is what you're reading. Everything inactive keeps its existing
  // relative order, just shifted up to make room.
  //
  // Two ways a category becomes active, and they compose:
  // - Clicking toggles it in `clickedCategories` persistently (survives
  //   the pointer leaving, for reading with the mouse off to the side, or
  //   on a touch device with no hover at all) — reclicking the same one
  //   removes it, clicking a different one *adds* it rather than
  //   replacing the click, so any number can be clicked on at once (all
  //   three data-adjacent categories together, say).
  // - Hovering previews one more on top of whatever's already clicked,
  //   for as long as the pointer stays over that legend item; it's not
  //   added to `clickedCategories` and disappears the moment the pointer
  //   leaves, unless a click had already put it there too. It's always
  //   last in the stacking order among the active set (`currentOrder`
  //   below appends it after every clicked one), so it visibly sits above
  //   the clicked categories rather than wherever it'd otherwise land.
  // Closing the dialog always clears both; reopening it should never
  // surprise anyone with yesterday's selection still active.
  interface CategorySeries {
    id: string;
    values: number[];
  }
  const seriesById: Record<string, number[]> = {};
  let xs: number[] = [];
  let plotY0 = 0;
  let plotY1 = 0;
  let stepIndices = new Set<number>();
  try {
    (JSON.parse(svg?.dataset.series ?? '[]') as CategorySeries[]).forEach((s) => {
      seriesById[s.id] = s.values;
    });
    xs = JSON.parse(svg?.dataset.x ?? '[]') as number[];
    plotY0 = Number(svg?.dataset.y0 ?? 0);
    plotY1 = Number(svg?.dataset.y1 ?? 0);
    stepIndices = new Set(JSON.parse(svg?.dataset.steps ?? '[]') as number[]);
  } catch {
    // Malformed data-* JSON would only happen from a hand-edited DOM; fail
    // quiet and leave the chart in its server-rendered (unreorderable, but
    // still correct) layout rather than throwing across the rest of the page.
  }
  function yFor(value: number) {
    return plotY1 - (value / 100) * (plotY1 - plotY0);
  }
  // Same shape as `withOrgSteps` in the frontmatter above (see its own
  // comment): flat up to a hard org-change boundary, a vertical jump right
  // on it, flat again from there to the next real point. Kept in sync with
  // that copy by construction, not just convention — both read the same
  // `stepIndices` this script parsed from `data-steps`, computed once,
  // server-side, from the same `points` list that produced everything else
  // here.
  function withOrgSteps(vertices: [number, number][]): [number, number][] {
    const path: [number, number][] = [];
    vertices.forEach(([x, y], i) => {
      if (i > 0 && stepIndices.has(i)) {
        const [prevX, prevY] = vertices[i - 1];
        const boundaryX = (prevX + x) / 2;
        path.push([boundaryX, prevY]);
        path.push([boundaryX, y]);
      }
      path.push([x, y]);
    });
    return path;
  }

  // Two independent sets of bands sharing one `<svg>` (detailed: all eight
  // categories; grouped: the two-band technical/people-business collapse,
  // see `GROUPED_CATEGORIES` in the frontmatter above) — only one is ever
  // visible at a time (CSS keyed off the `<svg>`'s own `data-view`, see
  // `switchView` below), but both stay in the DOM so switching between
  // them is just a visibility flip, not a re-render.
  type ViewMode = 'detailed' | 'grouped';
  const detailedBandEls = [...(chart?.querySelectorAll<SVGPolygonElement>('.chart-band[data-mode="detailed"]') ?? [])];
  const groupedBandEls = [...(chart?.querySelectorAll<SVGPolygonElement>('.chart-band[data-mode="grouped"]') ?? [])];
  function bandElsFor(mode: ViewMode): SVGPolygonElement[] {
    return mode === 'detailed' ? detailedBandEls : groupedBandEls;
  }
  // The order the server rendered them in, read back off the DOM rather
  // than re-deriving CATEGORY_ORDER/GROUPED_CATEGORIES here, so this script
  // never has to be kept in sync with those arrays by hand.
  const detailedDefaultOrder = detailedBandEls.map((el) => el.dataset.category ?? '').filter(Boolean);
  const groupedDefaultOrder = groupedBandEls.map((el) => el.dataset.category ?? '').filter(Boolean);
  function defaultOrderFor(mode: ViewMode): string[] {
    return mode === 'detailed' ? detailedDefaultOrder : groupedDefaultOrder;
  }

  // One category's points string for a given stacking order: same "top
  // edge left to right, then base edge back right to left" shape the
  // server built, just computed here so it can run again with a different
  // order. Returns every band's string at once since stacking one band
  // depends on the running total of every band already placed under it.
  // Mode-agnostic: `order` is whatever ids should stack together (all
  // eight, or just the two grouped ones), and `seriesById` (below) already
  // holds both sets under their own ids.
  function computeBandPoints(order: string[]): Record<string, string> {
    const runningTop = xs.map(() => 0);
    const result: Record<string, string> = {};
    order.forEach((id) => {
      const values = seriesById[id];
      if (!values) return;
      const topRaw: [number, number][] = [];
      const baseRaw: [number, number][] = [];
      values.forEach((value, i) => {
        const from = runningTop[i];
        const to = from + value;
        runningTop[i] = to;
        topRaw.push([xs[i], yFor(to)]);
        baseRaw.push([xs[i], yFor(from)]);
      });
      const top = withOrgSteps(topRaw);
      const base = withOrgSteps(baseRaw).slice().reverse();
      result[id] = [...top, ...base].join(' ');
    });
    return result;
  }
  const detailedDefaultPoints = computeBandPoints(detailedDefaultOrder);
  const groupedDefaultPoints = computeBandPoints(groupedDefaultOrder);
  function defaultPointsFor(mode: ViewMode): Record<string, string> {
    return mode === 'detailed' ? detailedDefaultPoints : groupedDefaultPoints;
  }

  function parsePoints(str: string): number[][] {
    return str
      .trim()
      .split(' ')
      .map((pair) => pair.split(',').map(Number));
  }

  const REDUCED_MOTION = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let animationFrame: number | null = null;
  // Interpolates every band's polygon from wherever it currently is to its
  // points in `target` — x never changes between stacking orders (only
  // which category owns which vertical slice does), so this only has to
  // ease each vertex's y, not solve a general shape-morph. `els` is
  // whichever mode's bands are being animated (detailed or grouped, never
  // both at once — the other mode's bands sit hidden and static until
  // `switchView` brings them back).
  function animateBandsTo(els: SVGPolygonElement[], target: Record<string, string>, durationMs: number) {
    if (animationFrame !== null) cancelAnimationFrame(animationFrame);
    if (REDUCED_MOTION || durationMs === 0) {
      els.forEach((el) => {
        const id = el.dataset.category ?? '';
        if (target[id]) el.setAttribute('points', target[id]);
      });
      return;
    }
    const from: Record<string, number[][]> = {};
    const to: Record<string, number[][]> = {};
    els.forEach((el) => {
      const id = el.dataset.category ?? '';
      if (!target[id]) return;
      from[id] = parsePoints(el.getAttribute('points') ?? '');
      to[id] = parsePoints(target[id]);
    });
    const start = performance.now();
    const step = (now: number) => {
      const t = Math.min(1, (now - start) / durationMs);
      const eased = 1 - (1 - t) ** 3; // ease-out cubic
      els.forEach((el) => {
        const id = el.dataset.category ?? '';
        const a = from[id];
        const b = to[id];
        if (!a || !b || a.length !== b.length) return;
        const points = a.map(([x, y], i) => `${x},${y + (b[i][1] - y) * eased}`).join(' ');
        el.setAttribute('points', points);
      });
      animationFrame = t < 1 ? requestAnimationFrame(step) : null;
    };
    animationFrame = requestAnimationFrame(step);
  }

  // Persistent (survives the pointer leaving) and transient (only while
  // actually hovered) halves of "what's active" — see the big comment
  // above for how they combine. Order matters for both: insertion order
  // for clicks (earliest click sits deepest/first in the active group),
  // and the hovered preview always goes last, appended in `currentOrder`
  // below rather than tracked as part of `clickedCategories` itself.
  let clickedCategories: string[] = [];
  let hoveredCategory: string | null = null;
  // Which of the two views is currently showing — the legend hover/click
  // logic below always acts on *this* mode's bands, never both, since only
  // one is ever visible. Starts, and always resets to, 'detailed': see
  // `switchView`'s own comment for why reopening the dialog shouldn't
  // remember a grouped view from last time either.
  let viewMode: ViewMode = 'detailed';

  function currentOrder(): string[] {
    const order = [...clickedCategories];
    if (hoveredCategory !== null && !order.includes(hoveredCategory)) order.push(hoveredCategory);
    return order;
  }

  function applyActiveState() {
    const active = currentOrder();
    const bandEls = bandElsFor(viewMode);
    bandEls.forEach((band) => {
      const isActive = active.includes(band.dataset.category ?? '');
      band.classList.toggle('is-dimmed', active.length > 0 && !isActive);
      band.classList.toggle('is-highlighted', isActive);
    });
    const defaultOrder = defaultOrderFor(viewMode);
    const order = active.length > 0 ? [...active, ...defaultOrder.filter((id) => !active.includes(id))] : defaultOrder;
    animateBandsTo(bandEls, active.length > 0 ? computeBandPoints(order) : defaultPointsFor(viewMode), 400);
  }

  // Clears whatever's clicked/hovered/highlighted right now, with no
  // animation (used when switching view modes or closing the dialog,
  // never while a mode is actually being looked at) — both modes' bands
  // get cleared together since a stale highlight on the mode you're
  // switching *away* from would otherwise still be sitting there,
  // dimmed/highlighted, the next time you switch back to it.
  function resetActiveState() {
    clickedCategories = [];
    hoveredCategory = null;
    chart?.querySelectorAll('.legend-item.is-clicked').forEach((item) => item.classList.remove('is-clicked'));
    [...detailedBandEls, ...groupedBandEls].forEach((band) => band.classList.remove('is-dimmed', 'is-highlighted'));
  }

  chart?.querySelectorAll<HTMLElement>('[data-legend-category]').forEach((item) => {
    const id = item.dataset.legendCategory ?? '';
    item.addEventListener('pointerenter', () => {
      hoveredCategory = id;
      applyActiveState();
    });
    item.addEventListener('pointerleave', () => {
      hoveredCategory = null;
      applyActiveState();
    });
    item.addEventListener('click', () => {
      const index = clickedCategories.indexOf(id);
      if (index === -1) {
        clickedCategories.push(id);
      } else {
        // Reclicking an already-clicked category turns it back off — the
        // one piece of this that isn't additive.
        clickedCategories.splice(index, 1);
      }
      item.classList.toggle('is-clicked', index === -1);
      applyActiveState();
    });
  });

  // Detailed/grouped toggle (see the header buttons and their own
  // comment): swap which mode's polygons and legend are visible, and snap
  // (not animate — these are two different shapes with a different number
  // of bands entirely, not a reorder of the same ones) both back to their
  // own resting stack. `data-view` on the `<svg>` is what the CSS above
  // actually keys the show/hide off of; the legend groups toggle their own
  // `hidden` directly since they're plain HTML elements.
  const viewToggleButtons = [...(chart?.querySelectorAll<HTMLButtonElement>('[data-focus-view]') ?? [])];
  const detailedLegend = chart?.querySelector<HTMLElement>('[data-legend-group="detailed"]');
  const groupedLegend = chart?.querySelector<HTMLElement>('[data-legend-group="grouped"]');

  function switchView(mode: ViewMode) {
    if (mode === viewMode) return;
    resetActiveState();
    viewMode = mode;
    viewToggleButtons.forEach((btn) => btn.setAttribute('aria-pressed', String(btn.dataset.focusView === mode)));
    if (detailedLegend) detailedLegend.hidden = mode !== 'detailed';
    if (groupedLegend) groupedLegend.hidden = mode !== 'grouped';
    svg?.setAttribute('data-view', mode);
    animateBandsTo(bandElsFor(mode), defaultPointsFor(mode), 0);
  }

  viewToggleButtons.forEach((btn) => {
    btn.addEventListener('click', () => switchView(btn.dataset.focusView === 'grouped' ? 'grouped' : 'detailed'));
  });

  // Snap back to nothing clicked/hovered, and back to the detailed view,
  // the instant the dialog closes (no animation: it's already invisible)
  // so reopening it later never shows yesterday's selection or grouping
  // still active. Written out directly rather than calling `switchView`
  // (which no-ops if already in detailed mode) since this has to run
  // unconditionally regardless of whichever mode was active when closed.
  chart?.addEventListener('close', () => {
    resetActiveState();
    viewMode = 'detailed';
    viewToggleButtons.forEach((btn) => btn.setAttribute('aria-pressed', String(btn.dataset.focusView === 'detailed')));
    if (detailedLegend) detailedLegend.hidden = false;
    if (groupedLegend) groupedLegend.hidden = true;
    svg?.setAttribute('data-view', 'detailed');
    animateBandsTo(detailedBandEls, detailedDefaultPoints, 0);
  });
</script>
