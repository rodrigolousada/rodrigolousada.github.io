---
import { getSite, type Locale } from '../data/site';
import { getUI } from '../data/ui';
import PhoneMockup, { type HandoffStep } from './PhoneMockup.astro';
import IntentFlow, { type FlowStep, type FlowIntent } from './IntentFlow.astro';
import TechPill from './TechPill.astro';
import { icons } from '../data/icons';
import { slugify } from '../data/slug';

interface Company {
  name: string;
  logo: string;
  logoScale?: number;
  logoInvert?: boolean;
  chipClass: string;
  /** True for a logo that's already a full-bleed square mark (app icon style) — skip the inner padding so it fills the chip instead of floating in a margin. */
  logoFill?: boolean;
}

interface NewsItem {
  title: string;
  source: string;
  date: string;
  url: string;
}

interface Props {
  locale: Locale;
  project: {
    name: string;
    /** Short label used in the cross-link jump balloon (e.g. "PFM" for "Personal Finance Manager (MVP)"). */
    shortName?: string;
    companies?: string[];
    isSideProject?: boolean;
    /** True for work that can only be described at a high level (NDA, internal-only, etc). */
    confidential?: boolean;
    /** True while the project isn't ready to show yet (not ready to announce, or the copy needs another pass). Renders the row blurred with a "Coming soon" badge; clicking it shakes and flashes red (see the `[data-locked]` listener in Projects.astro) instead of opening a modal. The detail view (description, achievements, demo) is left out of the page entirely rather than just hidden client-side. */
    hidden?: boolean;
    tldr: string;
    description: string;
    /** Rodrigo's specific role on this project, when it differs from (or grew within) the stop-level title. */
    myRole?: string;
    technologies: string[];
    achievements: string[];
    demo?: {
      mode?: string;
      captions?: string[];
      videos?: (string | null)[];
      steps?: HandoffStep[];
      /** mode="flow" only — a call-routing diagram (see IntentFlow.astro). */
      intake?: FlowStep[];
      router?: FlowStep;
      intents?: FlowIntent[];
      fallback?: FlowStep;
      note?: string;
    };
    /** A static figure shown in the detail view (a diagram, a screenshot) — separate from the interactive `demo` mockup. Click-to-enlarge (ImageLightbox.astro) is automatic. */
    image?: {
      src: string;
      alt: string;
      caption?: string;
      /** Set for a transparent-background diagram whose dark text needs a light backing to stay legible — most images (photos, posters) already have their own opaque background and look wrong boxed in white. */
      background?: 'light';
    };
    news?: NewsItem[];
    /** External link to the project itself (thesis PDF, publication, live app, etc.). */
    url?: string;
    urlLabel?: string;
    /** "paper" renders `url` as a news-clipping-style card instead of a plain link. */
    urlStyle?: string;
    /** Source label shown on the paper-clipping card (e.g. "IST Thesis"). */
    urlSource?: string;
  };
  modalId: string;
  /** The owning career stop's own slug (CareerStopRow.astro's `stop.slug`) — combined with this
   * project's own slugified name to build a globally unique `?p=` deep-link key. Omitted for a
   * side project, which uses the `side.` prefix instead (see GameCartridge.astro). */
  stopSlug?: string;
}

const { project, modalId, locale, stopSlug } = Astro.props;
const companyMap = getSite(locale).companies as unknown as Record<string, Company>;
const badgeCompanies = (project.companies ?? []).map((id) => companyMap[id]);
const newsItems = project.news ?? [];
const ui = getUI(locale);
const shareKey = project.hidden
  ? undefined
  : `${stopSlug ?? 'side'}.${slugify(project.shortName ?? project.name)}`;

// Region-qualified, not just the bare locale code: 'pt' alone leaves the
// specific dialect (Brazilian vs. European) up to the runtime's default,
// which isn't guaranteed to match the site's own Portuguese (Portugal).
const dateLocale = locale === 'pt' ? 'pt-PT' : 'en-US';
function formatNewsDate(date: string) {
  return new Date(date).toLocaleDateString(dateLocale, { month: 'short', day: 'numeric', year: 'numeric' });
}
---

<div class="relative">
  <button
    type="button"
    onclick={project.hidden ? undefined : `document.getElementById('${modalId}').showModal()`}
    data-locked={project.hidden ? 'true' : undefined}
    aria-disabled={project.hidden ? 'true' : undefined}
    data-modal-id={modalId}
    data-project-companies={(project.companies ?? []).join(' ')}
    data-project-name={project.shortName ?? project.name}
    data-deep-link-target={shareKey}
    class={`group flex w-full items-center gap-3 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)] p-3 text-left transition ${project.hidden ? 'hover:border-red-500/60' : 'hover:border-[var(--color-accent)]'}`}
  >
    <div class={`flex min-w-0 flex-1 items-center gap-3 ${project.hidden ? 'select-none blur-[3px]' : ''}`}>
      <div class="flex shrink-0 items-center -space-x-2">
        {
          project.isSideProject ? (
            <span class="rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] px-2 py-1 font-mono text-[10px] uppercase tracking-wide text-[var(--color-muted)]">
              {ui.project.sideProject}
            </span>
          ) : (
            badgeCompanies.map((c) => (
              <span class={`flex h-7 w-7 items-center justify-center overflow-hidden rounded-full border-2 border-[var(--color-bg)] ${c.logoFill ? '' : 'p-1'} ${c.chipClass}`}>
                <img
                  src={c.logo}
                  alt={c.name}
                  class={`h-full w-full object-contain ${c.logoInvert ? 'brightness-0 invert' : ''}`}
                  style={c.logoScale ? `transform: scale(${c.logoScale})` : undefined}
                />
              </span>
            ))
          )
        }
      </div>

      <div class="min-w-0 flex-1">
        <p class="truncate text-sm font-semibold text-[var(--color-text)]">{project.name}</p>
        <p class="truncate text-xs text-[var(--color-muted)]">{project.tldr}</p>
      </div>
    </div>

    {project.hidden ? (
      <span class="flex shrink-0 items-center gap-1.5 rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] px-2.5 py-1 font-mono text-[10px] uppercase tracking-wide text-[var(--color-muted)]">
        <svg viewBox="0 0 24 24" class="h-3 w-3 fill-current">
          <path d={icons.lock} />
        </svg>
        {ui.common.comingSoon}
      </span>
    ) : (
      <span class="shrink-0 font-mono text-xs text-[var(--color-muted)] transition group-hover:text-[var(--color-accent)]">
        {ui.common.view}
      </span>
    )}
  </button>

  <!-- A bottom sheet on mobile, a compact centered card at sm: and up — see
       CareerStopRow's dialog for the full rationale (mt-auto bottom-anchor +
       the mx-3/w-[calc(...)] side-margin trick + rounded-t-2xl + the
       [data-sheet-handle] drag-to-dismiss grab bar floating on top of the
       header rather than pushed above it as its own strip, back to the
       original m-auto/92vw-40rem/all-corners centered card at sm:, h-fit
       throughout for shrink-to-content instead of stretch-to-fill,
       max-h-[94svh] (svh, not dvh — see CareerStopRow's dialog for why) to
       leave just a sliver of backdrop rather than a full 15%, and the
       quick-swipe-anywhere dismiss wired up in Layout.astro).
       This one's the concrete case that comment's "stacked" note means:
       it only ever opens from inside a still-open CareerStopRow dialog, so
       swiping it away — from the handle or anywhere else on it — reveals
       that one again underneath, same as tapping "back" below does.

       Not rendered at all when project.hidden — the point of hiding a
       project is that its real copy isn't ready or approved yet, so the
       detail view (description, achievements, demo) shouldn't reach the
       page's HTML even unopened. -->
  {!project.hidden && (
  <dialog
    id={modalId}
    class="mx-3 mb-0 mt-auto h-fit max-h-[94svh] w-[calc(100%-1.5rem)] max-w-none rounded-t-2xl border-0 border-t border-[var(--color-border)] bg-[var(--color-surface)] p-0 text-[var(--color-text)] backdrop:bg-black/60 backdrop:backdrop-blur-sm sm:m-auto sm:max-h-[85vh] sm:w-[min(92vw,40rem)] sm:rounded-xl sm:border"
  >
    <div class="relative overflow-hidden rounded-t-2xl sm:rounded-xl">
      <div data-sheet-handle class="sheet-handle absolute left-1/2 top-2 z-10 h-1.5 w-10 -translate-x-1/2 rounded-full bg-white/40 sm:hidden" aria-hidden="true"></div>
      <div class="relative flex items-center justify-between gap-3 border-b border-[var(--color-border)] bg-[var(--color-bg)] px-6 pt-6 pb-4 sm:pt-4">
        <div class="flex items-center gap-3">
          <!-- This modal only ever opens from inside a career-stop modal
               that's still open underneath it, so closing this one (same
               action as the ✕) reads better labeled as "back" here. -->
          <form method="dialog">
            <button
              aria-label={ui.project.backToCareerStop}
              class="flex h-7 items-center gap-1 rounded-full bg-[var(--color-border)] px-2.5 font-mono text-xs text-[var(--color-text)] transition hover:brightness-125"
            >
              {ui.project.back}
            </button>
          </form>
          {
            project.isSideProject ? (
              <span class="rounded-full border border-[var(--color-border)] px-2 py-1 font-mono text-[10px] uppercase tracking-wide text-[var(--color-muted)]">
                {ui.project.sideProject}
              </span>
            ) : (
              badgeCompanies.map((c) => (
                <span class={`flex h-9 w-9 items-center justify-center overflow-hidden rounded-lg ${c.logoFill ? '' : 'p-1.5'} ${c.chipClass}`}>
                  <img
                    src={c.logo}
                    alt={c.name}
                    class={`h-full w-full object-contain ${c.logoInvert ? 'brightness-0 invert' : ''}`}
                    style={c.logoScale ? `transform: scale(${c.logoScale})` : undefined}
                  />
                </span>
              ))
            )
          }
        </div>
        <div class="flex shrink-0 items-center gap-2">
          {shareKey && (
            <button
              type="button"
              data-share-key={shareKey}
              aria-label={ui.common.shareProject}
              title={ui.common.shareProject}
              class="share-button flex h-7 w-7 items-center justify-center rounded-full bg-[var(--color-border)] text-[var(--color-text)] transition hover:brightness-125"
            >
              <svg viewBox="0 0 20 20" class="share-icon-default h-3.5 w-3.5 fill-current">
                <path d={icons.share} />
              </svg>
              <svg viewBox="0 0 20 20" class="share-icon-check hidden h-3.5 w-3.5 fill-current">
                <path d={icons.check} />
              </svg>
            </button>
          )}
          <form method="dialog">
            <button
              aria-label={ui.common.close}
              class="flex h-7 w-7 items-center justify-center rounded-full bg-[var(--color-border)] text-[var(--color-text)] transition hover:brightness-125"
            >
              ✕
            </button>
          </form>
        </div>
      </div>

      <div class="p-6">
        <div class="flex flex-wrap items-center gap-2">
          <h3 class="text-xl font-bold text-[var(--color-text)]">{project.name}</h3>
          {project.confidential && (
            <span class="flex items-center gap-1 rounded-full border border-[var(--color-border)] bg-[var(--color-bg)] px-2 py-0.5 font-mono text-[10px] uppercase tracking-wide text-[var(--color-muted)]">
              <svg viewBox="0 0 24 24" class="h-3 w-3 fill-current">
                <path d="M12 1a5 5 0 00-5 5v3H6a2 2 0 00-2 2v9a2 2 0 002 2h12a2 2 0 002-2v-9a2 2 0 00-2-2h-1V6a5 5 0 00-5-5zm0 2a3 3 0 013 3v3H9V6a3 3 0 013-3z" />
              </svg>
              {ui.project.confidential}
            </span>
          )}
        </div>
        <p class="mt-1 text-sm text-[var(--color-accent)]">{project.tldr}</p>
        {project.myRole && (
          <p class="mt-2 font-mono text-xs text-[var(--color-muted)]">
            <span class="uppercase tracking-wide text-[var(--color-accent)]">{ui.project.myRole}</span>
            {project.myRole}
          </p>
        )}
        <p class="mt-3 text-[var(--color-muted)]">{project.description}</p>

        {project.url && (
          project.urlStyle === 'paper' ? (
            <a
              href={project.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group/paper mt-4 block w-52 -rotate-1 rounded-[2px] bg-[#f4f1ea] p-3.5 text-neutral-900 shadow-md transition hover:-translate-y-0.5 hover:rotate-0 hover:shadow-lg"
            >
              <div class="flex items-baseline justify-between gap-3 border-b-2 border-neutral-900 pb-1.5">
                <span class="font-serif text-[10px] font-bold uppercase tracking-[0.2em] text-neutral-900">
                  {project.urlSource ?? ui.project.read}
                </span>
              </div>
              <p class="mt-2 font-serif text-sm font-bold italic leading-snug text-neutral-900 group-hover/paper:underline">
                “{project.name}”
              </p>
              <p class="mt-2 font-mono text-[9px] uppercase tracking-wide text-neutral-500">
                {project.urlLabel ?? ui.project.readArrow}
              </p>
            </a>
          ) : (
            <a
              href={project.url}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-3 inline-block text-xs text-[var(--color-accent)] underline underline-offset-4"
            >
              {project.urlLabel ?? ui.project.viewArrow}
            </a>
          )
        )}

        {project.image && (
          <figure
            class={`mt-4 overflow-hidden rounded-lg border border-[var(--color-border)] ${project.image.background === 'light' ? 'bg-white p-3' : 'bg-[var(--color-bg)] p-2'}`}
          >
            <button
              type="button"
              data-lightbox-src={project.image.src}
              data-lightbox-alt={project.image.alt}
              class="block w-full cursor-zoom-in"
            >
              <img src={project.image.src} alt={project.image.alt} class="mx-auto max-h-80 w-auto object-contain" />
            </button>
            {project.image.caption && (
              <figcaption
                class={`mt-2 text-center font-mono text-[10px] uppercase tracking-wide ${project.image.background === 'light' ? 'text-neutral-500' : 'text-[var(--color-muted)]'}`}
              >
                {project.image.caption}
              </figcaption>
            )}
          </figure>
        )}

        {project.demo && (
          <div class="mt-4 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)] py-5">
            {project.demo.mode === 'flow' ? (
              <IntentFlow
                locale={locale}
                intake={project.demo.intake}
                router={project.demo.router}
                intents={project.demo.intents}
                fallback={project.demo.fallback}
                note={project.demo.note}
              />
            ) : (
              <PhoneMockup
                locale={locale}
                mode={project.demo.mode}
                captions={project.demo.captions}
                videos={project.demo.videos}
                steps={project.demo.steps}
              />
            )}
          </div>
        )}

        <p class="mt-4 text-xs font-medium uppercase tracking-wide text-[var(--color-accent)]">{ui.common.technologies}</p>
        <div class="mt-2 flex flex-wrap gap-1.5">
          {project.technologies.map((tech) => (
            <TechPill name={tech} locale={locale} />
          ))}
        </div>

        {project.achievements.length > 0 && (
          <>
            <p class="mt-4 text-xs font-medium uppercase tracking-wide text-[var(--color-accent)]">{ui.common.achievements}</p>
            <ul class="mt-2 space-y-1.5">
              {project.achievements.map((achievement) => (
                <li class="flex gap-2 text-[var(--color-text)]">
                  <span class="text-[var(--color-accent)]">▸</span>
                  <span>{achievement}</span>
                </li>
              ))}
            </ul>
          </>
        )}

        {newsItems.length > 0 && (
          <>
            <p class="mb-2 mt-5 text-xs font-medium uppercase tracking-wide text-[var(--color-accent)]">{ui.project.news}</p>
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
              {newsItems.map((item, ni) => (
                <a
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class={`group/news block rounded-[2px] bg-[#f4f1ea] p-3.5 text-neutral-900 shadow-md transition hover:-translate-y-0.5 hover:rotate-0 hover:shadow-lg ${ni % 2 === 0 ? 'rotate-[-1deg]' : 'rotate-[1deg]'}`}
                >
                  <div class="flex items-baseline justify-between gap-3 border-b-2 border-neutral-900 pb-1.5">
                    <span class="font-serif text-[10px] font-bold uppercase tracking-[0.2em] text-neutral-900">
                      {item.source}
                    </span>
                    <span class="shrink-0 font-mono text-[9px] uppercase tracking-wide text-neutral-500">
                      {formatNewsDate(item.date)}
                    </span>
                  </div>
                  <p class="mt-2 font-serif text-sm font-bold italic leading-snug text-neutral-900 group-hover/news:underline">
                    “{item.title}”
                  </p>
                  <p class="mt-2 font-mono text-[9px] uppercase tracking-wide text-neutral-500">
                    {ui.project.readTheArticle}
                  </p>
                </a>
              ))}
            </div>
          </>
        )}
      </div>
    </div>
  </dialog>
  )}
</div>
