---
import { companies } from '../data/site.json';
import PhoneMockup, { type HandoffStep } from './PhoneMockup.astro';
import TechPill from './TechPill.astro';
import { icons } from '../data/icons';

interface Company {
  name: string;
  logo: string;
  logoScale?: number;
  logoInvert?: boolean;
  chipClass: string;
  /** True for a logo that's already a full-bleed square mark (app icon style) — skip the inner padding so it fills the chip instead of floating in a margin. */
  logoFill?: boolean;
}
const companyMap = companies as unknown as Record<string, Company>;

interface NewsItem {
  title: string;
  source: string;
  date: string;
  url: string;
}

interface Props {
  project: {
    name: string;
    /** Short label used in the cross-link jump balloon (e.g. "PFM" for "Personal Finance Manager (MVP)"). */
    shortName?: string;
    companies?: string[];
    isSideProject?: boolean;
    /** True for work that can only be described at a high level (NDA, internal-only, etc). */
    confidential?: boolean;
    /** True while the project isn't ready to show yet (not ready to announce, or the copy needs another pass). Renders the row blurred with a lock + "Coming soon" badge and no modal — the detail view (description, achievements, demo) is left out of the page entirely rather than just hidden client-side. */
    hidden?: boolean;
    tldr: string;
    description: string;
    /** Rodrigo's specific role on this project, when it differs from (or grew within) the stop-level title. */
    myRole?: string;
    technologies: string[];
    achievements: string[];
    demo?: { mode?: string; captions?: string[]; videos?: (string | null)[]; steps?: HandoffStep[] };
    news?: NewsItem[];
    /** External link to the project itself (thesis PDF, publication, live app, etc.). */
    url?: string;
    urlLabel?: string;
    /** "paper" renders `url` as a news-clipping-style card instead of a plain link. */
    urlStyle?: string;
    /** Source label shown on the paper-clipping card (e.g. "IST Thesis"). */
    urlSource?: string;
  };
  modalId: string;
}

const { project, modalId } = Astro.props;
const badgeCompanies = (project.companies ?? []).map((id) => companyMap[id]);
const newsItems = project.news ?? [];

function formatNewsDate(date: string) {
  return new Date(date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}
---

<div class="relative">
  <button
    type="button"
    onclick={project.hidden ? undefined : `document.getElementById('${modalId}').showModal()`}
    disabled={project.hidden}
    data-modal-id={modalId}
    data-project-companies={(project.companies ?? []).join(' ')}
    data-project-name={project.shortName ?? project.name}
    class={`group flex w-full items-center gap-3 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)] p-3 text-left transition ${project.hidden ? 'cursor-default' : 'hover:border-[var(--color-accent)]'}`}
  >
    <div class={`flex min-w-0 flex-1 items-center gap-3 ${project.hidden ? 'select-none blur-[3px]' : ''}`}>
      <div class="flex shrink-0 items-center -space-x-2">
        {
          project.isSideProject ? (
            <span class="rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] px-2 py-1 font-mono text-[10px] uppercase tracking-wide text-[var(--color-muted)]">
              Side project
            </span>
          ) : (
            badgeCompanies.map((c) => (
              <span class={`flex h-7 w-7 items-center justify-center overflow-hidden rounded-full border-2 border-[var(--color-bg)] ${c.logoFill ? '' : 'p-1'} ${c.chipClass}`}>
                <img
                  src={c.logo}
                  alt={c.name}
                  class={`h-full w-full object-contain ${c.logoInvert ? 'brightness-0 invert' : ''}`}
                  style={c.logoScale ? `transform: scale(${c.logoScale})` : undefined}
                />
              </span>
            ))
          )
        }
      </div>

      <div class="min-w-0 flex-1">
        <p class="truncate text-sm font-semibold text-[var(--color-text)]">{project.name}</p>
        <p class="truncate text-xs text-[var(--color-muted)]">{project.tldr}</p>
      </div>
    </div>

    {project.hidden ? (
      <span class="flex shrink-0 items-center gap-1.5 rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] px-2.5 py-1 font-mono text-[10px] uppercase tracking-wide text-[var(--color-muted)]">
        <svg viewBox="0 0 24 24" class="h-3 w-3 fill-current">
          <path d={icons.lock} />
        </svg>
        Coming soon
      </span>
    ) : (
      <span class="shrink-0 font-mono text-xs text-[var(--color-muted)] transition group-hover:text-[var(--color-accent)]">
        View →
      </span>
    )}
  </button>

  <!-- sm:max-h-[85vh], not left uncapped: see CareerStopRow's dialog for why,
       same near-100vh-on-desktop issue for any project with enough content
       (news clippings, long achievement lists) to need it.

       sm:h-fit, not sm:h-auto: a native <dialog>'s default `showModal()`
       centering pins both `top` and `bottom` to 0 (see the UA stylesheet's
       `dialog:modal { inset-block: 0 }`), and `height: auto` against two
       pinned edges resolves to stretch-to-fill, not shrink-to-content:
       every short project was rendering at the full sm:max-h-[85vh] cap
       instead of its own (much shorter) content height. `fit-content`
       explicitly asks for shrink-to-fit sizing regardless of that stretch
       context, so a short project sizes to its own content and a long one
       still clamps at the cap and scrolls, exactly as before.

       Not rendered at all when project.hidden — the point of hiding a
       project is that its real copy isn't ready or approved yet, so the
       detail view (description, achievements, demo) shouldn't reach the
       page's HTML even unopened. -->
  {!project.hidden && (
  <dialog
    id={modalId}
    class="h-dvh w-full max-w-full rounded-none border-0 m-0 bg-[var(--color-surface)] p-0 text-[var(--color-text)] backdrop:bg-black/60 backdrop:backdrop-blur-sm sm:m-auto sm:h-fit sm:max-h-[85vh] sm:w-[min(92vw,40rem)] sm:rounded-xl sm:border sm:border-[var(--color-border)]"
  >
    <div class="overflow-hidden rounded-none sm:rounded-xl">
      <div class="relative flex items-center justify-between gap-3 border-b border-[var(--color-border)] bg-[var(--color-bg)] px-6 py-4">
        <div class="flex items-center gap-3">
          <!-- This modal only ever opens from inside a career-stop modal
               that's still open underneath it, so closing this one (same
               action as the ✕) reads better labeled as "back" here. -->
          <form method="dialog">
            <button
              aria-label="Back to the career stop"
              class="flex h-7 items-center gap-1 rounded-full bg-[var(--color-border)] px-2.5 font-mono text-xs text-[var(--color-text)] transition hover:brightness-125"
            >
              ← Back
            </button>
          </form>
          {
            project.isSideProject ? (
              <span class="rounded-full border border-[var(--color-border)] px-2 py-1 font-mono text-[10px] uppercase tracking-wide text-[var(--color-muted)]">
                Side project
              </span>
            ) : (
              badgeCompanies.map((c) => (
                <span class={`flex h-9 w-9 items-center justify-center overflow-hidden rounded-lg ${c.logoFill ? '' : 'p-1.5'} ${c.chipClass}`}>
                  <img
                    src={c.logo}
                    alt={c.name}
                    class={`h-full w-full object-contain ${c.logoInvert ? 'brightness-0 invert' : ''}`}
                    style={c.logoScale ? `transform: scale(${c.logoScale})` : undefined}
                  />
                </span>
              ))
            )
          }
        </div>
        <form method="dialog">
          <button
            aria-label="Close"
            class="flex h-7 w-7 items-center justify-center rounded-full bg-[var(--color-border)] text-[var(--color-text)] transition hover:brightness-125"
          >
            ✕
          </button>
        </form>
      </div>

      <div class="p-6">
        <div class="flex flex-wrap items-center gap-2">
          <h3 class="text-xl font-bold text-[var(--color-text)]">{project.name}</h3>
          {project.confidential && (
            <span class="flex items-center gap-1 rounded-full border border-[var(--color-border)] bg-[var(--color-bg)] px-2 py-0.5 font-mono text-[10px] uppercase tracking-wide text-[var(--color-muted)]">
              <svg viewBox="0 0 24 24" class="h-3 w-3 fill-current">
                <path d="M12 1a5 5 0 00-5 5v3H6a2 2 0 00-2 2v9a2 2 0 002 2h12a2 2 0 002-2v-9a2 2 0 00-2-2h-1V6a5 5 0 00-5-5zm0 2a3 3 0 013 3v3H9V6a3 3 0 013-3z" />
              </svg>
              Confidential
            </span>
          )}
        </div>
        <p class="mt-1 text-sm text-[var(--color-accent)]">{project.tldr}</p>
        {project.myRole && (
          <p class="mt-2 font-mono text-xs text-[var(--color-muted)]">
            <span class="uppercase tracking-wide text-[var(--color-accent)]">My role: </span>
            {project.myRole}
          </p>
        )}
        <p class="mt-3 text-[var(--color-muted)]">{project.description}</p>

        {project.url && (
          project.urlStyle === 'paper' ? (
            <a
              href={project.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group/paper mt-4 block w-52 -rotate-1 rounded-[2px] bg-[#f4f1ea] p-3.5 text-neutral-900 shadow-md transition hover:-translate-y-0.5 hover:rotate-0 hover:shadow-lg"
            >
              <div class="flex items-baseline justify-between gap-3 border-b-2 border-neutral-900 pb-1.5">
                <span class="font-serif text-[10px] font-bold uppercase tracking-[0.2em] text-neutral-900">
                  {project.urlSource ?? 'Read'}
                </span>
              </div>
              <p class="mt-2 font-serif text-sm font-bold italic leading-snug text-neutral-900 group-hover/paper:underline">
                “{project.name}”
              </p>
              <p class="mt-2 font-mono text-[9px] uppercase tracking-wide text-neutral-500">
                {project.urlLabel ?? 'Read →'}
              </p>
            </a>
          ) : (
            <a
              href={project.url}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-3 inline-block text-xs text-[var(--color-accent)] underline underline-offset-4"
            >
              {project.urlLabel ?? 'View →'}
            </a>
          )
        )}

        {project.demo && (
          <div class="mt-4 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)] py-5">
            <PhoneMockup
              mode={project.demo.mode}
              captions={project.demo.captions}
              videos={project.demo.videos}
              steps={project.demo.steps}
            />
          </div>
        )}

        <p class="mt-4 text-xs font-medium uppercase tracking-wide text-[var(--color-accent)]">Technologies</p>
        <div class="mt-2 flex flex-wrap gap-1.5">
          {project.technologies.map((tech) => (
            <TechPill name={tech} />
          ))}
        </div>

        {project.achievements.length > 0 && (
          <>
            <p class="mt-4 text-xs font-medium uppercase tracking-wide text-[var(--color-accent)]">Achievements</p>
            <ul class="mt-2 space-y-1.5">
              {project.achievements.map((achievement) => (
                <li class="flex gap-2 text-[var(--color-text)]">
                  <span class="text-[var(--color-accent)]">▸</span>
                  <span>{achievement}</span>
                </li>
              ))}
            </ul>
          </>
        )}

        {newsItems.length > 0 && (
          <>
            <p class="mb-2 mt-5 text-xs font-medium uppercase tracking-wide text-[var(--color-accent)]">News</p>
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
              {newsItems.map((item, ni) => (
                <a
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class={`group/news block rounded-[2px] bg-[#f4f1ea] p-3.5 text-neutral-900 shadow-md transition hover:-translate-y-0.5 hover:rotate-0 hover:shadow-lg ${ni % 2 === 0 ? 'rotate-[-1deg]' : 'rotate-[1deg]'}`}
                >
                  <div class="flex items-baseline justify-between gap-3 border-b-2 border-neutral-900 pb-1.5">
                    <span class="font-serif text-[10px] font-bold uppercase tracking-[0.2em] text-neutral-900">
                      {item.source}
                    </span>
                    <span class="shrink-0 font-mono text-[9px] uppercase tracking-wide text-neutral-500">
                      {formatNewsDate(item.date)}
                    </span>
                  </div>
                  <p class="mt-2 font-serif text-sm font-bold italic leading-snug text-neutral-900 group-hover/news:underline">
                    “{item.title}”
                  </p>
                  <p class="mt-2 font-mono text-[9px] uppercase tracking-wide text-neutral-500">
                    Read the article →
                  </p>
                </a>
              ))}
            </div>
          </>
        )}
      </div>
    </div>
  </dialog>
  )}
</div>
