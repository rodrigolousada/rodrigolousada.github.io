---
// The typical top-bar flag dropdown — but only when there's something to
// switch between. site.json's top-level keys are the full list of
// languages the site offers (see src/data/site.ts); with just one ("en"
// today) there's nothing to pick between, so this renders nothing at all
// rather than a selector with a single, disabled-feeling option.
import { locales, defaultLocale, type Locale } from '../data/site';
import { getUI } from '../data/ui';
import { getLanguageMeta, localePath } from '../data/languages';

interface Props {
  locale: Locale;
  /** Opens the option list upward instead of down. The desktop top-bar's
   * copy of this (Nav.astro) has the whole page below it and keeps the
   * default; the mobile nav panel's copy sits `mt-auto`-pinned to the
   * bottom of a fixed, viewport-height slide-in panel, so a downward
   * dropdown there has nowhere to go but off the bottom of the screen. */
  dropUp?: boolean;
}

const { locale, dropUp = false } = Astro.props;
const current = getLanguageMeta(locale);
const ui = getUI(locale);
---

{
  locales.length > 1 && (
    <details data-lang-select class="group/lang relative">
      <summary
        aria-label={ui.nav.changeLanguage.replace('{label}', current.label)}
        class="flex cursor-pointer list-none items-center gap-1.5 rounded-full border border-[var(--color-border)] px-2.5 py-1 text-sm text-[var(--color-text)] transition hover:border-[var(--color-accent)] [&::-webkit-details-marker]:hidden"
      >
        <span aria-hidden="true">{current.flag}</span>
        <svg viewBox="0 0 24 24" class="h-3 w-3 fill-current text-[var(--color-muted)] transition group-open/lang:rotate-180">
          <path d="M7 10l5 5 5-5z" />
        </svg>
      </summary>
      <ul class={`absolute right-0 z-50 w-40 overflow-hidden rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] py-1 shadow-lg ${dropUp ? 'bottom-full mb-2' : 'mt-2'}`}>
        {locales.map((loc) => {
          const meta = getLanguageMeta(loc);
          return (
            <li>
              <a
                href={localePath(loc, defaultLocale)}
                data-lang-option={loc}
                aria-current={loc === locale ? 'true' : undefined}
                class={`flex items-center gap-2 px-3 py-2 text-sm transition hover:bg-[var(--color-border)]/50 ${
                  loc === locale ? 'text-[var(--color-accent)]' : 'text-[var(--color-text)]'
                }`}
              >
                <span aria-hidden="true">{meta.flag}</span>
                {meta.label}
              </a>
            </li>
          );
        })}
      </ul>
    </details>
  )
}

<script>
  // Closes like a normal dropdown on an outside click — a native <details>
  // otherwise stays open until its own summary is clicked again.
  document.querySelectorAll<HTMLDetailsElement>('[data-lang-select]').forEach((details) => {
    document.addEventListener('click', (e) => {
      if (details.open && !details.contains(e.target as Node)) details.removeAttribute('open');
    });
  });

  // Remembers whichever language was explicitly picked here (English
  // included) so a later visit — to this page or any other — lands
  // straight on it instead of always starting from English again. Read by
  // the inline redirect script at the top of Layout.astro's <head>.
  document.querySelectorAll<HTMLAnchorElement>('[data-lang-option]').forEach((link) => {
    link.addEventListener('click', () => {
      try {
        localStorage.setItem('preferredLocale', link.dataset.langOption ?? '');
      } catch {
        // localStorage unavailable — the click still navigates normally,
        // it just won't be remembered next time.
      }
    });
  });
</script>
