---
// Quote drawn from a real recommendation letter (08/02/2024). The full letter
// is shown in the modal below with the signature blurred out for privacy —
// see letterImage.
import site from '../data/site.json';
import { icons } from '../data/icons';
const { testimonial, about } = site;
const modalId = 'apc-letter';
const certModalId = 'clifton-strengths-certificate';
---

<section class="mx-auto max-w-3xl px-6 py-14">
  <div class="mb-6 flex items-center gap-3">
    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[var(--color-accent)]/10 text-[var(--color-accent)]">
      <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current">
        <path d={icons.chat} />
      </svg>
    </span>
    <h2 class="font-mono text-sm tracking-widest text-[var(--color-accent)]">WHAT PEOPLE SAY</h2>
  </div>

  <button
    type="button"
    onclick={testimonial.letterImage ? `document.getElementById('${modalId}').showModal()` : undefined}
    class="group flex w-full items-start gap-4 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6 text-left transition hover:border-[var(--color-accent)]"
  >
    {testimonial.photo ? (
      <img
        src={testimonial.photo}
        alt={testimonial.name}
        class="h-11 w-11 shrink-0 rounded-full object-cover"
      />
    ) : (
      <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-[var(--color-border)] font-mono text-xs font-semibold text-[var(--color-text)]">
        {testimonial.initials}
      </div>
    )}
    <div class="min-w-0 flex-1">
      <p class="text-[var(--color-text)]">{testimonial.text}</p>
      <footer class="mt-4 flex flex-wrap items-center justify-between gap-x-4 gap-y-1 text-sm">
        <p>
          <span class="font-medium text-[var(--color-text)]">{testimonial.name}</span>
          <span class="text-[var(--color-muted)]"> · {testimonial.role}</span>
        </p>
        {testimonial.letterImage && (
          <span class="shrink-0 font-mono text-xs text-[var(--color-muted)] transition group-hover:text-[var(--color-accent)]">
            Read the full letter →
          </span>
        )}
      </footer>
    </div>
  </button>

  <div class="mt-8">
    <p class="mb-2 font-mono text-[10px] uppercase tracking-widest text-[var(--color-muted)]">
      My Clifton Strengths
    </p>
    <div class="flex flex-wrap items-center gap-2">
      {
        about.strengths.map((s) => (
          <div class="group/strength relative inline-block">
            <button
              type="button"
              class="strength-marker rounded-full border border-[var(--color-border)] px-3 py-1 text-xs text-[var(--color-muted)] transition hover:border-[var(--color-accent)] hover:text-[var(--color-text)] focus:border-[var(--color-accent)] focus:text-[var(--color-text)] focus:outline-none"
            >
              {s.name}
            </button>

            <div class="strength-popup pointer-events-none absolute bottom-full left-1/2 z-50 mb-2 w-64 -translate-x-1/2 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] p-3 text-left opacity-0 shadow-xl transition duration-150 group-hover/strength:pointer-events-auto group-hover/strength:opacity-100 group-focus-within/strength:pointer-events-auto group-focus-within/strength:opacity-100">
              <p class="text-xs font-semibold text-[var(--color-accent)]">{s.name}</p>
              <p class="mt-1 text-xs leading-relaxed text-[var(--color-text)]">{s.description}</p>
              {about.certificateImage && (
                <button
                  type="button"
                  onclick={`document.getElementById('${certModalId}').showModal()`}
                  class="mt-2 text-xs text-[var(--color-accent)] underline underline-offset-4"
                >
                  See certificate →
                </button>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

{about.certificateImage && (
  <dialog
    id={certModalId}
    class="m-auto w-[min(92vw,30rem)] max-h-[90vh] rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-0 text-[var(--color-text)] backdrop:bg-black/60 backdrop:backdrop-blur-sm"
  >
    <div class="flex items-center justify-between border-b border-[var(--color-border)] px-6 py-4">
      <p class="font-mono text-xs uppercase tracking-widest text-[var(--color-accent)]">CliftonStrengths certificate</p>
      <form method="dialog">
        <button
          aria-label="Close"
          class="flex h-7 w-7 items-center justify-center rounded-full bg-[var(--color-border)] text-[var(--color-text)] transition hover:brightness-125"
        >
          ✕
        </button>
      </form>
    </div>
    <div class="max-h-[calc(90vh-4rem)] overflow-y-auto p-6">
      <img
        src={about.certificateImage}
        alt="Official Gallup CliftonStrengths certificate"
        class="w-full rounded-lg border border-[var(--color-border)]"
        loading="lazy"
      />
    </div>
  </dialog>
)}

{testimonial.letterImage && (
  <dialog
    id={modalId}
    class="m-auto w-[min(92vw,34rem)] max-h-[90vh] rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-0 text-[var(--color-text)] backdrop:bg-black/60 backdrop:backdrop-blur-sm"
  >
    <div class="flex items-center justify-between border-b border-[var(--color-border)] px-6 py-4">
      <p class="font-mono text-xs uppercase tracking-widest text-[var(--color-accent)]">Recommendation letter</p>
      <form method="dialog">
        <button
          aria-label="Close"
          class="flex h-7 w-7 items-center justify-center rounded-full bg-[var(--color-border)] text-[var(--color-text)] transition hover:brightness-125"
        >
          ✕
        </button>
      </form>
    </div>
    <div class="max-h-[calc(90vh-4rem)] overflow-y-auto p-6">
      <img
        src={testimonial.letterImage}
        alt={`Recommendation letter from ${testimonial.name}`}
        class="w-full rounded-lg border border-[var(--color-border)]"
        loading="lazy"
      />
      <p class="mt-3 text-xs text-[var(--color-muted)]">
        Signature blurred for privacy. Happy to share the original on request.
      </p>
      {testimonial.scrollTo && (
        <button
          type="button"
          data-scroll-target={testimonial.scrollTo}
          data-scroll-label={testimonial.company}
          class="mt-4 text-xs text-[var(--color-accent)] underline underline-offset-4"
        >
          Written during my time at {testimonial.company} →
        </button>
      )}
    </div>
  </dialog>
)}
