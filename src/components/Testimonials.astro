---
// Quote drawn from a real recommendation letter (08/02/2024). Only the text is
// used here — the signed PDF (and signature) is never published.
import site from '../data/site.json';
const { testimonial } = site;
---

<section class="mx-auto max-w-3xl px-6 py-14">
  <h2 class="mb-6 font-mono text-sm tracking-widest text-[var(--color-accent)]">
    WHAT PEOPLE SAY
  </h2>

  <button
    type="button"
    data-scroll-target={testimonial.scrollTo}
    class="group flex w-full items-start gap-4 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6 text-left transition hover:border-[var(--color-accent)]"
  >
    {testimonial.photo ? (
      <img
        src={testimonial.photo}
        alt={testimonial.name}
        class="h-11 w-11 shrink-0 rounded-full object-cover"
      />
    ) : (
      <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-[var(--color-border)] font-mono text-xs font-semibold text-[var(--color-text)]">
        {testimonial.initials}
      </div>
    )}
    <div class="min-w-0 flex-1">
      <p class="text-[var(--color-text)]">{testimonial.text}</p>
      <footer class="mt-4 flex flex-wrap items-center justify-between gap-x-4 gap-y-1 text-sm">
        <p>
          <span class="font-medium text-[var(--color-text)]">{testimonial.name}</span>
          <span class="text-[var(--color-muted)]"> — {testimonial.role}</span>
        </p>
        {testimonial.scrollTo && (
          <span class="shrink-0 font-mono text-xs text-[var(--color-muted)] transition group-hover:text-[var(--color-accent)]">
            See the project →
          </span>
        )}
      </footer>
    </div>
  </button>
</section>
