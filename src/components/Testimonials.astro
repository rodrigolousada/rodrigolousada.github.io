---
// Quote(s) drawn from real recommendation letters. The full letter is shown
// in a modal below with the signature blurred out for privacy, see
// TestimonialCard's letterImage handling. Same "first N, then Show more"
// pattern as the career timeline and side projects (see Projects.astro):
// the first two people show up front, anyone past that hides behind "Show
// more" so the section doesn't grow without bound as more feedback is added.
import { getSite, type Locale } from '../data/site';
import { getUI } from '../data/ui';
import { icons } from '../data/icons';
import TestimonialCard from './TestimonialCard.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { testimonials, about } = getSite(locale);
const ui = getUI(locale);
const visibleTestimonials = testimonials.slice(0, 2);
const moreTestimonials = testimonials.slice(2);
const certModalId = 'clifton-strengths-certificate';
---

<section id="feedback" class="mx-auto max-w-3xl px-6 py-14">
  <div class="mb-6 flex items-center gap-3">
    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[var(--color-accent)]/10 text-[var(--color-accent)]">
      <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current">
        <path d={icons.chat} />
      </svg>
    </span>
    <h2 class="font-mono text-sm tracking-widest text-[var(--color-accent)]">{ui.testimonials.heading}</h2>
  </div>

  <div class="space-y-4">
    {
      visibleTestimonials.map((t, i) => (
        <TestimonialCard testimonial={t} modalId={`testimonial-letter-${i}`} locale={locale} />
      ))
    }
  </div>

  {moreTestimonials.length > 0 && (
    <details class="group/testimonialsmore mt-4">
      <summary class="flex cursor-pointer list-none items-center gap-2 py-1 font-mono text-xs text-[var(--color-muted)] transition hover:text-[var(--color-accent)] [&::-webkit-details-marker]:hidden">
        <span class="inline-block transition group-open/testimonialsmore:rotate-90">▸</span>
        {ui.common.showMore}
      </summary>
      <div class="mt-4 space-y-4">
        {
          moreTestimonials.map((t, i) => (
            <TestimonialCard testimonial={t} modalId={`testimonial-letter-${i + visibleTestimonials.length}`} locale={locale} />
          ))
        }
      </div>
    </details>
  )}

  <div class="mt-8">
    <p class="mb-2 font-mono text-[10px] uppercase tracking-widest text-[var(--color-muted)]">
      {ui.testimonials.cliftonStrengths}
    </p>
    <div class="flex flex-wrap items-center gap-2">
      {
        about.strengths.map((s) => (
          <div class="group/strength relative inline-block">
            <button
              type="button"
              class="strength-marker rounded-full border border-[var(--color-border)] px-3 py-1 text-xs text-[var(--color-muted)] transition hover:border-[var(--color-accent)] hover:text-[var(--color-text)] focus:border-[var(--color-accent)] focus:text-[var(--color-text)] focus:outline-none"
            >
              {s.name}
            </button>

            {/* The visible tooltip sits `pb-2` above the chip rather than
                using a margin, so the hoverable box (this outer div) reaches
                all the way down to touch the button with no dead gap in
                between — a plain margin-based gap is a strip the cursor has
                to cross that belongs to neither element, which drops
                group-hover the instant the mouse enters it on the way up
                from the chip to the "See certificate" link. Padding is part
                of the box for hover purposes, so it bridges that gap while
                the inner div keeps the actual card look (border/bg/shadow)
                clear of the padding, preserving the same visual spacing. */}
            <div class="strength-popup pointer-events-none absolute bottom-full left-1/2 z-50 w-64 max-w-[calc(100vw-2rem)] pb-2 opacity-0 transition duration-150 group-hover/strength:pointer-events-auto group-hover/strength:opacity-100 group-focus-within/strength:pointer-events-auto group-focus-within/strength:opacity-100">
              <div class="rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] p-3 text-left shadow-xl">
                <p class="text-xs font-semibold text-[var(--color-accent)]">{s.name}</p>
                <p class="mt-1 text-xs leading-relaxed text-[var(--color-text)]">{s.description}</p>
                {about.certificateImage && (
                  <button
                    type="button"
                    onclick={`document.getElementById('${certModalId}').showModal()`}
                    class="mt-2 text-xs text-[var(--color-accent)] underline underline-offset-4"
                  >
                    {ui.testimonials.seeCertificate}
                  </button>
                )}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

{about.certificateImage && (
  <dialog
    id={certModalId}
    class="m-auto w-[min(92vw,30rem)] max-h-[90vh] rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-0 text-[var(--color-text)] backdrop:bg-black/60 backdrop:backdrop-blur-sm"
  >
    <div class="flex items-center justify-between border-b border-[var(--color-border)] px-6 py-4">
      <p class="font-mono text-xs uppercase tracking-widest text-[var(--color-accent)]">{ui.testimonials.certificateHeading}</p>
      <form method="dialog">
        <button
          aria-label={ui.common.close}
          class="flex h-7 w-7 items-center justify-center rounded-full bg-[var(--color-border)] text-[var(--color-text)] transition hover:brightness-125"
        >
          ✕
        </button>
      </form>
    </div>
    <div class="max-h-[calc(90vh-4rem)] overflow-y-auto p-6">
      <img
        src={about.certificateImage}
        alt="Official Gallup CliftonStrengths certificate"
        class="w-full rounded-lg border border-[var(--color-border)]"
        loading="lazy"
      />
    </div>
  </dialog>
)}

{about.strengths.length > 0 && (
  <script>
    // The strength popup only shows via CSS (:hover / :focus-within), no
    // click wiring needed — but clicking the "strength-marker" button (or
    // the nested "See certificate" link) leaves it focused, and clicking a
    // non-focusable area of the page afterwards doesn't move focus away in
    // Chrome/Safari. So the popup was getting stuck open long after the
    // mouse had left, until something else happened to steal focus. Blur
    // whatever's focused inside a strength group the moment the mouse
    // leaves it, so hovering away always closes it like it visually should
    // — Tab-based keyboard focus is untouched since this only fires on
    // mouseleave.
    document.querySelectorAll<HTMLElement>('.group\\/strength').forEach((group) => {
      group.addEventListener('mouseleave', () => {
        if (document.activeElement instanceof HTMLElement && group.contains(document.activeElement)) {
          document.activeElement.blur();
        }
      });
    });

    // The popup is centered under its marker by default (left-1/2 +
    // -translate-x-1/2), which clips off-screen for the markers closest to
    // either edge: the first strength badge (bottom-left of the viewport
    // on mobile, where the section itself starts right after the page
    // padding) is the one that actually got cut. Rather than special-case
    // "the first one", nudge any popup that would overflow back inside the
    // viewport, by exactly however much it overflows, measured before it's
    // shown (it's already laid out at opacity:0, not display:none, so its
    // real position is readable ahead of the hover/focus that reveals it).
    const EDGE_MARGIN = 8;
    document.querySelectorAll<HTMLElement>('.strength-popup').forEach((popup) => {
      const group = popup.closest<HTMLElement>('.group\\/strength');
      if (!group) return;
      function reposition() {
        popup.style.setProperty('--edge-shift', '0px');
        const rect = popup.getBoundingClientRect();
        let shift = 0;
        if (rect.left < EDGE_MARGIN) {
          shift = EDGE_MARGIN - rect.left;
        } else if (rect.right > window.innerWidth - EDGE_MARGIN) {
          shift = window.innerWidth - EDGE_MARGIN - rect.right;
        }
        popup.style.setProperty('--edge-shift', `${shift}px`);
      }
      group.addEventListener('mouseenter', reposition);
      group.addEventListener('focusin', reposition);
    });
  </script>
)}

<style>
  .strength-popup {
    transform: translateX(calc(-50% + var(--edge-shift, 0px)));
  }
</style>
