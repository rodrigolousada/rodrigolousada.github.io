---
import { getSite, type Locale } from '../data/site';
import { getUI } from '../data/ui';
import { icons } from '../data/icons';
import ProjectRow from './ProjectRow.astro';
import type { HandoffStep } from './PhoneMockup.astro';
import type { FlowStep, FlowIntent } from './IntentFlow.astro';

interface Props {
  locale: Locale;
  stop: {
    org: string;
    /** Stable anchor used by cross-links (testimonial, "worked at" logos) to scroll to and open this stop. */
    slug?: string;
    title: string;
    logo: string;
    logoScale?: number;
    /** Overrides `logoScale` for the dialog's own header banner only, where the logo sits alone at a bigger size and unclipped — a multiplier tuned for the small chip elsewhere can read as oversized there. Falls back to `logoScale` when unset. */
    headerLogoScale?: number;
    logoInvert?: boolean;
    chipClass: string;
    period: string;
    role: string;
    kpis: string[];
    /** Personal honors/awards earned during this stop (medals) — distinct from project-level achievements. */
    honors?: { label: string; year?: string; type?: string }[];
    /** Small Credly digital badges to show as a tiny logo strip (IBM, etc). Each links out to its own Credly page for the full-resolution badge. Set `highlight: true` on the handful worth calling out (e.g. AWS) — they render bigger, above the rest. */
    credlyBadges?: { name: string; img: string; url?: string; highlight?: boolean }[];
    credlyProfileUrl?: string;
    /** True while this whole career stop isn't ready to show yet. Renders the row blurred with a "Coming soon" badge; clicking it shakes and flashes red instead of opening a modal — same treatment as a hidden project, see ProjectRow.astro. */
    hidden?: boolean;
    projects: {
      name: string;
      companies?: string[];
      isSideProject?: boolean;
      confidential?: boolean;
      /** True while the project isn't ready to show yet. See ProjectRow.astro for the rendered lock/blur treatment. */
      hidden?: boolean;
      tldr: string;
      description: string;
      myRole?: string;
      technologies: string[];
      achievements: string[];
      demo?: {
        mode?: string;
        captions?: string[];
        videos?: (string | null)[];
        steps?: HandoffStep[];
        intake?: FlowStep[];
        router?: FlowStep;
        intents?: FlowIntent[];
        fallback?: FlowStep;
        note?: string;
      };
      news?: { title: string; source: string; date: string; url: string }[];
      /** External link to the project itself (thesis PDF, publication, live app, etc.). */
      url?: string;
      urlLabel?: string;
    }[];
    focus: Record<string, number>;
  };
  modalId: string;
  /** Draw the connecting rail below this row (default true — set false on the last item in a list). */
  showLine?: boolean;
}

const { stop, modalId, showLine = true, locale } = Astro.props;
const { focusCategories } = getSite(locale);
const ui = getUI(locale);

// Highest-percentage area first, always — a fixed category order (the data's
// own key order) made two stops that share the same categories read
// differently just because one happened to type "pm" before "swe" and the
// other didn't. Sorting is the only thing that moves: each segment and its
// legend swatch still pull `cat.color` from `focusCategories`, so a
// category's color stays its own no matter where the sort puts it.
const sortedFocus = focusCategories
  .filter((cat) => (stop.focus[cat.id] ?? 0) > 0)
  .sort((a, b) => (stop.focus[b.id] ?? 0) - (stop.focus[a.id] ?? 0));

// Same "first N, then Show more" pattern as the career timeline and side
// projects grid in Projects.astro — a stop with a long project list (e.g.
// six at IBM Consulting) made the modal itself scroll for a while just to
// reach "Focus this era" and the badges below it.
const visibleProjects = stop.projects.slice(0, 3);
const moreProjects = stop.projects.slice(3);
---

<div class="grid grid-cols-[1rem_1fr] gap-2 sm:grid-cols-[1.5rem_1fr] sm:gap-4">
  <!-- Rail: dot centers on this row regardless of its height, line bleeds into the gap to meet the next row's dot.
       Narrower on mobile (1rem rail, gap-2) than sm+ (1.5rem, gap-4) — the
       timeline doesn't need as much horizontal real estate on a narrow
       screen, and every margin there is precious. -->
  <div class="relative">
    {
      showLine && (
        <span class="absolute left-1/2 top-0 h-[calc(100%+1rem)] w-px -translate-x-1/2 bg-[var(--color-border)]" />
      )
    }
    <span class="absolute left-1/2 top-1/2 z-10 h-2.5 w-2.5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-[var(--color-accent)] ring-4 ring-[var(--color-bg)]" />
  </div>

  <div class="min-w-0" id={stop.slug} data-stop-anchor={stop.slug} data-modal-id={modalId}>
    <button
      type="button"
      onclick={stop.hidden ? undefined : `document.getElementById('${modalId}').showModal()`}
      data-locked={stop.hidden ? 'true' : undefined}
      aria-disabled={stop.hidden ? 'true' : undefined}
      class={`group flex w-full items-center gap-4 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-4 text-left transition sm:p-5 ${stop.hidden ? 'hover:border-red-500/60' : 'hover:border-[var(--color-accent)]'}`}
    >
      <div class={`flex min-w-0 flex-1 items-center gap-4 ${stop.hidden ? 'select-none blur-[3px]' : ''}`}>
        <div class={`flex h-12 w-12 shrink-0 items-center justify-center overflow-hidden rounded-lg p-1.5 ${stop.chipClass}`}>
          <img
            src={stop.logo}
            alt={`${stop.org} logo`}
            class={`h-full w-full object-contain ${stop.logoInvert ? 'brightness-0 invert' : ''}`}
            style={stop.logoScale ? `transform: scale(${stop.logoScale})` : undefined}
          />
        </div>

        <div class="min-w-0 flex-1">
          <p class="font-semibold text-[var(--color-text)]">{stop.title}</p>
          <p class="text-xs text-[var(--color-muted)]">
            {stop.org}
            <!-- Block below sm, not left to wrap inline: on narrow screens a
                 long org name (e.g. "Instituto de Telecomunicações") pushed
                 this onto multiple lines anyway, and plain word-wrap was
                 splitting mid-date ("· 2018" / "– 2020") wherever it ran out
                 of room. Forcing the period onto its own line keeps it whole. -->
            <span class="block sm:inline"><span class="hidden sm:inline"> · </span>{stop.period}</span>
          </p>
        </div>
      </div>

      {stop.hidden ? (
        <span class="flex shrink-0 items-center gap-1.5 rounded-full border border-[var(--color-border)] bg-[var(--color-bg)] px-2.5 py-1 font-mono text-[10px] uppercase tracking-wide text-[var(--color-muted)]">
          <svg viewBox="0 0 24 24" class="h-3 w-3 fill-current">
            <path d={icons.lock} />
          </svg>
          {ui.common.comingSoon}
        </span>
      ) : (
        <span class="shrink-0 font-mono text-xs text-[var(--color-muted)] transition group-hover:text-[var(--color-accent)]">
          {ui.common.view}
        </span>
      )}
    </button>

    <!-- A bottom sheet on mobile, a compact centered card at sm: and up —
         not a full-screen sheet either way, it should always read as a
         popup floating over the page rather than taking over the screen.

         Mobile: `mt-auto` (paired with `mb-0`, since margins are otherwise
         left at their default) pushes the box to the bottom of the viewport
         rather than centering it — a native <dialog>'s `showModal()` pins
         both `top` and `bottom` to 0 (the UA stylesheet's
         `dialog:modal { inset-block: 0 }`), so an auto top margin against a
         fixed bottom edge absorbs all the leftover space above instead of
         splitting it, which is exactly bottom-anchor. `mx-3` +
         `w-[calc(100%-1.5rem)]` (rather than a plain `w-full`) leaves a
         small gap on either side instead of running the sheet edge-to-edge —
         the margin and the width add back up to the full inset:0 box, so it
         still spans the same space, just with breathing room left and right
         instead of touching the screen's sides. `rounded-t-2xl` (no bottom
         rounding — it's still flush with the screen edge underneath)
         completes the sheet look. A `[data-sheet-handle]` grab bar (wired up
         generically in Layout.astro, styled in global.css's `.sheet-handle`)
         floats on top of the header via `absolute` positioning, inside the
         same rounded/clipped wrapper the header itself uses — not stacked
         above it as its own flat strip, which doubled up the rounded-corner
         look (the wrapper's own top corners rounding a second time right
         under the dialog's already-rounded top edge) and looked like two
         nested cards. `top-2`, plus `h-28` (vs. the header's usual `h-24`,
         reverted at sm:) giving it a bit more headroom below the handle,
         clears every header's actual content in every dialog this pattern is
         used in, so the handle never sits on top of anything meant to be
         read or clicked, and never crowds it either.

         A quick, genuinely fast swipe down dismisses the sheet from anywhere
         on it, not just the handle — see Layout.astro's script for why that
         needs its own (gated) logic rather than just widening the handle's
         drag zone. If this dialog is stacked over another (the image
         lightbox opening from within one of these, say), closing it this
         way naturally reveals whatever's underneath — no separate "back"
         action needed, that's just what closing the top of a stack does.

         sm: and up reverts to the original centered-popup treatment: back to
         `m-auto` centering, a cap 92vw/40rem wide instead of full-width, and
         rounded on every corner instead of just the top two.

         h-fit (not h-auto), at every width: `height: auto` against those two
         pinned edges resolves to stretch-to-fill, not shrink-to-content: a
         short stop was rendering at the full max-h cap instead of its own
         (much shorter) content height. `fit-content` explicitly asks for
         shrink-to-fit sizing regardless of that stretch context, so a short
         stop sizes to its own content and a long one still clamps at the cap
         and scrolls, exactly as before.

         max-h-[94svh], not the tighter 85 the very first pass used: there's
         no real reason to leave 15% of the screen as bare backdrop when the
         content could use that room instead — a sliver at the top (~6%) is
         plenty to still read as "a sheet over the page" rather than a
         full-screen takeover.

         svh, not dvh: `dvh` tracks the mobile browser's address bar live as
         it hides/shows, and that bar can re-animate from things well short
         of an obvious scroll — a tap moving focus inside the sheet was
         enough, noticeable on "All Technologies" as its Search/Preferred
         Stack tabs nudging the sheet a little shorter with every switch
         instead of holding still. `svh` is pinned to the smallest possible
         viewport (chrome fully expanded) and never recomputes after
         layout, so it can't jitter — the sheet gives up a little of the
         extra room `dvh` could reach when the chrome happens to be hidden,
         in exchange for never visibly moving on its own.

         Not rendered at all when stop.hidden — same reasoning as a hidden
         project's dialog (ProjectRow.astro): the stop's real KPIs/projects
         shouldn't reach the page's HTML unopened. -->
    {!stop.hidden && (
    <dialog
      id={modalId}
      class="mx-3 mb-0 mt-auto h-fit max-h-[94svh] w-[calc(100%-1.5rem)] max-w-none rounded-t-2xl border-0 border-t border-[var(--color-border)] bg-[var(--color-surface)] p-0 text-[var(--color-text)] backdrop:bg-black/60 backdrop:backdrop-blur-sm sm:m-auto sm:max-h-[85vh] sm:w-[min(92vw,40rem)] sm:rounded-xl sm:border"
    >
      <div class="relative overflow-hidden rounded-t-2xl sm:rounded-xl">
        <div data-sheet-handle class="sheet-handle absolute left-1/2 top-2 z-10 h-1.5 w-10 -translate-x-1/2 rounded-full bg-white/40 sm:hidden" aria-hidden="true"></div>
        <div class={`relative flex h-28 items-center justify-center overflow-hidden sm:h-24 ${stop.chipClass}`}>
          <img
            src={stop.logo}
            alt={`${stop.org} logo`}
            class={`h-10 w-auto object-contain ${stop.logoInvert ? 'brightness-0 invert' : ''}`}
            style={(() => {
              const scale = stop.headerLogoScale ?? stop.logoScale;
              return scale ? `transform: scale(${scale})` : undefined;
            })()}
          />
          <form method="dialog" class="absolute right-3 top-3">
            <button
              aria-label={ui.common.close}
              class="flex h-7 w-7 items-center justify-center rounded-full bg-black/30 text-white transition hover:bg-black/50"
            >
              ✕
            </button>
          </form>
        </div>

        <div class="p-6">
          <div class="mb-1 flex flex-wrap items-center gap-x-3 gap-y-1">
            <span class="text-sm font-medium text-[var(--color-text)]">{stop.org}</span>
            <span class="text-sm text-[var(--color-muted)]">· {stop.period}</span>
          </div>
          <p class="text-[var(--color-muted)]">{stop.role}</p>

          <div
            class={`mt-8 gap-x-8 gap-y-8 ${stop.honors && stop.honors.length > 0 && stop.honors.length <= 2 ? 'grid sm:grid-cols-[2fr_1fr]' : ''}`}
          >
            <div>
              <p class="text-xs font-medium uppercase tracking-wide text-[var(--color-accent)]">{ui.careerStop.kpis}</p>
              <ul class="mt-3 space-y-2">
                {stop.kpis.map((kpi) => (
                  <li class="flex gap-2 text-[var(--color-text)]">
                    <span class="text-[var(--color-accent)]">▸</span>
                    <span>{kpi}</span>
                  </li>
                ))}
              </ul>
            </div>

            {stop.honors && stop.honors.length > 0 && (
              <div>
                <p class="text-xs font-medium uppercase tracking-wide text-[var(--color-accent)]">
                  {ui.common.achievements}
                </p>
                <div class="mt-3 flex flex-wrap gap-5">
                  {stop.honors.map((honor) => {
                    const isTrophy = honor.type === 'trophy';
                    const ringClass = isTrophy
                      ? 'border-amber-400/40 bg-amber-400/10'
                      : 'border-[var(--color-accent)]/40 bg-[var(--color-accent)]/10';
                    const ribbonClass = isTrophy ? 'bg-amber-400/30' : 'bg-[var(--color-accent)]/30';
                    return (
                      <div class="flex w-20 flex-col items-center gap-2 text-center">
                        <div class={`relative flex h-12 w-12 shrink-0 items-center justify-center rounded-full border-2 ${ringClass}`}>
                          {isTrophy ? (
                            <svg viewBox="0 0 24 24" class="h-6 w-6 fill-amber-400">
                              <path d="M7 4h10l-3 8h-4z" />
                              <path d="M6 5L3.5 5L3.5 8.5L6 9.5Z" />
                              <path d="M18 5L20.5 5L20.5 8.5L18 9.5Z" />
                              <rect x="11" y="12" width="2" height="3" />
                              <rect x="9" y="15" width="6" height="2" />
                              <rect x="7.5" y="17.25" width="9" height="1.75" rx="0.6" />
                            </svg>
                          ) : (
                            <svg viewBox="0 0 24 24" class="h-6 w-6 fill-[var(--color-accent)]">
                              <path d={icons.star} />
                            </svg>
                          )}
                          <span
                            class={`absolute -bottom-1 left-1/2 h-3 w-2.5 -translate-x-[10px] rotate-[20deg] ${ribbonClass}`}
                            style="clip-path: polygon(0 0, 100% 0, 60% 100%)"
                          />
                          <span
                            class={`absolute -bottom-1 left-1/2 h-3 w-2.5 translate-x-px -rotate-[20deg] ${ribbonClass}`}
                            style="clip-path: polygon(0 0, 100% 0, 40% 100%)"
                          />
                        </div>
                        <p class="text-[11px] leading-tight text-[var(--color-text)]">{honor.label}</p>
                        {honor.year && <p class="text-[10px] text-[var(--color-muted)]">{honor.year}</p>}
                      </div>
                    );
                  })}
                </div>
              </div>
            )}
          </div>

          <p class="mt-8 text-xs font-medium uppercase tracking-wide text-[var(--color-accent)]">{ui.careerStop.projectsHeading}</p>
          <div class="mt-3 space-y-2">
            {visibleProjects.map((project, pi) => (
              <ProjectRow project={project} modalId={`${modalId}-project-${pi}`} locale={locale} stopSlug={stop.slug} />
            ))}
          </div>

          {moreProjects.length > 0 && (
            <details class="group/projectsmore mt-2">
              <summary class="flex cursor-pointer list-none items-center gap-2 py-1 font-mono text-xs text-[var(--color-muted)] transition hover:text-[var(--color-accent)] [&::-webkit-details-marker]:hidden">
                <span class="inline-block transition group-open/projectsmore:rotate-90">▸</span>
                {ui.common.showMore}
              </summary>
              <div class="mt-2 space-y-2">
                {moreProjects.map((project, pi) => (
                  <ProjectRow project={project} modalId={`${modalId}-project-${pi + visibleProjects.length}`} locale={locale} stopSlug={stop.slug} />
                ))}
              </div>
            </details>
          )}

          <!-- The whole block is one button: bar, percentages and legend are
               plain divs/spans underneath (nothing else in here is itself
               interactive), so wrapping them is valid and gives "see the
               trend" a much bigger, more obvious target than a small text
               link off to the side would. Opens the shared history chart
               (FocusHistoryChart.astro, rendered once in Projects.astro) via
               a DOM event carrying this stop's slug, rather than each stop
               owning its own copy of that dialog. -->
          <button
            type="button"
            data-open-focus-chart={stop.slug}
            class="group/focus mt-8 block w-full rounded-lg text-left"
            aria-label={ui.careerStop.viewFocusHistory}
          >
            <p class="mb-3 flex items-center justify-between gap-2 text-xs font-medium uppercase tracking-wide text-[var(--color-accent)]">
              {ui.careerStop.focusThisEra}
              <span class="flex items-center gap-1 normal-case tracking-normal text-[var(--color-muted)] opacity-0 transition group-hover/focus:opacity-100 group-focus-visible/focus:opacity-100">
                <svg viewBox="0 0 20 20" class="h-3 w-3 fill-current">
                  <path d={icons.trendUp} />
                </svg>
                {ui.careerStop.viewFocusHistory}
              </span>
            </p>
            <div class="flex h-5 w-full overflow-hidden rounded-full bg-[var(--color-border)] ring-1 ring-transparent transition group-hover/focus:ring-[var(--color-accent)]/50">
              {sortedFocus.map((cat, ci, arr) => {
                const value = stop.focus[cat.id] ?? 0;
                const rounding =
                  (ci === 0 ? 'rounded-l-full ' : '') + (ci === arr.length - 1 ? 'rounded-r-full' : '');
                return (
                  <div
                    class={`flex items-center justify-center ${rounding}`}
                    style={`width:${value}%; background-color:${cat.color}; margin-right:${ci === arr.length - 1 ? 0 : '2px'};`}
                    title={`${cat.label}: ${value}%`}
                  >
                    {value >= 15 && <span class="select-none text-[9px] font-semibold text-white">{value}%</span>}
                  </div>
                );
              })}
            </div>
            <div class="mt-4 flex flex-wrap gap-x-4 gap-y-1.5">
              {sortedFocus.map((cat) => (
                <div class="flex items-center gap-1.5">
                  <span class="h-2 w-2 shrink-0 rounded-sm" style={`background-color:${cat.color};`} />
                  <span class="text-[11px] text-[var(--color-muted)]">
                    {cat.label} · {stop.focus[cat.id] ?? 0}%
                  </span>
                </div>
              ))}
            </div>
          </button>

          {stop.credlyBadges && stop.credlyBadges.length > 0 && (() => {
            // Most-important-first, not every badge in a wall: `highlight`
            // already marks the handful actually worth calling out (set per
            // badge in site.json) — show only those as cards here, and push
            // the rest (23 at IBM, most of them intro-level completion
            // badges) behind "Browse all", where they're still one click
            // away rather than gone. A stop with nothing flagged falls back
            // to its first four so this never renders an empty showcase.
            const featured = stop.credlyBadges!.filter((b) => b.highlight);
            const showcased = featured.length > 0 ? featured : stop.credlyBadges!.slice(0, 4);
            return (
              <div data-badge-gallery={`${modalId}-badges`}>
                <p class="mb-3 mt-8 text-xs font-medium uppercase tracking-wide text-[var(--color-accent)]">
                  {ui.careerStop.badges}
                </p>
                <div class="grid grid-cols-2 gap-2.5 sm:grid-cols-4">
                  {showcased.map((badge) => (
                    <button
                      type="button"
                      data-badge-open={stop.credlyBadges!.indexOf(badge)}
                      aria-label={`View ${badge.name} credential`}
                      class="group/badge flex flex-col items-center gap-2 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)] p-3 text-center transition hover:-translate-y-0.5 hover:border-[var(--color-accent)]"
                    >
                      <img
                        src={badge.img}
                        alt={badge.name}
                        loading="lazy"
                        width="64"
                        height="64"
                        class="h-16 w-16 object-contain drop-shadow-[0_0_10px_var(--color-accent-dim)]"
                      />
                      <span class="line-clamp-2 text-[10px] leading-tight text-[var(--color-muted)] transition group-hover/badge:text-[var(--color-text)]">
                        {badge.name}
                      </span>
                    </button>
                  ))}
                </div>
                {stop.credlyBadges!.length > showcased.length && (
                  <button
                    type="button"
                    data-badge-open="0"
                    class="mt-3 inline-flex items-center gap-1 text-xs text-[var(--color-accent)] underline underline-offset-4"
                  >
                    {ui.careerStop.browseAllBadges.replace('{count}', String(stop.credlyBadges!.length))}
                  </button>
                )}
              </div>
            );
          })()}
        </div>
      </div>
    </dialog>
    )}

    <!-- The badge "carousel": one small dialog per stop, opened at whichever
         index was clicked (a showcase card, or "Browse all" at 0) and
         navigable with ‹ › or the left/right arrow keys. Every click here —
         showcase card or nav arrow — only ever changes what this dialog
         shows; the outbound Credly link only fires when "View on Credly"
         itself is clicked, which is the whole point of routing badges
         through this instead of linking straight out from the main sheet. -->
    {!stop.hidden && stop.credlyBadges && stop.credlyBadges.length > 0 && (
      <dialog
        id={`${modalId}-badges`}
        data-badges={JSON.stringify(stop.credlyBadges)}
        data-profile-url={stop.credlyProfileUrl}
        class="m-auto w-[min(92vw,26rem)] rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-0 text-[var(--color-text)] backdrop:bg-black/70 backdrop:backdrop-blur-sm"
      >
        <div class="flex items-center justify-between border-b border-[var(--color-border)] px-5 py-3">
          <p class="font-mono text-xs uppercase tracking-widest text-[var(--color-accent)]">
            <span data-badge-index>1</span> / {stop.credlyBadges.length}
          </p>
          <form method="dialog">
            <button
              aria-label={ui.common.close}
              class="flex h-7 w-7 items-center justify-center rounded-full bg-[var(--color-border)] text-[var(--color-text)] transition hover:brightness-125"
            >
              ✕
            </button>
          </form>
        </div>
        <div class="flex items-center gap-3 p-6">
          <button
            type="button"
            data-badge-prev
            aria-label={ui.careerStop.previousBadge}
            class="flex h-8 w-8 shrink-0 cursor-pointer items-center justify-center rounded-full border border-[var(--color-border)] text-[var(--color-text)] transition hover:border-[var(--color-accent)]"
          >
            ‹
          </button>
          <div class="flex flex-1 flex-col items-center gap-3">
            <img data-badge-img class="h-36 w-36 object-contain drop-shadow-[0_0_14px_var(--color-accent-dim)]" alt="" />
            <p data-badge-name class="text-center text-sm font-medium text-[var(--color-text)]" />
            <a
              data-badge-link
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 text-xs text-[var(--color-accent)] underline underline-offset-4"
            >
              {ui.careerStop.viewOnCredly}
            </a>
          </div>
          <button
            type="button"
            data-badge-next
            aria-label={ui.careerStop.nextBadge}
            class="flex h-8 w-8 shrink-0 cursor-pointer items-center justify-center rounded-full border border-[var(--color-border)] text-[var(--color-text)] transition hover:border-[var(--color-accent)]"
          >
            ›
          </button>
        </div>
        {stop.credlyProfileUrl && (
          <a
            href={stop.credlyProfileUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="block border-t border-[var(--color-border)] px-5 py-3 text-center text-xs text-[var(--color-muted)] underline underline-offset-4 transition hover:text-[var(--color-accent)]"
          >
            {ui.careerStop.seeFullProfileOnCredly}
          </a>
        )}
      </dialog>
    )}
  </div>
</div>

<script>
  // Wires up every badge gallery on the page (one per career stop with
  // credlyBadges) in one pass — each `[data-badge-gallery]` names its own
  // dialog by id, so this scales to any number of stops without per-stop
  // script duplication.
  document.querySelectorAll<HTMLElement>('[data-badge-gallery]').forEach((gallery) => {
    const dialogId = gallery.dataset.badgeGallery;
    const dialog = dialogId && document.getElementById(dialogId);
    if (!(dialog instanceof HTMLDialogElement)) return;

    const badges: { name: string; img: string; url?: string }[] = JSON.parse(dialog.dataset.badges ?? '[]');
    const profileUrl = dialog.dataset.profileUrl;
    const img = dialog.querySelector<HTMLImageElement>('[data-badge-img]');
    const nameEl = dialog.querySelector<HTMLElement>('[data-badge-name]');
    const indexEl = dialog.querySelector<HTMLElement>('[data-badge-index]');
    const linkEl = dialog.querySelector<HTMLAnchorElement>('[data-badge-link]');
    let current = 0;

    function render() {
      const badge = badges[current];
      if (!badge || !img) return;
      img.src = badge.img;
      img.alt = badge.name;
      if (nameEl) nameEl.textContent = badge.name;
      if (indexEl) indexEl.textContent = String(current + 1);
      // Falls back to the stop's own Credly profile when a badge has no
      // individually-shareable URL of its own — still opens on Credly, just
      // at the profile rather than the one credential.
      const href = badge.url ?? profileUrl;
      if (linkEl) {
        if (href) {
          linkEl.href = href;
          linkEl.hidden = false;
        } else {
          linkEl.hidden = true;
        }
      }
    }

    gallery.querySelectorAll<HTMLButtonElement>('[data-badge-open]').forEach((btn) => {
      btn.addEventListener('click', () => {
        current = Number(btn.dataset.badgeOpen ?? 0);
        render();
        dialog.showModal();
      });
    });

    dialog.querySelector('[data-badge-prev]')?.addEventListener('click', () => {
      current = (current - 1 + badges.length) % badges.length;
      render();
    });
    dialog.querySelector('[data-badge-next]')?.addEventListener('click', () => {
      current = (current + 1) % badges.length;
      render();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') current = (current - 1 + badges.length) % badges.length;
      else if (e.key === 'ArrowRight') current = (current + 1) % badges.length;
      else return;
      render();
    });
  });
</script>
