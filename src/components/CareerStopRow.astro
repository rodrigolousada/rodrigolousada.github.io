---
import { focusCategories } from '../data/site.json';
import { icons } from '../data/icons';
import ProjectRow from './ProjectRow.astro';
import type { HandoffStep } from './PhoneMockup.astro';

interface Props {
  stop: {
    org: string;
    /** Stable anchor used by cross-links (testimonial, "worked at" logos) to scroll to and open this stop. */
    slug?: string;
    title: string;
    logo: string;
    logoScale?: number;
    logoInvert?: boolean;
    chipClass: string;
    period: string;
    role: string;
    kpis: string[];
    /** Personal honors/awards earned during this stop (medals) — distinct from project-level achievements. */
    honors?: { label: string; year?: string; type?: string }[];
    /** Small Credly digital badges to show as a tiny logo strip (IBM, etc). Each links out to its own Credly page for the full-resolution badge. Set `highlight: true` on the handful worth calling out (e.g. AWS) — they render bigger, above the rest. */
    credlyBadges?: { name: string; img: string; url?: string; highlight?: boolean }[];
    credlyProfileUrl?: string;
    /** True while this whole career stop isn't ready to show yet. Renders the row blurred with a "Coming soon" badge; clicking it shakes and flashes red instead of opening a modal — same treatment as a hidden project, see ProjectRow.astro. */
    hidden?: boolean;
    projects: {
      name: string;
      companies?: string[];
      isSideProject?: boolean;
      confidential?: boolean;
      /** True while the project isn't ready to show yet. See ProjectRow.astro for the rendered lock/blur treatment. */
      hidden?: boolean;
      tldr: string;
      description: string;
      myRole?: string;
      technologies: string[];
      achievements: string[];
      demo?: { mode?: string; captions?: string[]; videos?: (string | null)[]; steps?: HandoffStep[] };
      news?: { title: string; source: string; date: string; url: string }[];
      /** External link to the project itself (thesis PDF, publication, live app, etc.). */
      url?: string;
      urlLabel?: string;
    }[];
    focus: Record<string, number>;
  };
  modalId: string;
  /** Draw the connecting rail below this row (default true — set false on the last item in a list). */
  showLine?: boolean;
}

const { stop, modalId, showLine = true } = Astro.props;

// Same "first N, then Show more" pattern as the career timeline and side
// projects grid in Projects.astro — a stop with a long project list (e.g.
// six at IBM Consulting) made the modal itself scroll for a while just to
// reach "Focus this era" and the badges below it.
const visibleProjects = stop.projects.slice(0, 3);
const moreProjects = stop.projects.slice(3);
---

<div class="grid grid-cols-[1.5rem_1fr] gap-4">
  <!-- Rail: dot centers on this row regardless of its height, line bleeds into the gap to meet the next row's dot -->
  <div class="relative">
    {
      showLine && (
        <span class="absolute left-1/2 top-0 h-[calc(100%+1rem)] w-px -translate-x-1/2 bg-[var(--color-border)]" />
      )
    }
    <span class="absolute left-1/2 top-1/2 z-10 h-2.5 w-2.5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-[var(--color-accent)] ring-4 ring-[var(--color-bg)]" />
  </div>

  <div class="min-w-0" id={stop.slug} data-stop-anchor={stop.slug} data-modal-id={modalId}>
    <button
      type="button"
      onclick={stop.hidden ? undefined : `document.getElementById('${modalId}').showModal()`}
      data-locked={stop.hidden ? 'true' : undefined}
      aria-disabled={stop.hidden ? 'true' : undefined}
      class={`group flex w-full items-center gap-4 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-4 text-left transition sm:p-5 ${stop.hidden ? 'hover:border-red-500/60' : 'hover:border-[var(--color-accent)]'}`}
    >
      <div class={`flex min-w-0 flex-1 items-center gap-4 ${stop.hidden ? 'select-none blur-[3px]' : ''}`}>
        <div class={`flex h-12 w-12 shrink-0 items-center justify-center overflow-hidden rounded-lg p-1.5 ${stop.chipClass}`}>
          <img
            src={stop.logo}
            alt={`${stop.org} logo`}
            class={`h-full w-full object-contain ${stop.logoInvert ? 'brightness-0 invert' : ''}`}
            style={stop.logoScale ? `transform: scale(${stop.logoScale})` : undefined}
          />
        </div>

        <div class="min-w-0 flex-1">
          <p class="font-semibold text-[var(--color-text)]">{stop.title}</p>
          <p class="text-xs text-[var(--color-muted)]">
            {stop.org}
            <!-- Block below sm, not left to wrap inline: on narrow screens a
                 long org name (e.g. "Instituto de Telecomunicações") pushed
                 this onto multiple lines anyway, and plain word-wrap was
                 splitting mid-date ("· 2018" / "– 2020") wherever it ran out
                 of room. Forcing the period onto its own line keeps it whole. -->
            <span class="block sm:inline">· {stop.period}</span>
          </p>
        </div>
      </div>

      {stop.hidden ? (
        <span class="flex shrink-0 items-center gap-1.5 rounded-full border border-[var(--color-border)] bg-[var(--color-bg)] px-2.5 py-1 font-mono text-[10px] uppercase tracking-wide text-[var(--color-muted)]">
          <svg viewBox="0 0 24 24" class="h-3 w-3 fill-current">
            <path d={icons.lock} />
          </svg>
          Coming soon
        </span>
      ) : (
        <span class="shrink-0 font-mono text-xs text-[var(--color-muted)] transition group-hover:text-[var(--color-accent)]">
          View →
        </span>
      )}
    </button>

    <!-- sm:max-h-[85vh], not left uncapped: without it, a stop with enough
         content (KPIs, projects, badges) grows the dialog right up to the
         browser's own near-100%-of-viewport default on laptop widths too,
         reading as another full-screen popup rather than a compact card
         that happens to scroll.

         sm:h-fit, not sm:h-auto: a native <dialog>'s default `showModal()`
         centering pins both `top` and `bottom` to 0 (see the UA
         stylesheet's `dialog:modal { inset-block: 0 }`), and `height: auto`
         against two pinned edges resolves to stretch-to-fill, not
         shrink-to-content: a short stop was rendering at the full
         sm:max-h-[85vh] cap instead of its own (much shorter) content
         height. `fit-content` explicitly asks for shrink-to-fit sizing
         regardless of that stretch context, so a short stop sizes to its
         own content and a long one still clamps at the cap and scrolls,
         exactly as before.

         Not rendered at all when stop.hidden — same reasoning as a hidden
         project's dialog (ProjectRow.astro): the stop's real KPIs/projects
         shouldn't reach the page's HTML unopened. -->
    {!stop.hidden && (
    <dialog
      id={modalId}
      class="h-dvh w-full max-w-full rounded-none border-0 m-0 bg-[var(--color-surface)] p-0 text-[var(--color-text)] backdrop:bg-black/60 backdrop:backdrop-blur-sm sm:m-auto sm:h-fit sm:max-h-[85vh] sm:w-[min(92vw,40rem)] sm:rounded-xl sm:border sm:border-[var(--color-border)]"
    >
      <div class="overflow-hidden rounded-none sm:rounded-xl">
        <div class={`relative flex h-24 items-center justify-center overflow-hidden ${stop.chipClass}`}>
          <img
            src={stop.logo}
            alt={`${stop.org} logo`}
            class={`h-10 w-auto object-contain ${stop.logoInvert ? 'brightness-0 invert' : ''}`}
            style={stop.logoScale ? `transform: scale(${stop.logoScale})` : undefined}
          />
          <form method="dialog" class="absolute right-3 top-3">
            <button
              aria-label="Close"
              class="flex h-7 w-7 items-center justify-center rounded-full bg-black/30 text-white transition hover:bg-black/50"
            >
              ✕
            </button>
          </form>
        </div>

        <div class="p-6">
          <div class="mb-1 flex flex-wrap items-center gap-x-3 gap-y-1">
            <span class="text-sm font-medium text-[var(--color-text)]">{stop.org}</span>
            <span class="text-sm text-[var(--color-muted)]">· {stop.period}</span>
          </div>
          <p class="text-[var(--color-muted)]">{stop.role}</p>

          <div
            class={`mt-8 gap-x-8 gap-y-8 ${stop.honors && stop.honors.length > 0 ? 'grid sm:grid-cols-[2fr_1fr]' : ''}`}
          >
            <div>
              <p class="text-xs font-medium uppercase tracking-wide text-[var(--color-accent)]">KPIs</p>
              <ul class="mt-3 space-y-2">
                {stop.kpis.map((kpi) => (
                  <li class="flex gap-2 text-[var(--color-text)]">
                    <span class="text-[var(--color-accent)]">▸</span>
                    <span>{kpi}</span>
                  </li>
                ))}
              </ul>
            </div>

            {stop.honors && stop.honors.length > 0 && (
              <div>
                <p class="text-xs font-medium uppercase tracking-wide text-[var(--color-accent)]">
                  Achievements
                </p>
                <div class="mt-3 flex flex-wrap gap-5">
                  {stop.honors.map((honor) => {
                    const isTrophy = honor.type === 'trophy';
                    const ringClass = isTrophy
                      ? 'border-amber-400/40 bg-amber-400/10'
                      : 'border-[var(--color-accent)]/40 bg-[var(--color-accent)]/10';
                    const ribbonClass = isTrophy ? 'bg-amber-400/30' : 'bg-[var(--color-accent)]/30';
                    return (
                      <div class="flex w-20 flex-col items-center gap-2 text-center">
                        <div class={`relative flex h-12 w-12 shrink-0 items-center justify-center rounded-full border-2 ${ringClass}`}>
                          {isTrophy ? (
                            <svg viewBox="0 0 24 24" class="h-6 w-6 fill-amber-400">
                              <path d="M7 4h10l-3 8h-4z" />
                              <path d="M6 5L3.5 5L3.5 8.5L6 9.5Z" />
                              <path d="M18 5L20.5 5L20.5 8.5L18 9.5Z" />
                              <rect x="11" y="12" width="2" height="3" />
                              <rect x="9" y="15" width="6" height="2" />
                              <rect x="7.5" y="17.25" width="9" height="1.75" rx="0.6" />
                            </svg>
                          ) : (
                            <svg viewBox="0 0 24 24" class="h-6 w-6 fill-[var(--color-accent)]">
                              <path d={icons.star} />
                            </svg>
                          )}
                          <span
                            class={`absolute -bottom-1 left-1/2 h-3 w-2.5 -translate-x-[10px] rotate-[20deg] ${ribbonClass}`}
                            style="clip-path: polygon(0 0, 100% 0, 60% 100%)"
                          />
                          <span
                            class={`absolute -bottom-1 left-1/2 h-3 w-2.5 translate-x-px -rotate-[20deg] ${ribbonClass}`}
                            style="clip-path: polygon(0 0, 100% 0, 40% 100%)"
                          />
                        </div>
                        <p class="text-[11px] leading-tight text-[var(--color-text)]">{honor.label}</p>
                        {honor.year && <p class="text-[10px] text-[var(--color-muted)]">{honor.year}</p>}
                      </div>
                    );
                  })}
                </div>
              </div>
            )}
          </div>

          <p class="mt-8 text-xs font-medium uppercase tracking-wide text-[var(--color-accent)]">Projects</p>
          <div class="mt-3 space-y-2">
            {visibleProjects.map((project, pi) => (
              <ProjectRow project={project} modalId={`${modalId}-project-${pi}`} />
            ))}
          </div>

          {moreProjects.length > 0 && (
            <details class="group/projectsmore mt-2">
              <summary class="flex cursor-pointer list-none items-center gap-2 py-1 font-mono text-xs text-[var(--color-muted)] transition hover:text-[var(--color-accent)] [&::-webkit-details-marker]:hidden">
                <span class="inline-block transition group-open/projectsmore:rotate-90">▸</span>
                View more
              </summary>
              <div class="mt-2 space-y-2">
                {moreProjects.map((project, pi) => (
                  <ProjectRow project={project} modalId={`${modalId}-project-${pi + visibleProjects.length}`} />
                ))}
              </div>
            </details>
          )}

          <p class="mb-3 mt-8 text-xs font-medium uppercase tracking-wide text-[var(--color-accent)]">
            Focus this era
          </p>
          <div class="flex h-5 w-full overflow-hidden rounded-full bg-[var(--color-border)]">
            {focusCategories
              .filter((cat) => (stop.focus[cat.id] ?? 0) > 0)
              .map((cat, ci, arr) => {
                const value = stop.focus[cat.id] ?? 0;
                const rounding =
                  (ci === 0 ? 'rounded-l-full ' : '') + (ci === arr.length - 1 ? 'rounded-r-full' : '');
                return (
                  <div
                    class={`flex items-center justify-center ${rounding}`}
                    style={`width:${value}%; background-color:${cat.color}; margin-right:${ci === arr.length - 1 ? 0 : '2px'};`}
                    title={`${cat.label}: ${value}%`}
                  >
                    {value >= 15 && <span class="select-none text-[9px] font-semibold text-white">{value}%</span>}
                  </div>
                );
              })}
          </div>
          <div class="mt-4 flex flex-wrap gap-x-4 gap-y-1.5">
            {focusCategories
              .filter((cat) => (stop.focus[cat.id] ?? 0) > 0)
              .map((cat) => (
                <div class="flex items-center gap-1.5">
                  <span class="h-2 w-2 shrink-0 rounded-sm" style={`background-color:${cat.color};`} />
                  <span class="text-[11px] text-[var(--color-muted)]">{cat.label}</span>
                </div>
              ))}
          </div>

          {stop.credlyBadges && stop.credlyBadges.length > 0 && (
            <div>
              <p class="mb-3 mt-8 text-xs font-medium uppercase tracking-wide text-[var(--color-accent)]">
                Badges
              </p>
              {(() => {
                const highlighted = stop.credlyBadges!.filter((b) => b.highlight);
                const rest = stop.credlyBadges!.filter((b) => !b.highlight);
                return (
                  <>
                    {highlighted.length > 0 && (
                      <div class="mb-3 flex flex-wrap gap-3">
                        {highlighted.map((badge) => (
                          <a
                            href={badge.url ?? stop.credlyProfileUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={`View ${badge.name} on Credly`}
                            title={badge.name}
                            class="transition hover:scale-105"
                          >
                            <img
                              src={badge.img}
                              alt={badge.name}
                              loading="lazy"
                              width="80"
                              height="80"
                              class="h-20 w-20 object-contain drop-shadow-[0_0_10px_var(--color-accent-dim)]"
                            />
                          </a>
                        ))}
                      </div>
                    )}
                    {rest.length > 0 && (
                      <div class="flex flex-wrap gap-2">
                        {rest.map((badge) => (
                          <a
                            href={badge.url ?? stop.credlyProfileUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={`View ${badge.name} on Credly`}
                            title={badge.name}
                            class="transition hover:scale-105"
                          >
                            <img
                              src={badge.img}
                              alt={badge.name}
                              loading="lazy"
                              width="40"
                              height="40"
                              class="h-10 w-10 object-contain opacity-80"
                            />
                          </a>
                        ))}
                      </div>
                    )}
                  </>
                );
              })()}
              {stop.credlyProfileUrl && (
                <a
                  href={stop.credlyProfileUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-2 inline-block text-xs text-[var(--color-accent)] underline underline-offset-4"
                >
                  See all badges on Credly →
                </a>
              )}
            </div>
          )}
        </div>
      </div>
    </dialog>
    )}
  </div>
</div>
