---
import { focusCategories } from '../data/site.json';
import ProjectRow from './ProjectRow.astro';

interface Props {
  stop: {
    org: string;
    title: string;
    logo: string;
    logoScale?: number;
    logoInvert?: boolean;
    chipClass: string;
    period: string;
    role: string;
    kpis: string[];
    projects: {
      name: string;
      companies?: string[];
      isSideProject?: boolean;
      tldr: string;
      description: string;
      technologies: string[];
      achievements: string[];
      news?: { title: string; source: string; date: string; url: string };
    }[];
    stack: string[];
    focus: Record<string, number>;
  };
  modalId: string;
}

const { stop, modalId } = Astro.props;
---

<div class="relative">
  <span class="absolute -left-[31px] top-6 h-3 w-3 -translate-x-1/2 rounded-full border-2 border-[var(--color-bg)] bg-[var(--color-accent)] sm:-left-[39px]" />

  <button
    type="button"
    onclick={`document.getElementById('${modalId}').showModal()`}
    class="group flex w-full items-center gap-4 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-4 text-left transition hover:border-[var(--color-accent)] sm:p-5"
  >
    <div class={`flex h-12 w-12 shrink-0 items-center justify-center rounded-lg p-1.5 ${stop.chipClass}`}>
      <img
        src={stop.logo}
        alt={`${stop.org} logo`}
        class={`h-full w-full object-contain ${stop.logoInvert ? 'brightness-0 invert' : ''}`}
        style={stop.logoScale ? `transform: scale(${stop.logoScale})` : undefined}
      />
    </div>

    <div class="min-w-0 flex-1">
      <p class="font-semibold text-[var(--color-text)]">{stop.title}</p>
      <p class="text-xs text-[var(--color-muted)]">{stop.org} · {stop.period}</p>
    </div>

    <span class="shrink-0 font-mono text-xs text-[var(--color-muted)] transition group-hover:text-[var(--color-accent)]">
      View →
    </span>
  </button>

  <dialog
    id={modalId}
    class="m-auto w-[min(90vw,32rem)] rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-0 text-[var(--color-text)] backdrop:bg-black/60 backdrop:backdrop-blur-sm"
  >
    <div class="overflow-hidden rounded-xl">
      <div class={`relative flex h-24 items-center justify-center ${stop.chipClass}`}>
        <img
          src={stop.logo}
          alt={`${stop.org} logo`}
          class={`h-10 w-auto object-contain ${stop.logoInvert ? 'brightness-0 invert' : ''}`}
          style={stop.logoScale ? `transform: scale(${stop.logoScale})` : undefined}
        />
        <form method="dialog" class="absolute right-3 top-3">
          <button
            aria-label="Close"
            class="flex h-7 w-7 items-center justify-center rounded-full bg-black/30 text-white transition hover:bg-black/50"
          >
            ✕
          </button>
        </form>
      </div>

      <div class="p-6">
        <div class="mb-1 flex flex-wrap items-center gap-x-3 gap-y-1">
          <span class="text-sm font-medium text-[var(--color-text)]">{stop.org}</span>
          <span class="text-sm text-[var(--color-muted)]">· {stop.period}</span>
        </div>
        <p class="text-[var(--color-muted)]">{stop.role}</p>

        <p class="mt-4 text-xs font-medium uppercase tracking-wide text-[var(--color-accent)]">KPIs</p>
        <ul class="mt-2 space-y-1.5">
          {stop.kpis.map((kpi) => (
            <li class="flex gap-2 text-[var(--color-text)]">
              <span class="text-[var(--color-accent)]">▸</span>
              <span>{kpi}</span>
            </li>
          ))}
        </ul>

        <p class="mt-4 text-xs font-medium uppercase tracking-wide text-[var(--color-accent)]">Projects</p>
        <div class="mt-2 space-y-2">
          {stop.projects.map((project, pi) => (
            <ProjectRow project={project} modalId={`${modalId}-project-${pi}`} />
          ))}
        </div>

        <div class="mt-5 flex flex-wrap gap-2">
          {stop.stack.map((tech) => (
            <span class="rounded border border-[var(--color-border)] px-2 py-0.5 font-mono text-xs text-[var(--color-muted)]">
              {tech}
            </span>
          ))}
        </div>

        <p class="mb-2 mt-5 text-xs font-medium uppercase tracking-wide text-[var(--color-accent)]">
          Focus this era
        </p>
        <div class="flex h-5 w-full overflow-hidden rounded-full bg-[var(--color-border)]">
          {focusCategories
            .filter((cat) => (stop.focus[cat.id] ?? 0) > 0)
            .map((cat, ci, arr) => {
              const value = stop.focus[cat.id] ?? 0;
              const rounding =
                (ci === 0 ? 'rounded-l-full ' : '') + (ci === arr.length - 1 ? 'rounded-r-full' : '');
              return (
                <div
                  class={`flex items-center justify-center ${rounding}`}
                  style={`width:${value}%; background-color:${cat.color}; margin-right:${ci === arr.length - 1 ? 0 : '2px'};`}
                  title={`${cat.label}: ${value}%`}
                >
                  {value >= 15 && <span class="select-none text-[9px] font-semibold text-white">{value}%</span>}
                </div>
              );
            })}
        </div>
        <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1.5">
          {focusCategories.map((cat) => (
            <div class="flex items-center gap-1.5">
              <span class="h-2 w-2 shrink-0 rounded-sm" style={`background-color:${cat.color};`} />
              <span class="text-[11px] text-[var(--color-muted)]">{cat.label}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </dialog>
</div>
