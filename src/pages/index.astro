---
// The default locale's homepage, served unprefixed at "/". Every other
// language in site.json gets its own page at "/<locale>/" instead — see
// src/pages/[locale]/index.astro. Both just render HomePage with a
// different locale; the actual markup lives there.
import HomePage from '../components/HomePage.astro';
import { defaultLocale } from '../data/site';
---

<HomePage locale={defaultLocale} />
