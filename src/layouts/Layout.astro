---
import '../styles/global.css';
import { getSite, locales, defaultLocale, type Locale } from '../data/site';
import { localePath } from '../data/languages';
import AmbientBackground from '../components/AmbientBackground.astro';
import EngagementPrompt from '../components/EngagementPrompt.astro';
import ProjectDeepLink from '../components/ProjectDeepLink.astro';
import ImageLightbox from '../components/ImageLightbox.astro';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
}

const { locale, title, description } = Astro.props;
const site = getSite(locale);
const resolvedTitle = title ?? site.site.title;
const resolvedDescription = description ?? site.site.description;

// Where each language's homepage lives, for the inline redirect script
// below — built once here so that script never has to guess a URL shape.
const localePaths = Object.fromEntries(locales.map((loc) => [loc, localePath(loc, defaultLocale)]));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.hero.name,
  jobTitle: site.site.jobTitle,
  url: site.site.url,
  email: `mailto:${site.site.email}`,
  sameAs: [site.site.github, site.site.linkedin],
  worksFor: {
    '@type': 'Organization',
    name: site.site.worksFor,
  },
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- A returning visitor who's picked a language before (via the nav's
         selector, see LanguageSelector.astro) should land straight on it,
         even from a bare "/" link — this is the only place that decision
         gets made. Deliberately NOT browser-language detection: a first-time
         visitor with no stored choice always gets English, full stop, no
         Accept-Language/navigator.language sniffing anywhere. Inline and
         synchronous, as early in <head> as possible, so a redirect (rare —
         only fires for a non-English preference) happens before anything
         has rendered, rather than as a flash of English first. -->
    <script is:inline define:vars={{ localePaths, locale }}>
      try {
        const preferred = localStorage.getItem('preferredLocale');
        const target = preferred && preferred !== locale ? localePaths[preferred] : null;
        if (target) location.replace(target + location.hash);
      } catch {
        // localStorage unavailable (private mode, disabled, etc) — falls
        // back to whatever locale this page actually is, i.e. English.
      }
    </script>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{resolvedTitle}</title>
    <meta name="description" content={resolvedDescription} />

    <link rel="canonical" href={Astro.url.href} />
    {locales.length > 1 &&
      locales.map((loc) => (
        <link rel="alternate" hreflang={loc} href={`${site.site.url}${localePath(loc, defaultLocale)}`} />
      ))}

    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={resolvedTitle} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:image" content={`${site.site.url}${site.hero.photo}`} />
    <meta name="twitter:card" content="summary" />

    <!-- Hero's own photo is the page's LCP (largest contentful paint)
         candidate on most viewports — it's the first real image in the
         DOM and above the fold everywhere. Preloading it (rather than
         waiting for the browser's preload scanner to reach Hero.astro's
         own <img>, several sections down in the HTML) shaves the one
         round-trip that actually gates LCP. Safe to hardcode `as="image"`
         since it's always a raster file (webp), never swapped for an SVG. -->
    <link rel="preload" as="image" href={site.hero.photo} fetchpriority="high" />

    <!-- Fonts (Inter, Space Grotesk, Source Serif 4, Press Start 2P) are
         self-hosted — see src/styles/fonts.css for why (removes a GDPR-
         relevant request to Google on every page load) and how. It's
         `@import`-ed from global.css, which this file already imports up
         in its frontmatter, so Vite bundles it into the page's own
         stylesheet automatically — no separate <link> needed here.
         `font-display: optional` there gives each webfont a short window
         to be ready before first paint and otherwise keeps the fallback
         for that visit — no later swap/jump once it does load — so there's
         no preload/print-media trick needed either: the files are
         same-origin and small (~155KB total across all five), not a
         render-blocking cross-origin round-trip to Google's server on a
         cold cache. -->

    <!-- The `<` escape below is the standard guard for inline JSON: without
         it, a literal "</script>" inside any interpolated site.json field
         (unlikely today, but not something JSON.stringify itself rules out)
         would close this tag early and let whatever followed be parsed as
         HTML instead of JSON-LD. -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')}
      is:inline
    />
  </head>
  <body class="font-sans antialiased">
    <!-- Center-out loading bar (styles + keyframes in global.css). First
         thing in <body> so it paints before AmbientBackground's blobs or
         anything in `<slot />` — a plain element with a pure-CSS animation,
         it doesn't wait on this file's own scripts, Hero's photo, or
         anything else to show up. The script right below removes it once
         `load` fires; see there for why `load` and not `DOMContentLoaded`. -->
    <div id="page-loading-bar" class="page-loading-bar" aria-hidden="true">
      <span class="page-loading-bar__pulse"></span>
    </div>
    <AmbientBackground />
    <slot />
    <EngagementPrompt locale={locale} />
    <ProjectDeepLink />
    <ImageLightbox locale={locale} />
  </body>
</html>

<script>
  // Hides the center-out loading bar (`#page-loading-bar`, right after
  // <body> above; styles/keyframes in global.css) once the page has
  // actually finished loading. `load`, not `DOMContentLoaded` — this
  // should stay up through image/font/video fetches, not disappear the
  // moment the HTML itself is parsed. `data-loaded` (rather than removing
  // the element outright) just triggers the opacity transition already
  // defined in CSS; the bar is `pointer-events: none` either way, so
  // leaving it in the DOM costs nothing.
  //
  // No `prefers-reduced-motion` branching needed here — that's handled
  // entirely in CSS (see the media query next to the keyframes), same
  // split as `FocusHistoryChart.astro`'s `REDUCED_MOTION` constant for a
  // JS-driven animation vs. this one, which never leaves CSS.
  //
  // The `readyState` check covers the (rare) case this script only starts
  // running once `load` has already fired — e.g. a bfcache restore, or a
  // slow-to-parse page where by the time this runs everything is already
  // in — since no future 'load' event would come to hide the bar otherwise.
  const loadingBar = document.getElementById('page-loading-bar');
  if (loadingBar) {
    const hideLoadingBar = () => loadingBar.setAttribute('data-loaded', '');
    if (document.readyState === 'complete') hideLoadingBar();
    else window.addEventListener('load', hideLoadingBar, { once: true });
  }
</script>

<script>
  // Intercept plain same-page anchor links site-wide (nav, "Get in touch"
  // buttons, the "What's next?" card, etc.) and scroll to the target
  // ourselves instead of letting the browser navigate to the hash — that
  // native navigation is what was leaving "#contact" (or "#projects", ...)
  // stuck in the address bar after every jump. `scroll-behavior: smooth`
  // in global.css still applies to this JS-driven scroll, so it looks the
  // same as before, just without touching the URL.
  //
  // This only ever matches an `<a href="#id">`, so it doesn't interfere
  // with Organizations.astro's own cross-link "jump" (that one scrolls
  // manually via buttons, never a hash link) or the nested-modal "← Back"
  // buttons (`<form method="dialog">`, not anchors).
  document.addEventListener('click', (e) => {
    const link = (e.target as HTMLElement)?.closest<HTMLAnchorElement>('a[href^="#"]');
    if (!link) return;
    const id = link.getAttribute('href')?.slice(1);
    if (!id) return;
    const target = document.getElementById(id);
    if (!target) return;
    e.preventDefault();
    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
</script>

<script>
  // Every expandable section (career stops, projects, side-project
  // cartridges, testimonials, the CliftonStrengths certificate) uses a
  // native <dialog>. Reopening one should always feel like the first time:
  // scrolled back to the top, not wherever it was left scrolled to on a
  // previous viewing. A native <dialog> fires no event when it opens (only
  // 'close'), so a MutationObserver on its `open` attribute is the only
  // reliable way to know either transition happened. Re-dispatched as
  // bubbling custom events so any component's own script (PhoneMockup's,
  // for instance, to restart its video/animation from the beginning) can
  // react without needing a direct reference to this one, same
  // delegated-listener style used elsewhere on the site.
  document.querySelectorAll('dialog').forEach((dialog) => {
    new MutationObserver(() => {
      const type = dialog.hasAttribute('open') ? 'dialogopen' : 'dialogclose';
      dialog.dispatchEvent(new CustomEvent(type, { bubbles: true }));
    }).observe(dialog, { attributes: true, attributeFilter: ['open'] });
  });

  document.addEventListener('dialogopen', (e) => {
    const dialog = e.target as HTMLElement;
    dialog.scrollTop = 0;
    // Most dialogs scroll via their own box (see the `h-fit`/`max-h`
    // comments on CareerStopRow/ProjectRow/TechStack's dialogs), but a
    // couple (the testimonial letter, the CliftonStrengths certificate)
    // scroll an inner `overflow-y-auto` div instead, so reset whichever one
    // actually has the scroll position.
    dialog.querySelectorAll<HTMLElement>('[class*="overflow-y-auto"]').forEach((el) => {
      el.scrollTop = 0;
    });
  });
</script>

<script>
  // Background-scroll lock: with a dialog open (especially the mobile
  // bottom sheets below), a touch dragging on the page behind it used to
  // scroll the page itself — nothing was stopping that touch from reaching
  // it. Ref-counted rather than a plain boolean so a dialog opening on top
  // of another already-open one (the image lightbox over a project's
  // detail dialog, for instance) doesn't have the first one's close
  // re-enable scrolling while the second is still up.
  let openDialogCount = 0;
  document.addEventListener('dialogopen', () => {
    openDialogCount++;
    if (openDialogCount === 1) document.body.style.overflow = 'hidden';
  });
  document.addEventListener('dialogclose', () => {
    openDialogCount = Math.max(0, openDialogCount - 1);
    if (openDialogCount === 0) document.body.style.overflow = '';
  });

  // Swipe-down-to-dismiss for every mobile bottom sheet, generically: any
  // dialog with a `[data-sheet-handle]` element (see CareerStopRow's dialog
  // for the fullest comment on the sheet styling itself) gets this wired up
  // automatically, no per-component script needed. The handle is `sm:hidden`
  // in every dialog that has one — only mobile renders it as a bottom sheet
  // in the first place, so there's nothing to grab at sm: and up and this
  // simply never triggers there.
  //
  // Pointer Events (not touch/mouse separately) so mouse-drag works too for
  // free. `setPointerCapture` keeps move/up events coming to the handle even
  // once the finger has moved past its small hit area.
  const DISMISS_DISTANCE = 120; // px dragged down
  const DISMISS_VELOCITY = 0.5; // px/ms, for a fast flick that didn't quite reach DISMISS_DISTANCE

  document.querySelectorAll<HTMLElement>('[data-sheet-handle]').forEach((handle) => {
    const dialog = handle.closest('dialog');
    if (!dialog) return;

    let startY = 0;
    let startTime = 0;
    let dragging = false;

    function reset() {
      dialog!.style.transition = '';
      dialog!.style.transform = '';
    }

    handle.addEventListener('pointerdown', (e) => {
      dragging = true;
      startY = e.clientY;
      startTime = e.timeStamp;
      dialog!.style.transition = 'none';
      handle.setPointerCapture(e.pointerId);
    });

    handle.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const delta = Math.max(0, e.clientY - startY); // only follow downward drag
      dialog!.style.transform = `translateY(${delta}px)`;
    });

    function finishDrag(e: PointerEvent) {
      if (!dragging) return;
      dragging = false;
      const delta = Math.max(0, e.clientY - startY);
      const elapsed = Math.max(1, e.timeStamp - startTime);
      const velocity = delta / elapsed;
      dialog!.style.transition = 'transform 0.2s ease-out';
      if (delta > DISMISS_DISTANCE || velocity > DISMISS_VELOCITY) {
        dialog!.style.transform = `translateY(100%)`;
        setTimeout(() => dialog!.close(), 200);
      } else {
        dialog!.style.transform = '';
      }
    }

    handle.addEventListener('pointerup', finishDrag);
    handle.addEventListener('pointercancel', finishDrag);
    // Reopening should never start mid-drag-away from a previous dismiss
    // that got interrupted, or with a stale transform left over.
    dialog.addEventListener('dialogclose', reset);

    // A genuinely quick swipe down also dismisses the sheet from anywhere on
    // it, not just the handle — someone flicking a thumb down from the
    // middle of a card shouldn't have to find the grab bar first. This can't
    // just widen the handle's own drag zone to the whole sheet, though:
    // most of a sheet's body either scrolls (an `overflow-y-auto` div, or
    // the dialog itself) or holds tappable content, and live-following the
    // finger with `translateY` the way the handle does would fight both —
    // every scroll attempt would look like the sheet was being dragged off.
    // So this only judges the gesture once it's over, and gates it two ways
    // first so it only catches the flick it's meant to:
    //  - the pointer has to have gone down already at the top of whichever
    //    scrollable box it landed in (or a non-scrolling one) — mid-scroll,
    //    a fast swipe down just means "scroll back up", the single most
    //    common gesture on a long list, and treating that as "close" would
    //    be maddening.
    //  - the motion has to read as a flick, not a drag: past the same
    //    velocity bar as the handle, mostly vertical rather than a diagonal
    //    or horizontal gesture that happens to end lower than it started,
    //    and past a small minimum distance so an ordinary fast tap (~0px in
    //    ~1ms, which is technically an "infinite" velocity) never counts.
    //  - `getComputedStyle(handle).display === 'none'` skips all of this at
    //    sm: and up, where this isn't a bottom sheet at all — a mouse-drag
    //    flick on a centered desktop dialog shouldn't dismiss it.
    //  - on a genuinely scrollable sheet (the "All Technologies" list is the
    //    one long enough to matter), reaching the top at all is itself
    //    usually the tail end of a fling — inertial scrolling keeps firing
    //    `scroll` events for a bit after the finger lifts, including the
    //    little rubber-band snap-back once it hits the top edge. A second
    //    quick flick thrown in right then reads, physically, as exactly the
    //    same gesture as "scroll further toward the top" — it's only once
    //    that settling has genuinely stopped that a fresh swipe down can
    //    mean "close" instead. So a new touch starting within
    //    SCROLL_SETTLE_MS of the last `scroll` event on this sheet's
    //    scrollable box never starts tracking at all, no matter where its
    //    scrollTop lands — it's left to behave as whatever plain scroll/
    //    bounce gesture it would anyway. Repeated fast swipes to climb a
    //    long list therefore never mis-fire a close, but pausing for a
    //    beat once you're at the top and then swiping again does.
    const QUICK_SWIPE_MIN_DISTANCE = 24; // px, floors out a plain tap
    const SCROLL_SETTLE_MS = 250;

    let anywhereStartX = 0;
    let anywhereStartY = 0;
    let anywhereStartTime = 0;
    let anywhereTracking = false;
    let anywhereScrollEl: Element | null = null;
    let lastScrollAt = 0;

    // Capture phase, not bubble: `scroll` doesn't bubble, so a listener on
    // the dialog only sees it for scrolling on the dialog itself unless it's
    // registered to run on the way down instead — that still fires for the
    // nested `overflow-y-auto` div's own scroll events (or the dialog's, if
    // it's the one scrolling directly, as on the non-list sheets).
    dialog.addEventListener('scroll', () => { lastScrollAt = performance.now(); }, true);

    dialog.addEventListener('pointerdown', (e) => {
      if (e.target === handle || handle.contains(e.target as Node)) return; // the handle already has its own live-drag handler above
      if (getComputedStyle(handle).display === 'none') return;
      const scrollEl = (e.target as HTMLElement).closest?.('[class*="overflow-y-auto"]') ?? dialog;
      if (scrollEl.scrollTop > 0) return;
      if (performance.now() - lastScrollAt < SCROLL_SETTLE_MS) return; // still mid fling/bounce, not a deliberate second swipe
      anywhereTracking = true;
      anywhereStartX = e.clientX;
      anywhereStartY = e.clientY;
      anywhereStartTime = e.timeStamp;
      anywhereScrollEl = scrollEl;
    });

    function finishAnywhereSwipe(e: PointerEvent) {
      if (!anywhereTracking) return;
      anywhereTracking = false;
      if (!dialog!.hasAttribute('open')) return; // closed some other way mid-gesture
      if (anywhereScrollEl && anywhereScrollEl.scrollTop > 0) return; // scrolled away from the top during the gesture itself
      const dy = e.clientY - anywhereStartY;
      const dx = Math.abs(e.clientX - anywhereStartX);
      const elapsed = Math.max(1, e.timeStamp - anywhereStartTime);
      const velocity = dy / elapsed;
      if (dy > QUICK_SWIPE_MIN_DISTANCE && dy > dx && velocity > DISMISS_VELOCITY) {
        dialog!.style.transition = 'transform 0.2s ease-out';
        dialog!.style.transform = `translateY(100%)`;
        setTimeout(() => dialog!.close(), 200);
      }
    }

    dialog.addEventListener('pointerup', finishAnywhereSwipe);
    dialog.addEventListener('pointercancel', finishAnywhereSwipe);

    // The pointer-based version above is a poor fit for a genuinely
    // scrollable panel specifically (the "All Technologies" list is the one
    // long enough to hit this): the instant a touch starts moving over a
    // scrollable box, the browser hands the gesture to its own native
    // scrolling and fires `pointercancel` right then — usually well before
    // the finger has covered QUICK_SWIPE_MIN_DISTANCE — so a real fling
    // over the list's own content almost never reads back enough movement
    // to pass that check, no matter how deliberate it was.
    //
    // iOS's own elastic overscroll already tracks exactly the gesture being
    // asked for here, and it isn't subject to that same handoff: pulling
    // down once a box is already scrolled to the top runs its `scrollTop`
    // negative (the rubber-band stretch), and it springs back on its own if
    // released early. Only past a firm threshold — a deliberate continued
    // pull, well beyond the mild overshoot an ordinary momentum scroll
    // settles with by itself — does that count as "close this", so climbing
    // a long list with repeated fast swipes up to the top never mis-fires
    // it: each of those only nudges scrollTop down toward 0, never past it,
    // unless the last one is genuinely held and pulled on beyond the top.
    //
    // The scrollable box isn't always a nested `overflow-y-auto` div either
    // — CareerStopRow/ProjectRow's dialogs have no such div, they scroll the
    // `<dialog>` element itself (its `overflow-y` comes out `auto` by
    // default once it's showing modal, no class needed), so that's just as
    // much a target here as any inner one.
    //
    // The 60px distance threshold alone still wasn't enough, though: a hard,
    // stressed flick — the kind thrown out repeatedly just to climb a long
    // list back to the top faster — can carry enough momentum to overshoot
    // past it in the very same bounce that brought it to the top, even
    // though nothing about it was meant as a dismiss.
    //
    // What actually tells the two apart isn't the pull itself, it's what
    // came immediately before it: a fling that carries straight through the
    // top and into overscroll is still one continuous motion, so the
    // `scroll` events leading into it are only milliseconds apart; someone
    // who scrolls up, actually reaches the top, and stops moving there
    // produces no `scroll` events at all while they're paused — real
    // silence, not just a slower fling. So instead of judging the pull's own
    // depth or duration, this watches the *gap before* it: the moment the
    // box first goes negative after having been at/above the top, it checks
    // how long it had been since the previous `scroll` event on this box.
    // Only a gap of a full second or more "arms" this particular excursion
    // below the top as a real dismiss attempt — armed or not, that state
    // then holds for as long as the box stays negative (so a slow drag that
    // takes several small `scroll` events to cross -60px doesn't have to
    // re-qualify at every step), and clears the moment it comes back up to
    // the top so the next excursion has to earn it again on its own. A rapid
    // sequence of swipe-up-then-bounce cycles therefore never arms, no
    // matter how deep any single bounce goes — but scroll to the top, stop
    // for a beat, then swipe down again, and that fresh pull past -60px
    // closes it immediately, no extra holding required.
    //
    // The initial state (right after the dialog opens, before any scrolling
    // has happened at all) counts as already having rested at the top long
    // enough — so a sheet can still be swiped away the instant it opens, the
    // same as it always could; the gate only ever kicks in once there's
    // been real scrolling to climb back up from.
    const OVERSCROLL_DISMISS_PX = 60;
    const OVERSCROLL_REST_MS = 1000;
    let overscrollDismissing = false;
    const overscrollTargets = new Set<HTMLElement>([dialog, ...dialog.querySelectorAll<HTMLElement>('[class*="overflow-y-auto"]')]);
    overscrollTargets.forEach((scrollEl) => {
      let prevScrollTop = 0;
      let lastEventAt = performance.now() - OVERSCROLL_REST_MS;
      let armed = false;

      scrollEl.addEventListener('scroll', () => {
        const now = performance.now();
        const current = scrollEl.scrollTop;

        if (prevScrollTop >= 0 && current < 0) {
          // Just dipped below the top — decide right now, once, whether
          // this excursion follows a real pause or is a continuation of
          // whatever motion was already happening.
          armed = now - lastEventAt >= OVERSCROLL_REST_MS;
        } else if (current >= 0) {
          // Back at (or never left) the top — nothing to arm.
          armed = false;
        }
        // else: still within the same below-top excursion — leave `armed`
        // as this excursion already decided, regardless of this event's own
        // gap from the last.

        if (armed && !overscrollDismissing && current <= -OVERSCROLL_DISMISS_PX) {
          overscrollDismissing = true;
          dialog!.style.transition = 'transform 0.2s ease-out';
          dialog!.style.transform = `translateY(100%)`;
          setTimeout(() => dialog!.close(), 200);
        }

        prevScrollTop = current;
        lastEventAt = now;
      });

      dialog.addEventListener('dialogopen', () => {
        prevScrollTop = 0;
        lastEventAt = performance.now() - OVERSCROLL_REST_MS;
        armed = false;
      });
    });
    dialog.addEventListener('dialogclose', () => {
      overscrollDismissing = false;
    });
  });
</script>
