---
import '../styles/global.css';
import { getSite, locales, defaultLocale, type Locale } from '../data/site';
import { localePath } from '../data/languages';
import AmbientBackground from '../components/AmbientBackground.astro';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
}

const { locale, title, description } = Astro.props;
const site = getSite(locale);
const resolvedTitle = title ?? site.site.title;
const resolvedDescription = description ?? site.site.description;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.hero.name,
  jobTitle: site.site.jobTitle,
  url: site.site.url,
  email: `mailto:${site.site.email}`,
  sameAs: [site.site.github, site.site.linkedin],
  worksFor: {
    '@type': 'Organization',
    name: site.site.worksFor,
  },
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{resolvedTitle}</title>
    <meta name="description" content={resolvedDescription} />

    <link rel="canonical" href={Astro.url.href} />
    {locales.length > 1 &&
      locales.map((loc) => (
        <link rel="alternate" hreflang={loc} href={`${site.site.url}${localePath(loc, defaultLocale)}`} />
      ))}

    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={resolvedTitle} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:image" content={`${site.site.url}${site.hero.photo}`} />
    <meta name="twitter:card" content="summary" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- `display=optional`, not `swap`: with `swap` the page first paints in
         a fallback font and then jumps to Inter/Space Grotesk a moment
         later once it downloads, since the two have different metrics
         (visible as text "jumping" on every fresh load). `optional` gives
         the webfont a very short window to be ready before first paint and
         otherwise just keeps the fallback for that visit — no later swap,
         no jump.

         Loaded via the `media="print"` + `onload` trick, not a plain
         `rel="stylesheet"`: a plain cross-origin stylesheet link is
         render-blocking, so on a cold cache (no local copy to fall back on)
         the whole page sits blank until this file round-trips to Google's
         server, then paints everything at once — which reads as a flicker,
         and only on a clean cache since a warm one resolves instantly.
         `media="print"` doesn't match screen rendering, so the browser
         fetches it without blocking paint; the `onload` then flips it to
         `all` so it applies as soon as it's ready. `<noscript>` covers
         browsers with JS disabled, where this trick can't run. -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;700&family=Source+Serif+4:ital,wght@0,600;0,700;1,600&family=Press+Start+2P&display=optional"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;700&family=Source+Serif+4:ital,wght@0,600;0,700;1,600&family=Press+Start+2P&display=optional"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;700&family=Source+Serif+4:ital,wght@0,600;0,700;1,600&family=Press+Start+2P&display=optional"
        rel="stylesheet"
      />
    </noscript>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>
  <body class="font-sans antialiased">
    <AmbientBackground />
    <slot />
  </body>
</html>

<script>
  // Intercept plain same-page anchor links site-wide (nav, "Get in touch"
  // buttons, the "What's next?" card, etc.) and scroll to the target
  // ourselves instead of letting the browser navigate to the hash — that
  // native navigation is what was leaving "#contact" (or "#projects", ...)
  // stuck in the address bar after every jump. `scroll-behavior: smooth`
  // in global.css still applies to this JS-driven scroll, so it looks the
  // same as before, just without touching the URL.
  //
  // This only ever matches an `<a href="#id">`, so it doesn't interfere
  // with Organizations.astro's own cross-link "jump" (that one scrolls
  // manually via buttons, never a hash link) or the nested-modal "← Back"
  // buttons (`<form method="dialog">`, not anchors).
  document.addEventListener('click', (e) => {
    const link = (e.target as HTMLElement)?.closest<HTMLAnchorElement>('a[href^="#"]');
    if (!link) return;
    const id = link.getAttribute('href')?.slice(1);
    if (!id) return;
    const target = document.getElementById(id);
    if (!target) return;
    e.preventDefault();
    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
</script>

<script>
  // Every expandable section (career stops, projects, side-project
  // cartridges, testimonials, the CliftonStrengths certificate) uses a
  // native <dialog>. Reopening one should always feel like the first time:
  // scrolled back to the top, not wherever it was left scrolled to on a
  // previous viewing. A native <dialog> fires no event when it opens (only
  // 'close'), so a MutationObserver on its `open` attribute is the only
  // reliable way to know either transition happened. Re-dispatched as
  // bubbling custom events so any component's own script (PhoneMockup's,
  // for instance, to restart its video/animation from the beginning) can
  // react without needing a direct reference to this one, same
  // delegated-listener style used elsewhere on the site.
  document.querySelectorAll('dialog').forEach((dialog) => {
    new MutationObserver(() => {
      const type = dialog.hasAttribute('open') ? 'dialogopen' : 'dialogclose';
      dialog.dispatchEvent(new CustomEvent(type, { bubbles: true }));
    }).observe(dialog, { attributes: true, attributeFilter: ['open'] });
  });

  document.addEventListener('dialogopen', (e) => {
    const dialog = e.target as HTMLElement;
    dialog.scrollTop = 0;
    // Most dialogs scroll via their own box (see the `h-fit`/`max-h`
    // comments on CareerStopRow/ProjectRow/TechStack's dialogs), but a
    // couple (the testimonial letter, the CliftonStrengths certificate)
    // scroll an inner `overflow-y-auto` div instead, so reset whichever one
    // actually has the scroll position.
    dialog.querySelectorAll<HTMLElement>('[class*="overflow-y-auto"]').forEach((el) => {
      el.scrollTop = 0;
    });
  });
</script>
